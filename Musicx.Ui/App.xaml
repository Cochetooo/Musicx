<Application x:Class="Musicx.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:core="clr-namespace:Musicx.Ui.Core"
             xmlns:converters="clr-namespace:Musicx.Ui.Converters">
    <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <ui:ThemesDictionary Theme="Dark" />
                 <ui:ControlsDictionary />
                 
                 <ResourceDictionary Source="Themes/ClassicTheme.xaml" />
             </ResourceDictionary.MergedDictionaries>
             <core:ViewModelLocator x:Key="Locator" />
             <converters:ViewModelToViewConverter x:Key="ViewModelToViewConverter" />
             <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
             <converters:FloatToPercentageConverter x:Key="FloatToPercentageConverter" />
             <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
             <converters:DateTimeConverter x:Key="DateTimeConverter" />
         </ResourceDictionary>
    </Application.Resources>
</Application>
