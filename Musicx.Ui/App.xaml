<Application x:Class="Musicx.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:Musicx.Ui.ViewModels"
             xmlns:helpers="clr-namespace:Musicx.Ui.Helpers">
    <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <ui:ThemesDictionary Theme="Dark" />
                 <ui:ControlsDictionary />
                 
                 <ResourceDictionary Source="Themes/ClassicTheme.xaml" />
             </ResourceDictionary.MergedDictionaries>
             <viewModels:ViewModelLocator x:Key="Locator" />
             <helpers:ViewModelToViewConverter x:Key="ViewModelToViewConverter" />
         </ResourceDictionary>
    </Application.Resources>
</Application>
