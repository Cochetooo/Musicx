<Application x:Class="Musicx.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:core="clr-namespace:Musicx.Ui.Core">
    <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <ui:ThemesDictionary Theme="Dark" />
                 <ui:ControlsDictionary />
                 
                 <ResourceDictionary Source="Themes/ClassicTheme.xaml" />
             </ResourceDictionary.MergedDictionaries>
             <core:ViewModelLocator x:Key="Locator" />
             <core:ViewModelToViewConverter x:Key="ViewModelToViewConverter" />
             <core:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
             <core:FloatToPercentageConverter x:Key="FloatToPercentageConverter" />
         </ResourceDictionary>
    </Application.Resources>
</Application>
