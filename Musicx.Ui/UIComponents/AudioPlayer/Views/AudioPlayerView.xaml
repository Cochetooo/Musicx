<UserControl x:Class="Musicx.Ui.UIComponents.AudioPlayer.Views.AudioPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             DataContext="{Binding AudioPlayerVm, Source={StaticResource Locator}}"
             mc:Ignorable="d"
             d:DesignHeight="80">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <!-- Left Side:
            Contains Info about Current Track
        -->
        <StackPanel Grid.Column="0" Orientation="Horizontal">
            <ui:Image Height="80" Width="80">
                <ui:Image.Effect>
                    <DropShadowEffect Color="DarkSlateGray" ShadowDepth="0.4" BlurRadius="0.2" />
                </ui:Image.Effect>
            </ui:Image>
            
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <ui:TextBlock 
                    FontWeight="Bold" 
                    FontSize="20" 
                    Text="{Binding CurrentTrack.Title, Mode=OneWay}"
                    TextWrapping="NoWrap">
                </ui:TextBlock>
                
                <ui:TextBlock 
                    FontSize="16" 
                    FontStyle="Italic"
                    Text="Secondary Text"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </StackPanel>
        
        <!-- Center:
            Contains Player Controls such as Previous, Play, Next, Shuffle, Repeat
            And Time Tracking Slider
        -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Shuffle Mode -->
                <ui:Button 
                    Icon="{ui:SymbolIcon ArrowSwap24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                    Appearance="Transparent"
                    Command="{Binding ShuffleModeCommand}" />
                
                <!-- Previous Button -->
                <ui:Button Icon="{ui:SymbolIcon Previous24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                           Appearance="Transparent"
                           Command="{Binding PreviousCommand}" />
                
                <!-- Backward 30s Button -->
                <ui:Button Icon="{ui:SymbolIcon ArrowRotateCounterclockwise24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                           Appearance="Transparent"
                           Command="{Binding BackwardCommand}" />
                
                <!-- Play Button -->
                <ui:Button Icon="{Binding PlaybackIcon}" 
                           Appearance="Transparent"
                           Command="{Binding PlaybackCommand}" />
                
                <!-- Forward 30s Button -->
                <ui:Button Icon="{ui:SymbolIcon ArrowRotateClockwise24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                           Appearance="Transparent"
                           Command="{Binding ForwardCommand}" />
                
                <!-- Next Button -->
                <ui:Button Icon="{ui:SymbolIcon Next24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                           Appearance="Transparent"
                           Command="{Binding NextCommand}" />
                
                <!-- Repeat Mode -->
                <ui:Button Icon="{ui:SymbolIcon ArrowRepeatAllOff24, FontSize={StaticResource AudioPlayerIconWidth}}" 
                           Appearance="Transparent"
                           Command="{Binding RepeatModeCommand}" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock Uid="TrackTimeTextBlock" Text="{Binding CurrentTrackPosition, Converter={StaticResource SecondsToTimeConverter}}" Margin="0,0,5,0" />
                <Slider Uid="TrackTimeSlider" 
                        Minimum="0"
                        Maximum="{Binding CurrentTrackLength, Mode=OneWay}" 
                        Width="400"
                        Value="{Binding CurrentTrackPosition, Mode=TwoWay}"
                        VerticalAlignment="Center">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="PreviewMouseDown">
                            <b:InvokeCommandAction Command="{Binding TrackControlMouseDownCommand}" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="PreviewMouseUp">
                            <b:InvokeCommandAction Command="{Binding TrackControlMouseUpCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </Slider>
                <ui:TextBlock Uid="TrackTotalTimeTextBlock" Text="{Binding CurrentTrack.Duration, Converter={StaticResource SecondsToTimeConverter}}" Margin="5,0,0,0" />
            </StackPanel>
        </StackPanel>
        
        <!-- Right Side: 
            Contains Volume Slider Controls
        -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ui:Button Icon="{ui:SymbolIcon List28, FontSize={StaticResource AudioPlayerIconWidth}}" Appearance="Transparent" VerticalAlignment="Center" />
            <ui:Button Uid="VolumeButton" Icon="{ui:SymbolIcon Speaker048, FontSize={StaticResource AudioPlayerIconWidth}}" Appearance="Transparent" VerticalAlignment="Center" />
            <Slider Uid="VolumeSlider" Maximum="1" Value="{Binding CurrentVolume, Mode=TwoWay}" Margin="5,0,0,0" VerticalAlignment="Center">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="ValueChanged">
                        <b:InvokeCommandAction Command="{Binding VolumeControlValueChangedCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
            </Slider>
            <ui:TextBlock Text="{Binding CurrentVolume, Mode=OneWay, Converter={StaticResource FloatToPercentageConverter}}" VerticalAlignment="Center" Margin="5,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
