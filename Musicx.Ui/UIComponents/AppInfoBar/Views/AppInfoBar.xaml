<UserControl x:Class="Musicx.Ui.UIComponents.AppInfoBar.Views.AppInfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DataContext="{Binding AppInfoVm, Source={StaticResource Locator}}"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.7*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <ui:TextBlock Grid.Column="0" Margin="10,0,0,0" FontSize="12" Text="{Binding LeftContentText}" VerticalAlignment="Center" />
        
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <ProgressBar Value="{Binding ProgressValue}"
                         Minimum="0"
                         Maximum="1"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
        
        <ui:TextBlock Grid.Column="2" Margin="10,0,10,0" FontSize="12" Text="{Binding RightContentText}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
