@using Musicx.Presentation.Web.Client.Components
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager

<Layout>
    <LayoutHeader Fixed>
        <Bar
            CollapseMode="BarCollapseMode.Small"
            Breakpoint="Breakpoint.Desktop"
            NavigationBreakpoint="Breakpoint.Tablet"
            Background="Background.Dark"
            ThemeContrast="ThemeContrast.Dark">
            <BarBrand>
                <BarItem Margin="Margin.Is2.OnX">
                    <BarLink To="#">
                        <BarIcon TextColor="TextColor.White" IconName="IconName.Music"/>
                        <Text TextColor="TextColor.White" TextWeight="TextWeight.Bold">MUSICX</Text>
                    </BarLink>
                </BarItem>
            </BarBrand>
            <BarMenu>
                <BarStart>
                    <BarItem Margin="Margin.Is2.OnX">
                        <BarLink To="/">Home</BarLink>
                    </BarItem>
                    <BarItem Margin="Margin.Is2.OnX">
                        <BarLink To="/Genres">Genres</BarLink>
                    </BarItem>
                    <BarItem Margin="Margin.Is2.OnX">
                        <TextEdit Placeholder="Search..." @bind-Text="_searchText" KeyDown="SearchKeyDown" />
                    </BarItem>
                    <BarItem Margin="Margin.Is2.OnX">
                        <Button Color="Color.Primary" Clicked="Search" Disabled="@string.IsNullOrEmpty(_searchText)">OK!</Button>
                    </BarItem>
                </BarStart>
                <BarEnd>
                    <BarItem Margin="Margin.Is2.FromEnd">
                        <BarDropdown>
                            <BarDropdownToggle>More</BarDropdownToggle>
                            <BarDropdownMenu>
                                <BarDropdownItem>
                                    <BarLink To="/Admin/ArtistDashboard">Artist Dashboard</BarLink>
                                </BarDropdownItem>
                                <BarDropdownItem>
                                    <BarLink To="/Admin/GenreDashboard">Genre Dashboard</BarLink>
                                </BarDropdownItem>
                            </BarDropdownMenu>
                        </BarDropdown>
                    </BarItem>
                    <BarItem Margin="Margin.Is2.FromEnd">
                        <Button Color="Color.Primary">Sign up</Button>
                    </BarItem>
                    <BarItem Margin="Margin.Is2.FromEnd">
                        <Button Color="Color.Secondary">Log in</Button>
                    </BarItem>
                    <BarItem Margin="Margin.Is2.FromEnd">
                        <ChangeTheme />
                    </BarItem>
                </BarEnd>
            </BarMenu>
        </Bar>
    </LayoutHeader>
    
    <LayoutContent Padding="Padding.Is3">
        @Body
    </LayoutContent>
    
    <LayoutFooter>
        
    </LayoutFooter>
</Layout>

@code {

    private string _searchText;
    
    private void SearchKeyDown(KeyboardEventArgs keyEvent)
    {
        if (!string.IsNullOrWhiteSpace(_searchText) && keyEvent.Key == "Enter")
        {
            Search();
        }
    }

    private void Search()
    {
        NavigationManager.NavigateTo($"/SearchResult/{_searchText}");
    }
    
}