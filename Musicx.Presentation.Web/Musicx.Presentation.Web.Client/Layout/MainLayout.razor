@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Shared.Interfaces.Localization
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Themes
@using Musicx.Presentation.Web.Client.Modals.Users
@using Musicx.Presentation.Web.Client.Modals.Searches
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IUserClientContext UserClientContext
@inject ILoggerFactory LoggerFactory
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IApiClient Api
@inject ITranslationService T

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" @ref="_mudThemeProvider" Theme="Theme.DeepTheme" />
<MudPopoverProvider />
<MudDialogProvider
    CloseButton="true"
    FullWidth="true"
    MaxWidth="MaxWidth.Large"
    />
<MudSnackbarProvider />
<MudTypographyProvider />

<MudLayout Class="@GraphicsModeClass">
    <MudAppBar Elevation="1" Color="Color.Primary">
        <!-- Brand -->
        <MudIconButton Icon="@Icons.Material.Filled.MusicNote" Color="Color.Inherit" Edge="Edge.Start"/>
        <MudButton Variant="Variant.Text" OnClick="@NavigateHome" 
                   Class="mr-4 d-none d-sm-flex" Color="Color.Inherit">
            MUSICX
        </MudButton>
        
        <!-- Pages -->
        <MudLink Href="/Charts" Underline="Underline.None" Typo="Typo.subtitle1" 
                 Color="Color.Inherit" Class="mr-4 d-none d-sm-flex">
            @T["Web.Nav.Charts"]
        </MudLink>
        <MudLink Href="/Genres" Underline="Underline.None" Typo="Typo.subtitle1" 
                 Color="Color.Inherit" Class="d-none d-sm-flex">
            @T["Web.Nav.Genres"]
        </MudLink>
        
        <MudSpacer />
        
        <!-- Search Box -->
        <MudTextField Immediate 
                      Label="@T["Web.Nav.SearchLabel"]"
                      T="string"
                      ReadOnly
                      OnKeyDown="@SearchKeyDown" Variant="Variant.Filled"
                      Class="nav-search-field" 
                      @onfocus="OpenSearch"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"/>

        <MudSpacer/>
        
        @if (UserClientContext.CurrentUser is not null)
        {
            <MudLink Color="Color.Inherit" Href="@($"/User/{UserClientContext.CurrentUser.Id}")" 
                     Underline="Underline.None"
                     Class="mr-2 animate-hover-up">
                <MudStack Row Class="pa-2 rounded-lg bg-success-darken animate-pop-bounce" Spacing="3">
                    <MudImage Alt="@UserClientContext.CurrentUser.Name"
                              @key="UserClientContext.CurrentUser.PictureUrl"
                              Width="36" Height="36"
                              Src="@UserClientContext.CurrentUser.PictureUrl"
                              Class="rounded-circle"
                    />
                    
                    <MudText Typo="Typo.subtitle1" Color="Color.Inherit" 
                             Class="text-bold align-content-center d-none d-md-flex">
                        @UserClientContext.CurrentUser.Name
                    </MudText>
                </MudStack>
            </MudLink>
        }
        
        <!-- Light/Dark Mode Switch -->
        <ThemeModeSwitch @bind-IsDarkMode="_isDarkMode" />
        
        <MudMenu Icon="@Icons.Material.Filled.StarRate"
                 Size="Size.Medium"
                 Dense
                 Color="Color.Inherit"
                 Variant="Variant.Text">
            @foreach (var mode in _quickRatingModes)
            {
                <MudMenuItem OnClick="@(() => ChangeRatingMode(mode))"
                             Disabled="@((UserClientContext.CurrentUser?.PrefRatingMode) == mode)">
                    @mode.ToDescriptionString()
                </MudMenuItem>
            }
        </MudMenu>

        <MudMenu
            Variant="Variant.Text"
            Size="Size.Medium"
            Dense
            Color="Color.Inherit"
            Icon="@Icons.Material.Filled.Translate">
            
            @foreach (var language in _languages)
            {
                <MudMenuItem OnClick="@(() => ChangeLanguage(language.Code))" 
                             Disabled="@((UserClientContext.CurrentUser?.PrefLanguage ?? "en") == language.Code)">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <Flag CountryName="@language.CountryName"/>
                        <MudText>@language.Label</MudText>
                    </MudStack>
                </MudMenuItem>
            }
        </MudMenu>
        
        <!-- Others Menu -->
        <MudMenu
            Variant="Variant.Text"
            Size="Size.Medium"
            Color="Color.Inherit"
            Icon="@Icons.Material.Filled.MoreVert">
            
            <!-- Site > Patch Notes -->
            <MudMenuItem Href="/PatchNotes"
                         Icon="@Icons.Material.Filled.NewReleases"
                         IconColor="Color.Primary"
                         Label="@T["Web.Nav.PatchNotes"]" />
            
            <MudMenuItem Href="/Charts"
                         Icon="@Icons.Material.Filled.BarChart"
                         IconColor="Color.Primary"
                         Label="@T["Web.Nav.Charts"]"
                         Class="d-flex d-sm-none"/>
            
            <MudMenuItem Href="/Genres"
                         Icon="@Icons.Material.Filled.Piano"
                         IconColor="Color.Primary"
                         Label="@T["Web.Nav.Genres"]"
                         Class="d-flex d-sm-none"/>
            
            <MudDivider/>

            <!-- User > Signup -->
            @if (UserClientContext.CurrentUser is null)
            {
                <MudMenuItem Href="/User/Signup"
                             Icon="@Icons.Material.Filled.PersonAdd"
                             IconColor="Color.Primary"
                             Label="@T["Web.Nav.Signup"]"/>

                <MudMenuItem OnClick="@OpenLogin"
                             Icon="@Icons.Material.Filled.Login"
                             IconColor="Color.Primary"
                             Label="@T["Web.Nav.SignIn"]"/>
            }
            else
            {
                if (UserClientContext.Can("admin.dashboard.read"))
                {
                    <MudMenuItem Href="/Admin/ModerationDashboard"
                                 Icon="@Icons.Material.Filled.AdminPanelSettings"
                                 IconColor="Color.Primary"
                                 Label="Moderation Dashboard"/>

                    <MudDivider/>
                }

                <MudMenuItem OnClick="@SignOut"
                             Icon="@Icons.Material.Filled.Logout"
                             IconColor="Color.Primary"
                             Label="@T["Web.Nav.SignOut"]"/>
            }
            
            <MudMenuItem
                Icon="@Icons.Material.Filled.Numbers"
                IconColor="Color.Primary"
                Disabled="true"
                Label="@T.Get("Web.Nav.Version", "0.7.4")"/>
        </MudMenu>
    </MudAppBar>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
    
    <SearchOverlay @ref="_searchOverlay"/>
</MudLayout>

<LoginModal @ref="_loginModal" OnLogin="@HandleLogin" />