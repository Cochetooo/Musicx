@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Themes
@using Musicx.Presentation.Web.Client.Modals.Users
@using Musicx.Presentation.Web.Client.Modals.Searches
@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IUserClientContext UserClientContext
@inject ILoggerFactory LoggerFactory
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" @ref="_mudThemeProvider" Theme="Theme.DeepTheme" />
<MudPopoverProvider />
<MudDialogProvider
    CloseButton="true"
    FullWidth="true"
    MaxWidth="MaxWidth.Large"
    />
<MudSnackbarProvider />
<MudTypographyProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <!-- Brand -->
        <MudIconButton Icon="@Icons.Material.Filled.MusicNote" Color="Color.Inherit" Edge="Edge.Start"/>
        <MudButton Variant="Variant.Text" OnClick="@NavigateHome" Class="mr-4" Color="Color.Inherit">
            MUSICX
        </MudButton>
        
        <!-- Pages -->
        <MudLink Href="/Charts" Underline="Underline.None" Typo="Typo.subtitle1" Color="Color.Inherit" Class="mr-4">Charts</MudLink>
        <MudLink Href="/Genres" Underline="Underline.None" Typo="Typo.subtitle1" Color="Color.Inherit">Genres</MudLink>
        
        <MudSpacer />
        
        <!-- Search Box -->
        <MudTextField Immediate Label="Search"
                      T="string"
                      ReadOnly
                      OnKeyDown="@SearchKeyDown" Variant="Variant.Filled"
                      Class="nav-search-field" @onfocus="OpenSearch"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"/>

        <MudSpacer/>
        
        @if (UserClientContext.CurrentUser is not null)
        {
            <MudLink Color="Color.Inherit" Href="@($"/User/{UserClientContext.CurrentUser.Id}")" 
                     Underline="Underline.None"
                     Class="mr-2 animate-hover-up">
                <MudStack Row Class="pa-2 rounded-lg bg-success-darken animate-pop-bounce" Spacing="3">
                    <MudImage Alt="@UserClientContext.CurrentUser.Name"
                              @key="UserClientContext.CurrentUser.PictureUrl"
                              Width="36" Height="36"
                              Src="@UserClientContext.CurrentUser.PictureUrl"
                              Class="rounded-circle"
                    />
                    
                    <MudText Typo="Typo.subtitle1" Color="Color.Inherit" Class="text-bold align-content-center">
                        @UserClientContext.CurrentUser.Name
                    </MudText>
                </MudStack>
            </MudLink>
        }
        
        <!-- Light/Dark Mode Switch -->
        <ThemeModeSwitch @bind-IsDarkMode="_isDarkMode" />

        <!-- Others Menu -->
        <MudMenu
            Variant="Variant.Text"
            Size="Size.Medium"
            Color="Color.Inherit"
            Icon="@Icons.Material.Filled.MoreVert">
            
            <!-- Site > Patch Notes -->
            <MudMenuItem Href="/PatchNotes"
                         Icon="@Icons.Material.Filled.NewReleases"
                         IconColor="Color.Primary"
                         Label="Patch Notes" />
            
            <MudDivider/>

            <!-- User > Signup -->
            @if (UserClientContext.CurrentUser is null)
            {
                <MudMenuItem Href="/User/Signup"
                             Icon="@Icons.Material.Filled.PersonAdd"
                             IconColor="Color.Primary"
                             Label="Signup"/>

                <MudMenuItem OnClick="@OpenLogin"
                             Icon="@Icons.Material.Filled.Login"
                             IconColor="Color.Primary"
                             Label="Sign In"/>
            }
            else
            {
                if (UserClientContext.Can("admin.dashboard.read"))
                {
                    <!-- Admin > Artist Dashboard -->
                    <MudMenuItem Href="/Admin/ArtistDashboard"
                                 Icon="@Icons.Material.Filled.Person"
                                 IconColor="Color.Primary"
                                 Label="Artist Dashboard"/>

                    <!-- Admin > Genre Dashboard -->
                    <MudMenuItem Href="/Admin/GenreDashboard"
                                 Icon="@Icons.Material.Filled.Piano"
                                 IconColor="Color.Primary"
                                 Label="Genre Dashboard"/>

                    <!-- Admin > Role Dashboard -->
                    <MudMenuItem Href="/Admin/RoleDashboard"
                                 Icon="@Icons.Material.Filled.PersonPin"
                                 IconColor="Color.Primary"
                                 Label="Role Dashboard"/>

                    <MudDivider/>
                }

                <MudMenuItem OnClick="@SignOut"
                             Icon="@Icons.Material.Filled.Logout"
                             IconColor="Color.Primary"
                             Label="Sign Out"/>
            }
        </MudMenu>
    </MudAppBar>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
    
    <SearchOverlay @ref="_searchOverlay"/>
</MudLayout>

<LoginModal @ref="_loginModal" OnLogin="@HandleLogin" />