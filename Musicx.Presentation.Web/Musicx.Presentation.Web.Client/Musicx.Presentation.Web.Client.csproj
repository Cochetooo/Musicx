<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
        <SatelliteResourceLanguages>en;fr;de</SatelliteResourceLanguages>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)GeneratedRazor</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="9.0.2" />
        <PackageReference Include="ISO3166-updated" Version="1.0.5" />
        <PackageReference Include="Markdig" Version="1.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.12" />
        <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="9.0.12" />
        <PackageReference Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="9.0.12" />
        <PackageReference Include="MudBlazor" Version="9.1.0" />
        <PackageReference Include="MudBlazor.ThemeManager" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Musicx.Application.Shared\Musicx.Application.Shared.csproj" />
      <ProjectReference Include="..\..\Musicx.Contracts\Musicx.Contracts.csproj" />
      <ProjectReference Include="..\..\Musicx.Infrastructure\Musicx.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="appsettings.Client.json" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Modals\Admin\Songs\" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Components\Auth\AuthorizeView.razor" />
      <_ContentIncludedByDefault Remove="Components\Fields\CstDurationField.razor" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Layout\Auth\AuthorizeView.razor" />
    </ItemGroup>

</Project>
