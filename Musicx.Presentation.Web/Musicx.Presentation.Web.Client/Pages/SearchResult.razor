@page "/SearchResult/{searchText}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components

@inject IListUseCase<OutArtist> UcListArtist
@inject IListUseCase<OutAlbum> UcListAlbum

<MudBreadcrumbs Items="@_breadcrumb" />

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h5" Color="Color.Secondary">Search Results</MudText>
    </MudCardHeader>
    <MudCardContent>
        <!-- Artists -->
        <MudText Typo="Typo.h4">Artists</MudText>

        @if (0 < _artistsResult.Count)
        {
            <MudList T="RenderFragment" ReadOnly>
                @foreach (var artist in _artistsResult)
                {
                    <MudListItem>
                        <MudStack Justify="Justify.FlexStart" Row>
                            <MudImage Src="@artist.ArtworkUrl" 
                                      Width="96" Height="96"
                                      Elevation="8"
                                      Class="rounded-lg"/>
                            <MudStack Class="ml-4 bg-search-artist rounded-lg py-1 px-5" Spacing="1">
                                <MudLink Typo="Typo.h5" Class="montserrat mb-1 text-bold" 
                                         Color="Color.Inherit"
                                         Href="@($"/Artist/{artist.Id}")">
                                    @artist.Name
                                </MudLink>
                                
                                @if (artist.CalculatedGenres is not null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @artist.CalculatedGenres
                                    </MudText>
                                }
                                
                                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                    <span class="mr-2"><Flag CountryName="@artist.Country"/></span>
                                    
                                    @if (artist.Discriminator == ArtistDiscriminator.Band)
                                    {
                                        if (null != artist.FormationDate)
                                        {
                                            <span>@artist.FormationDate.Value.Year</span>
                                        }

                                        <span> - </span>
                                        if (null != artist.SplitDate)
                                        {
                                            <span>@artist.SplitDate.Value.Year</span>
                                        }
                                    }
                                    else
                                    {
                                        if (null != artist.BirthDate)
                                        {
                                            <span>@artist.BirthDate.Value.Year</span>
                                        }

                                        <span> - </span>
                                        if (null != artist.DeathDate)
                                        {
                                            <span> @artist.DeathDate.Value.Year</span>
                                        }
                                    }
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        <MudText Class="text-italic">@_artistsResult.Count result(s) found.</MudText>

        <MudDivider Class="my-4" />
        
        <!-- Albums -->
        <MudText Typo="Typo.h4">Albums</MudText>

        @if (0 < _albumsResult.Count)
        {
            <MudList T="RenderFragment">
                @foreach (var album in _albumsResult)
                {
                    <MudListItem>
                        <MudStack Justify="Justify.FlexStart" Row>
                            <MudImage Src="@album.ArtworkUrl" 
                                      Width="72" Height="72"
                                      Elevation="8"
                                      Class="rounded-lg"/>
                            <MudStack Spacing="1" Class="ml-4">
                                <MudLink Typo="Typo.h5" Class="montserrat" Style="font-weight: 600;" Color="Color.Inherit"
                                         Href="@($"/Album/{album.Id}")">
                                    @album.Name
                                </MudLink>
                                
                                @if (album.SimplifiedGenreName is not null)
                                {
                                    <MudText Typo="Typo.body2" Class="text-italic" Color="Color.Secondary">
                                        @album.SimplifiedGenreName
                                    </MudText>
                                }
                                
                                @if (album.Artist is not null)
                                {
                                    <MudText Color="Color.Tertiary" Typo="Typo.caption">By 
                                        <MudLink Href="@($"/Artist/{album.Artist.Id}")" Typo="Typo.body2">
                                            @album.Artist.Name
                                        </MudLink>
                                    </MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        <MudText Class="text-italic">@_albumsResult.Count result(s) found.</MudText>
    </MudCardContent>
</MudCard>

<style>
    .bg-search-artist {
        width: 100%;
        background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0.15) 0%,
            rgba(0, 0, 0, 0.0) 100%
        );
        transition: transform 0.3s ease-in-out;
    }
    
    .bg-search-artist:hover {
        transform: scale(1.02);
    }
</style>