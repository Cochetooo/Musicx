@page "/SearchResult/{searchText}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components

@inject IListUseCase<OutArtist> UcListArtist
@inject IListUseCase<OutAlbum> UcListAlbum

<MudBreadcrumbs Items="@_breadcrumb" />

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h5" Color="Color.Secondary">Search Results</MudText>
    </MudCardHeader>
    <MudCardContent>
        <!-- Artists -->
        <MudText Typo="Typo.h4">Artists</MudText>

        @if (0 < _artistsResult.Count)
        {
            <MudList T="RenderFragment">
                @foreach (var artist in _artistsResult)
                {
                    <MudListItem>
                        <MudStack Justify="Justify.FlexStart" Row>
                            <MudImage Src="@artist.ArtworkUrl" Width="64" Height="64"/>
                            <MudStack>
                                <MudLink Typo="Typo.h5" Class="montserrat" Style="font-weight: bold;" Href="@($"/Artist/{artist.Id}")">
                                    @artist.Name
                                </MudLink>
                                <MudText Color="Color.Tertiary">
                                    @if (artist.Discriminator == ArtistDiscriminator.Band)
                                    {
                                        <span>Band from <Flag CountryName="@artist.Country"/></span>
                                        if (null != artist.FormationDate)
                                        {
                                            <span> since @artist.FormationDate.Value.Year</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>Artist from <Flag CountryName="@artist.Country"/></span>
                                        if (null != artist.BirthDate)
                                        {
                                            <span> born in @artist.BirthDate.Value.Year</span>
                                        }
                                    }
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        <MudText Style="font-style: italic;">@_artistsResult.Count result(s) found.</MudText>

        <MudDivider Class="my-4" />
        
        <!-- Albums -->
        <MudText Typo="Typo.h4">Albums</MudText>

        @if (0 < _albumsResult.Count)
        {
            <MudList T="RenderFragment">
                @foreach (var album in _albumsResult)
                {
                    <MudListItem>
                        <MudStack Justify="Justify.FlexStart" Row>
                            <MudImage Src="@album.ArtworkUrl" Width="64" Height="64"/>
                            <MudStack>
                                <MudLink Typo="Typo.h5" Class="montserrat" Style="font-weight: bold;" Href="@($"/Album/{album.Id}")">
                                    @album.Name
                                </MudLink>
                                <MudText Color="Color.Tertiary">
                                    @if (album.Artist is not null)
                                    {
                                        <span>By 
                                            <MudLink Href="@($"/Artist/{album.Artist.Id}")">
                                                @album.Artist.Name
                                            </MudLink>
                                        </span>
                                    }
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        <MudText Style="font-style: italic;">@_albumsResult.Count result(s) found.</MudText>
    </MudCardContent>
</MudCard>