@page "/SearchResult/{searchText}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components

@inject IListUseCase<OutArtist> UcListArtist
@inject IListUseCase<OutAlbum> UcListAlbum

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="#">Search Results</BreadcrumbLink>
    </BreadcrumbItem>
</Breadcrumb>

<Card Margin="Margin.Is4.OnY">
    <CardHeader>
        <Heading Size="HeadingSize.Is5" TextWeight="TextWeight.Light" TextColor="TextColor.Muted">Search Results</Heading>
    </CardHeader>
    <CardBody>
        <Heading Size="HeadingSize.Is4">Artists</Heading>
        
        @if (0 < _artistsResult.Count)
        {
            <ListGroup Margin="Margin.Is2.FromBottom">
                @foreach (var artist in _artistsResult)
                {
                    <ListGroupItem>
                        <Div Flex="Flex.JustifyContent.Start">
                            <Image Style="width: 64px; height: 64px; border-radius:5px" Source="@artist.ArtworkUrl" />
                            <Div Margin="Margin.Is3.OnX">
                                <Heading TextWeight="TextWeight.Bold" Size="HeadingSize.Is5">
                                    <Blazorise.Link To="@($"/Artist/{artist.Id}")" TextColor="TextColor.Primary">
                                        @artist.Name
                                    </Blazorise.Link>
                                </Heading>

                                <Paragraph TextSize="TextSize.Small" TextColor="TextColor.Muted">
                                    @if (artist.Discriminator == ArtistDiscriminator.Band)
                                    {
                                        <Text>Band from <Flag CountryName="@artist.Country" /></Text>
                                        if (null != artist.FormationDate)
                                        {
                                            <Text> since @artist.FormationDate.Value.Year</Text>
                                        }
                                    } 
                                    else
                                    {
                                        <Text>Artist from <Flag CountryName="@artist.Country" /></Text>
                                        if (null != artist.BirthDate)
                                        {
                                            <Text> born in @artist.BirthDate.Value.Year</Text>
                                        }
                                    }
                                </Paragraph>
                            </Div>
                        </Div>
                    </ListGroupItem>
                }
            </ListGroup>
        }
        
        <CardText Italic TextColor="TextColor.Muted">@_artistsResult.Count result(s) found.</CardText>
        
        <Divider />
        
        <Heading Size="HeadingSize.Is4">Albums</Heading>
        
        @if (0 < _albumsResult.Count)
        {
            <ListGroup Margin="Margin.Is2.FromBottom">
                @foreach (var album in _albumsResult)
                {
                    <ListGroupItem>
                        <Div Flex="Flex.JustifyContent.Start">
                            <Image Style="width: 64px; height: 64px; border-radius:5px" Source="@album.ArtworkUrl" />
                            <Div Margin="Margin.Is3.OnX">
                                <Heading TextWeight="TextWeight.Bold" Size="HeadingSize.Is5">
                                    <Blazorise.Link To="@($"/Album/{album.Id}")" TextColor="TextColor.Primary">
                                        @album.Name
                                    </Blazorise.Link>
                                </Heading>

                                <Paragraph TextSize="TextSize.Small" TextColor="TextColor.Muted">
                                    @if (album.Artist is not null)
                                    {
                                        <Text>By 
                                            <Blazorise.Link To="@($"/Artist/{album.Artist.Id}")"
                                                            TextColor="TextColor.Dark"
                                                            TextWeight="TextWeight.Bold">
                                                @album.Artist.Name
                                            </Blazorise.Link>
                                        </Text>
                                    }
                                </Paragraph>
                            </Div>
                        </Div>
                    </ListGroupItem>
                }
            </ListGroup>
        }
        
        <CardText Italic TextColor="TextColor.Muted">@_albumsResult.Count result(s) found.</CardText>
    </CardBody>
</Card>