@using Musicx.Presentation.Web.Client.Components.Base
<MudPaper Class="pa-4 bg-surface animate-hover-up" Elevation="0">
    <PanelTitle Text="Visibility Ratio" />
    <MudGrid Class="mt-2">
        <MudItem xs="12" md="6">
            <MudText Class="mb-2">Artists</MudText>
            @* <MudChart ChartType="ChartType.Donut" InputData="@ArtistData" InputLabels="@Labels" Width="100%" Height="220px"/> *@
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnArtistsClick" FullWidth>Open Artist View</MudButton>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Class="mb-2">Genres</MudText>
            @* <MudChart ChartType="ChartType.Donut" InputData="@GenreData" InputLabels="@Labels" Width="100%" Height="220px"/> *@
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@OnGenresClick" FullWidth>Open Genre View</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    [Parameter] public int ArtistsVisible { get; set; }
    [Parameter] public int ArtistsHidden { get; set; }
    [Parameter] public int GenresVisible { get; set; }
    [Parameter] public int GenresHidden { get; set; }
    [Parameter] public EventCallback OnArtistsClick { get; set; }
    [Parameter] public EventCallback OnGenresClick { get; set; }

    private double[] ArtistData => [ArtistsVisible, ArtistsHidden];
    private double[] GenreData => [GenresVisible, GenresHidden];
    private string[] Labels => ["Visible", "Hidden"];
}