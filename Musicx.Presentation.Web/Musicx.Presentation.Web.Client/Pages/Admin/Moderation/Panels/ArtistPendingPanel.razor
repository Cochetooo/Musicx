@using Musicx.Contracts.Dto.Responses.Artist
@using Musicx.Presentation.Web.Client.Components.Base
<MudPaper Class="pa-4 bg-surface animate-hover-up" Elevation="0">
    <PanelTitle Text="Pending Artists" Count="@PendingArtists.Count.ToString()" />
    <MudList T="RenderFragment" Dense Class="pending-list-dense">
        @foreach (var artist in PendingArtists)
        {
            <MudListItem Class="pending-list-item">
                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                    <MudText Class="text-truncate pending-name">@artist.Name</MudText>
                    <MudStack Row Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnReject.InvokeAsync(artist))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="@(() => OnAccept.InvokeAsync(artist))" />
                    </MudStack>
                </MudStack>
            </MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<OutArtist> PendingArtists { get; set; } = [];
    [Parameter] public EventCallback<OutArtist> OnAccept { get; set; }
    [Parameter] public EventCallback<OutArtist> OnReject { get; set; }
}