@using Musicx.Presentation.Web.Client.Components.Base
<MudPaper Class="pa-4 bg-surface animate-hover-up" Elevation="0">
    <PanelTitle Text="Genre Creation Pace" />
    <MudStack Spacing="0" Class="mt-2">
        <MudText Typo="Typo.body2">Today: <b>@Today</b></MudText>
        <MudText Typo="Typo.body2">This week: <b>@ThisWeek</b></MudText>
        <MudText Typo="Typo.body2">This month: <b>@ThisMonth</b></MudText>
        <MudText Typo="Typo.body2">This year: <b>@ThisYear</b></MudText>
    </MudStack>
</MudPaper>
@code 
{
    [Parameter] public int Today { get; set; }
    [Parameter] public int ThisWeek { get; set; }
    [Parameter] public int ThisMonth { get; set; }
    [Parameter] public int ThisYear { get; set; }
}