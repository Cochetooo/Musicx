@page "/Admin/RoleDashboard"
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests.Security
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components.Admin
@using Musicx.Presentation.Web.Client.Layout.Auth

@inject ILoggerFactory LoggerFactory
@inject IApiClient Api
@inject ISnackbar Snackbar

<AuthorizeView Permission="admin.role.read">
    <ChildContent>
        <AdminPageCard Title="Role Management" BreadcrumbItems="_breadcrumb">
            <MudGrid Class="pa-4">
                
                <!-- ROLES -->
                <MudItem xs="12" md="3">
                    <MudPaper Class="pa-4 bg-surface glass-paper" Elevation="0">
                        <MudText Typo="Typo.h6" Class="mb-3 montserrat text-bold">
                            Roles
                        </MudText>

                        <MudDivider Class="mb-2"/>

                        <MudList T="OutRole?" @bind-SelectedValue="_selectedRole" Dense>
                            @foreach (var role in _roles)
                            {
                                <MudListItem Value="@role">
                                    <MudText Typo="Typo.body1" Style="justify-items: center;"
                                             Class="montserrat text-bold color-primary">
                                        @role.Name.ToUpper()
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-5 bg-default glass-paper" Elevation="0">
                        @if (_selectedRole is not null)
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h5" Class="montserrat text-bold">
                                    @_selectedRole.Name
                                </MudText>
                                
                                <MudStack Row Spacing="2">
                                    <MudIconButton 
                                        Icon="@(_addMode ? Icons.Material.Filled.Minimize : Icons.Material.Filled.Add)"
                                        Color="Color.Primary"
                                        Variant="Variant.Filled"
                                        OnClick="@(() => _addMode = !_addMode)"
                                        Class="rounded-xl" />

                                    <MudButton 
                                        Variant="Variant.Filled"
                                        Color="Color.Success"
                                        Disabled="@(!_isModified)"
                                        OnClick="@Save"
                                        StartIcon="@Icons.Material.Filled.Save">
                                        Save
                                    </MudButton>
                                </MudStack>
                                
                            </MudStack>
                            
                            <MudDivider Class="my-4" />
                            
                            <MudText Typo="Typo.subtitle2" Class="mb-3 color-secondary">
                                Assigned permissions
                            </MudText>
                            
                            <MudStack Spacing="2" Class="animate-swipe-right">
                                @foreach (var permission in _selectedRole.Permissions ?? [])
                                {
                                    <MudPaper Class="pa-3 bg-gray rounded-xl" Elevation="0">
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Row>
                                            <MudText Typo="Typo.body2" Class="text-light montserrat">
                                                @permission.Name
                                            </MudText>
                                            
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           OnClick="@(() => RemovePermission(permission))"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           Variant="Variant.Text" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-10">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" 
                                         Size="Size.Large"
                                         Color="Color.Primary"/>
                                <MudText Class="mt-3">
                                    Select a role to manage its permissions
                                </MudText>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="3">
                    @if (_selectedRole is not null && _addMode)
                    {
                        <MudPaper Class="pa-4 bg-surface glass-paper" Elevation="0">
                            
                            <MudText Typo="Typo.h6" Class="mb-3 color-secondary">
                                Available Permissions
                            </MudText>

                            <MudDivider Class="mb-3"/>
                            
                            <MudStack Spacing="2">
                                @foreach (var permission in _permissions
                                                .Where(p => !_selectedRole.Permissions?
                                                .Select(sp => sp.Id)
                                                .Contains(p.Id) ?? true))
                                {
                                    <MudPaper 
                                        Class="pa-2 bg-gray rounded-lg animate-hover-up"
                                        Elevation="0" @onclick="@(() => AddPermission(permission))">
                                        <MudStack Justify="Justify.SpaceBetween" Row>
                                            <MudText Typo="Typo.body2" Class="text-light montserrat">
                                                @permission.Name
                                            </MudText>
                                            <MudIcon Icon="@Icons.Material.Filled.Add"
                                                           Color="Color.Primary"/>
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        </AdminPageCard>
    </ChildContent>
</AuthorizeView>