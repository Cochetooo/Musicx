@page "/Admin/ArtistDashboard"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Models
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists
@using Musicx.Presentation.Web.Client.Components.Auth

@inject ILoggerFactory LoggerProvider
@inject IListUseCase<OutArtist> UcList
@inject IDeleteUseCase<InArtist> UcDelete

<AuthorizeView Permission="admin.artist.read">
    <ChildContent>
        <MudBreadcrumbs Items="@_breadcrumb" />

        <MudCard Class="py-4">
            <MudCardHeader>
                <MudText Typo="Typo.h4">Artist Management</MudText>
            </MudCardHeader>
            
            <MudCardContent>
                <MudDataGrid T="OutArtist" Items="@_filteredArtists"
                             RowsPerPage="20" Dense ColumnResizeMode="ResizeMode.Column"
                             MultiSelection bind-SelectedItems="@_selectedArtists">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Artists</MudText>
                        <MudSpacer />
                        <MudTextField 
                            @bind-Value="_searchDataGrid"
                            Label="Search"
                            OnKeyDown="@KeyDownSearchInput"
                            Class="mr-2"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Adornment="Adornment.End"
                            Immediate
                            Variant="Variant.Outlined" />
                        <MudSpacer />
                        <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Row>
                            @if (_viewMode == ViewMode.Normal)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="mr-2"
                                               OnClick="@ShowAddModal" />
                        
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="mr-2"
                                               OnClick="@EnableDeleteMode" />
                            }
                            else if (_viewMode == ViewMode.Delete)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Class="mr-2"
                                               OnClick="@EnableNormalMode" />
                                <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Error" Class="mr-2"
                                               OnClick="@ShowDeleteModal" />
                            }
                    
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@LoadData" />
                        </MudStack>
                    </ToolBarContent>
                    
                    <Columns>
                        <TemplateColumn Title="#">
                            <CellTemplate>
                                @if (context.Item.ArtworkUrl is not null)
                                {
                                    <MudImage Src="@context.Item.ArtworkUrl"
                                              Alt="@context.Item.Name"
                                              Elevation="2"
                                              Width="24"
                                              Height="24"
                                              Style="border-radius: 12px;"/>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Property="x => x.Name"/>

                        <TemplateColumn Title="Country">
                            <CellTemplate>
                                <Flag CountryName="@context.Item.Country"/>
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Property="x => x.Discriminator" Title="Type"/>

                        <TemplateColumn Title="Formation Date">
                            <CellTemplate>
                                @if (context.Item.FormationDate is not null)
                                {
                                    @context.Item.FormationDate.Value.ToString("dd/MM/yyyy")
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Split Date">
                            <CellTemplate>
                                @if (context.Item.SplitDate is not null)
                                {
                                    @context.Item.SplitDate.Value.ToString("dd/MM/yyyy")
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Property="x => x.FirstName"/>

                        <PropertyColumn Property="x => x.LastName"/>

                        <TemplateColumn Title="Birth Date">
                            <CellTemplate>
                                @if (context.Item.BirthDate is not null)
                                {
                                    @context.Item.BirthDate.Value.ToString("dd/MM/yyyy")
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <TemplateColumn Title="Death Date">
                            <CellTemplate>
                                @if (context.Item.DeathDate is not null)
                                {
                                    @context.Item.DeathDate.Value.ToString("dd/MM/yyyy")
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <PropertyColumn Title="Created At" Property="x => x.CreatedAt"/>

                        <PropertyColumn Title="Last Modification" Property="x => x.UpdatedAt"/>

                        <TemplateColumn CellClass="d-flex justify-end">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               OnClick="@(() => ShowEditModal(context.Item))"/>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="OutArtist" />
                    </PagerContent>
                </MudDataGrid>
            </MudCardContent>
        </MudCard>

        <ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" />

        <MudDialog @ref="_confirmDeleteModal">
            <TitleContent>
                Deletion
            </TitleContent>
            <DialogContent>
                <MudText>Are you sure you want to delete these following artists?</MudText>
                <ul>
                    @foreach (var artist in _selectedArtists)
                    {
                        <li>@artist.Name</li>
                    }
                </ul>
            </DialogContent>
            <DialogActions>
                <MudButton StartIcon="@Icons.Material.Outlined.Close" Color="Color.Secondary" OnClick="@HideDeleteModal">
                    Cancel
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Check" Color="Color.Error" OnClick="@DeleteData">
                    Confirm
                </MudButton>
            </DialogActions>
        </MudDialog>
    </ChildContent>
</AuthorizeView>