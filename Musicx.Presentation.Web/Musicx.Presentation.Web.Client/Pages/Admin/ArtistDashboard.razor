@page "/Admin/ArtistDashboard"
@using System.Net.Mime
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists
@using Musicx.Presentation.Web.Client.Models
@using Musicx.Presentation.Web.Client.Components

@inject ILoggerProvider LoggerProvider
@inject IListUseCase<OutArtist> UcList
@inject IDeleteUseCase<InArtist> UcDelete

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="/Admin">Administration</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="#">Manage Artists</BreadcrumbLink>
    </BreadcrumbItem>
</Breadcrumb>

<Card Margin="Margin.Is4.OnY">
    <CardHeader>
        <CardTitle>Artist Management</CardTitle>
    </CardHeader>
    <CardBody>
        <div class="container-fluid" style="display: flex; flex-direction: column;">
            <div class="d-flex justify-content-between align-items-center p-3">
                <TextEdit
                    @bind-Text="@_searchDataGrid" Placeholder="Search..."
                    KeyDown="KeyDownSearchInput" Margin="Margin.Is2.FromEnd"/>

                <div class="d-flex">
                    <Button Color="Color.Primary" Clicked="ApplySearchFilters">Apply</Button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center p-3">
                <Div ElementId="#DataGrid-Refresh">
                    <Animate Anchor="#DataGrid-Refresh" Auto Animation="Animations.FadeIn" DelayMilliseconds="300">
                        <Button Clicked="LoadData" Color="Color.Primary" class="mr-2">
                            <Icon Name="IconName.Sync"/>
                            Refresh
                        </Button>
                    </Animate>
                </Div>

                <Div class="d-flex" ElementId="#DataGrid-Actions">
                    <Animate Anchor="#DataGrid-Actions" Auto Animation="Animations.FadeIn" DelayMilliseconds="300">
                        @if (_viewMode == ViewMode.Normal)
                        {
                            <Button Clicked="ShowAddModal" Color="Color.Success" class="mr-2">
                                <Icon Name="IconName.PlusCircle"/>
                                Add
                            </Button>
                            <Button Clicked="EnableDeleteMode" Color="Color.Danger" class="mr-2">
                                <Icon Name="IconName.Delete"/>
                                Delete
                            </Button>
                        }
                        else if (_viewMode == ViewMode.Delete)
                        {
                            <Button Clicked="EnableNormalMode" Color="Color.Secondary" class="mr-2">
                                <Icon Name="IconName.Times"/>
                                Cancel
                            </Button>
                            <Button Clicked="ShowDeleteModal" Color="Color.Danger" class="mr-2">
                                <Icon Name="IconName.Check"/>
                                Confirm deletion
                            </Button>
                        }
                    </Animate>
                </Div>
            </div>

            <Div class="flex-grow-1 overflow-auto" ElementId="#DataGrid-Animate">
                <Animate Anchor="#DataGrid-Animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="400">
                    <DataGrid TItem="OutArtist"
                              Data="_filteredArtists"
                              @bind-SelectedRows="@_selectedArtists"
                              SelectionMode="DataGridSelectionMode.Multiple"
                              ShowPager
                              Resizable
                              ResizeMode="TableResizeMode.Header"
                              PageSize="20"
                              HeaderThemeContrast="ThemeContrast.Dark"
                              Responsive>
                        <DataGridColumns>
                            @if (_viewMode == ViewMode.Delete)
                            {
                                <DataGridMultiSelectColumn Width="30px"/>
                            }

                            <DataGridColumn Field="@nameof(OutArtist.ArtworkUrl)" Caption="#">
                                <DisplayTemplate>
                                    @if (context.ArtworkUrl is not null)
                                    {
                                        <Image Style="width: 24px; height: 24px; border-radius: 12px" Source="@context.ArtworkUrl"  Loading />
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.Name)" Caption="Name"/>
                            <DataGridColumn Field="@nameof(OutArtist.Country)" Caption="Country">
                                <DisplayTemplate>
                                    <Flag CountryName="@context.Country" />
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.Discriminator)" Caption="Type"/>
                            <DataGridColumn Field="@nameof(OutArtist.FormationDate)" Caption="Formation Date">
                                <DisplayTemplate>
                                    @if (null != context.FormationDate)
                                    {
                                        @context.FormationDate.Value.ToString("dd-MM-yyyy")
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.SplitDate)" Caption="Split Date">
                                <DisplayTemplate>
                                    @if (null != context.SplitDate)
                                    {
                                        @context.SplitDate.Value.ToString("dd-MM-yyyy")
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.FirstName)" Caption="First Name"/>
                            <DataGridColumn Field="@nameof(OutArtist.LastName)" Caption="Last Name"/>
                            <DataGridColumn Field="@nameof(OutArtist.BirthDate)" Caption="Birth Date">
                                <DisplayTemplate>
                                    @if (null != context.BirthDate)
                                    {
                                        @context.BirthDate.Value.ToString("dd-MM-yyyy")
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.DeathDate)" Caption="Death Date">
                                <DisplayTemplate>
                                    @if (null != context.DeathDate)
                                    {
                                        @context.DeathDate.Value.ToString("dd-MM-yyyy")
                                    }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn Field="@nameof(OutArtist.CreatedAt)" Caption="Created At"/>
                            <DataGridColumn Field="@nameof(OutArtist.UpdatedAt)" Caption="Last Modification"/>
                            <DataGridColumn Caption="Edit">
                                <DisplayTemplate>
                                    <Button Color="Color.Link" Size="Size.Small" Clicked="@(() => ShowEditModal(context))">
                                        <Icon Name="IconName.Pen"/>
                                    </Button>
                                </DisplayTemplate>
                            </DataGridColumn>
                        </DataGridColumns>

                        <LoadingTemplate>
                            <SpinKit Type="SpinKitType.Pulse"/>
                        </LoadingTemplate>
                    </DataGrid>
                </Animate>
            </Div>
        </div>
    </CardBody>
</Card>

<ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" />

<Modal @ref="_confirmDeleteModal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Deletion</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <span>Are you sure you want to delete these artists?</span>
            <UnorderedList>
                @foreach (var artist in _selectedArtists)
                {
                    <UnorderedListItem>@artist.Name</UnorderedListItem>
                }
            </UnorderedList>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@HideDeleteModal">Close</Button>
            <Button Color="Color.Primary" Clicked="@DeleteData">Save Changes</Button>
        </ModalFooter>
    </ModalContent>
</Modal>