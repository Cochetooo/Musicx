@page "/Admin/GenreDashboard"
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.Genre
@using Musicx.Presentation.Web.Client.Components.Admin
@using Musicx.Presentation.Web.Client.Modals.Admin.Genres
@using Musicx.Presentation.Web.Client.Models
@using Musicx.Presentation.Web.Client.Layout.Auth

@inject ILoggerFactory LoggerProvider
@inject IFindAllService<InGenre, OutGenre> UcList
@inject IDeleteService<InGenre> UcDelete

<AuthorizeView Permission="admin.genre.read">
    <ChildContent>
        <AdminPageCard Title="Genre Management" BreadcrumbItems="_breadcrumb">
            <MudDataGrid T="OutGenre"
                         Items="@_filteredGenres"
                         RowsPerPage="20" Dense ColumnResizeMode="ResizeMode.Column"
                         MultiSelection bind-SelectedItems="@_selectedGenres">
                <ToolBarContent>
                    <AdminGridToolbar Title="Genres"
                                      SearchValue="@_searchDataGrid"
                                      SearchValueChanged="@(value => _searchDataGrid = value)"
                                      OnSearchKeyDown="@KeyDownSearchInput"
                                      ViewMode="@_viewMode"
                                      OnAdd="@ShowAddModal"
                                      OnEnableDeleteMode="@EnableDeleteMode"
                                      OnEnableNormalMode="@EnableNormalMode"
                                      OnConfirmDelete="@ShowDeleteModal"
                                      OnRefresh="@LoadData" />
                </ToolBarContent>
                
                <Columns>
                    <PropertyColumn Property="x => x.CanonicalName"/>

                    <PropertyColumn Property="x => x.Description"/>

                    <PropertyColumn Property="x => x.Type"/>

                    <PropertyColumn Property="x => x.Color"/>

                    <PropertyColumn Property="x => x.CreatedAt" Title="Created At"/>

                    <PropertyColumn Property="x => x.UpdatedAt" Title="Last Modification"/>

                    <TemplateColumn CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           OnClick="@(() => ShowEditModal(context.Item))"/>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="OutGenre" />
                </PagerContent>
            </MudDataGrid>
        </AdminPageCard>

        <GenreEditModal @ref="_genreEditModal" OnSave="OnQuitModal" />

        <MudDialog @ref="_confirmDeleteModal">
            <TitleContent>
                Deletion
            </TitleContent>
            <DialogContent>
                <MudText>Are you sure you want to delete these following genres?</MudText>
                <ul>
                    @foreach (var genre in _selectedGenres)
                    {
                        <li>@genre.CanonicalName</li>
                    }
                </ul>
            </DialogContent>
            <DialogActions>
                <MudButton StartIcon="@Icons.Material.Outlined.Close" Color="Color.Secondary" OnClick="@HideDeleteModal">
                    Cancel
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Check" Color="Color.Error" OnClick="@DeleteData">
                    Confirm
                </MudButton>
            </DialogActions>
        </MudDialog>
    </ChildContent>
</AuthorizeView>