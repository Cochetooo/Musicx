@page "/Admin/GenreDashboard"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Modals.Admin.Genres
@using Musicx.Presentation.Web.Client.Models

@inject ILoggerFactory LoggerProvider
@inject IListUseCase<OutGenre> UcList
@inject IDeleteUseCase<InGenre> UcDelete

<MudBreadcrumbs Items="@_breadcrumb" />

<MudCard Class="py-4">
    <MudCardHeader>
        <MudText Typo="Typo.h4">Genre Management</MudText>
    </MudCardHeader>
    
    <MudCardContent>
        <MudDataGrid T="OutGenre" Items="@_filteredGenres"
                     RowsPerPage="20" Dense ColumnResizeMode="ResizeMode.Column"
                     MultiSelection bind-SelectedItems="@_selectedGenres">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Genres</MudText>
                <MudSpacer />
                <MudTextField
                    @bind-Value="_searchDataGrid"
                    Label="Search"
                    OnKeyDown="@KeyDownSearchInput"
                    Class="mr-2"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    Adornment="Adornment.End"
                    Immediate
                    Variant="Variant.Outlined" />
                <MudSpacer />
                <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Row>
                    @if (_viewMode == ViewMode.Normal)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="mr-2"
                                       OnClick="@ShowAddModal" />
                
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="mr-2"
                                       OnClick="@EnableDeleteMode" />
                    }
                    else if (_viewMode == ViewMode.Delete)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Class="mr-2"
                                       OnClick="@EnableNormalMode" />
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Error" Class="mr-2"
                                       OnClick="@ShowDeleteModal" />
                    }
            
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@LoadData" />
                </MudStack>
            </ToolBarContent>
            
            <Columns>
                <PropertyColumn Property="x => x.Name"/>

                <PropertyColumn Property="x => x.Description"/>

                <PropertyColumn Property="x => x.Type"/>

                <PropertyColumn Property="x => x.Color"/>

                <PropertyColumn Property="x => x.CreatedAt" Title="Created At"/>

                <PropertyColumn Property="x => x.UpdatedAt" Title="Last Modification"/>

                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => ShowEditModal(context.Item))"/>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="OutGenre" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

<GenreEditModal @ref="_genreEditModal" OnSave="OnQuitModal" />

<MudDialog @ref="_confirmDeleteModal">
    <TitleContent>
        Deletion
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete these following genres?</MudText>
        <ul>
            @foreach (var genre in _selectedGenres)
            {
                <li>@genre.Name</li>
            }
        </ul>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Outlined.Close" Color="Color.Secondary" OnClick="@HideDeleteModal">
            Cancel
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Check" Color="Color.Error" OnClick="@DeleteData">
            Confirm
        </MudButton>
    </DialogActions>
</MudDialog>