@page "/Admin/Artists"
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists
@using Musicx.Presentation.Web.Client.Models

@inject ILoggerFactory LoggerFactory

<PageTitle>Admin - Manage Artists</PageTitle>

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="/Admin">Administration</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="#">Manage Artists</BreadcrumbLink>
    </BreadcrumbItem>
</Breadcrumb>

<Card Margin="Margin.Is4.OnY">
    <CardBody>
        <div class="container-fluid" style="display: flex; flex-direction: column;">
            <div class="d-flex justify-content-between align-items-center p-3">
                <TextEdit 
                    @bind-Text="@_searchDataGrid" Placeholder="Search..." 
                    KeyDown="KeyDownSearchInput" Margin="Margin.Is2.FromEnd" />
                
                <div class="d-flex">
                    <Button Color="Color.Primary" Clicked="ApplySearchFilters">Apply</Button>
                </div>
            </div>
            
            <div class="d-flex justify-content-between align-items-center p-3">
                <Div ElementId="#DataGrid-Refresh">
                    <Animate Anchor="#DataGrid-Refresh" Auto Animation="Animations.SlideRight" DelayMilliseconds="300">
                        <Button Clicked="LoadData" Color="Color.Primary" class="mr-2">
                            <Icon Name="IconName.Sync" />
                            Refresh
                        </Button>
                    </Animate>
                </Div>
                
                <Div class="d-flex" ElementId="#DataGrid-Actions">
                    <Animate Anchor="#DataGrid-Actions" Auto Animation="Animations.SlideLeft" DelayMilliseconds="300">
                        @if (_viewMode == ViewMode.Normal)
                        {
                            <Button Clicked="ShowAddModal" Color="Color.Success" class="mr-2">
                                <Icon Name="IconName.PlusCircle"/>
                                Add
                            </Button>
                            <Button Clicked="EnableDeleteMode" Color="Color.Danger" class="mr-2">
                                <Icon Name="IconName.Delete"/>
                                Delete
                            </Button>
                        }
                        else if (_viewMode == ViewMode.Delete)
                        {
                            <Button Clicked="EnableNormalMode" Color="Color.Secondary" class="mr-2">
                                <Icon Name="IconName.Times"/>
                                Cancel
                            </Button>
                            <Button Clicked="ShowDeleteModal" Color="Color.Danger" class="mr-2">
                                <Icon Name="IconName.Check"/>
                                Confirm deletion
                            </Button>
                        }
                    </Animate>
                </Div>
            </div>
            
            <Div class="flex-grow-1 overflow-auto" ElementId="#DataGrid-Animate">
                <Animate Anchor="#DataGrid-Animate" Auto Animation="Animations.ZoomIn" DelayMilliseconds="500">
                    <DataGrid TItem="OutArtist"
                              Data="_filteredArtists"
                              @bind-SelectedRows="@_selectedArtists"
                              SelectionMode="DataGridSelectionMode.Multiple"
                              ShowPager
                              Resizable
                              ResizeMode="TableResizeMode.Header"
                              PageSize="20"
                              Responsive>
                        @if (_viewMode == ViewMode.Delete)
                        {
                            <DataGridMultiSelectColumn Width="30px"/>
                        }
                        
                        <DataGridColumn Field="@nameof(OutArtist.Name)" Caption="Name" />
                        <DataGridColumn Field="@nameof(OutArtist.ArtworkUrl)" Caption="Artwork">
                            <DisplayTemplate>
                                @if (context.ArtworkUrl is not null)
                                {
                                    <Image Source="@context.ArtworkUrl" Loading Fluid />
                                }
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn Field="@nameof(OutArtist.Country)" Caption="Country" />
                        <DataGridColumn Field="@nameof(OutArtist.Discriminator)" Caption="Type" />
                        <DataGridColumn Caption="Edit">
                            <DisplayTemplate>
                                <Button Color="Color.Link" Size="Size.Small" Clicked="@(() => ShowEditModal(context))">
                                    <Icon Name="IconName.Pen" />
                                </Button>
                            </DisplayTemplate>
                        </DataGridColumn>
                    </DataGrid>
                </Animate>
            </Div>
        </div>
    </CardBody>
</Card>

<ArtistAddModal @ref="_artistAddModal" OnSave="OnQuitModal" />
<ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" SelectedArtists="@_selectedArtists" />

<Modal @ref="_confirmDeleteModal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Deletion</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <span>Are you sure you want to delete these artists?</span>
            <UnorderedList>
                @foreach (var artist in _selectedArtists)
                {
                    <UnorderedListItem>@artist.Name</UnorderedListItem>
                }
            </UnorderedList>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@HideDeleteModal">Close</Button>
            <Button Color="Color.Primary" Clicked="@DeleteData">Save Changes</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {

    private ViewMode _viewMode = ViewMode.Normal;

    private ArtistAddModal? _artistAddModal;
    private ArtistEditModal? _artistEditModal;
    private Modal? _confirmDeleteModal;

    private ILogger<Artist> _logger = null!;

    private List<OutArtist> _artists = [];
    private List<OutArtist> _filteredArtists = [];
    private List<OutArtist> _selectedArtists = [];

    private string _searchDataGrid = null!;

    protected override async Task OnInitializedAsync()
    {
        _logger = LoggerFactory.CreateLogger<Artist>();
        
        _logger.Info("📜 Current Page : /Artist");

        //await LoadData();
    }

    private async Task LoadData()
    {
        _logger.Info("🔄️ ArtistPage : UPDATE Data");
        _filteredArtists = new List<OutArtist>(_artists);
        StateHasChanged();
    }

    private void ShowAddModal()
    {
        _artistAddModal?.Show();
    }

    private async Task ShowEditModal(OutArtist artist)
    {
        _selectedArtists.Clear();
        _selectedArtists.Add(artist);

        _artistEditModal?.Show();
    }

    private async Task DeleteData()
    {
        await HideDeleteModal();
        await LoadData();
        EnableNormalMode();
    }

    private void EnableDeleteMode()
    {
        _selectedArtists.Clear();
        _viewMode = ViewMode.Delete;
    }
    
    private void EnableNormalMode()
    {
        _selectedArtists.Clear();
        _viewMode = ViewMode.Normal;
    }

    private Task ShowDeleteModal()
    {
        return _confirmDeleteModal!.Show();
    }

    private Task HideDeleteModal()
    {
        return _confirmDeleteModal!.Hide();
    }

    private async Task OnQuitModal()
    {
        EnableNormalMode();
        await LoadData();
    }

    private void ApplySearchFilters()
    {
        _logger.Debug($"🔎 ArtistPage : Apply Search Filters: {_searchDataGrid}");

        var keywords = string.IsNullOrWhiteSpace(_searchDataGrid)
            ? []
            : _searchDataGrid.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        _filteredArtists = _artists
            .Where(a =>
                keywords.Length == 0
                || keywords.All(keyword =>
                    a.Name.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private void KeyDownSearchInput(KeyboardEventArgs keyEvent)
    {
        if (keyEvent.Key == "Enter")
        {
            ApplySearchFilters();
        }
    }

}