@page "/Album/{id}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums

@inject IGetUseCase<OutAlbum> UcGet
@inject IFindInUseCase<OutGenre> UcFindInGenres
@inject ILoggerProvider LoggerProvider

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="#">Albums</BreadcrumbLink>
    </BreadcrumbItem>
    @if (null == _album)
    {
        <BreadcrumbItem>
            <BreadcrumbLink To="#">-</BreadcrumbLink>
        </BreadcrumbItem>
    }
    else
    {
        <BreadcrumbItem>
            <BreadcrumbLink To="#">@_album.Name</BreadcrumbLink>
        </BreadcrumbItem>
    }
</Breadcrumb>

@if (null == _album)
{
    <SpinKit Type="SpinKitType.Pulse" />
}
else
{
    <Card Margin="Margin.Is4.OnY">
        <CardHeader Padding="Padding.Is3.OnX">
            <Heading Size="HeadingSize.Is4" Style="font-weight: 900">@_album.Name</Heading>
            @if (_album.Artist is not null)
            {
                <Blazorise.Link To="@($"/Artist/{_album.Artist.Id}")">
                    <Heading Size="HeadingSize.Is6" TextWeight="TextWeight.SemiBold" TextColor="TextColor.Muted">
                        @_album.Artist.Name
                    </Heading>
                </Blazorise.Link>
            }
        </CardHeader>
        <CardBody>
            @if (_album.IsFarRight)
            {
                <Row Padding="Padding.Is3.OnAll">
                    <Column Padding="Padding.Is3.OnAll" ColumnSize="ColumnSize.Is12">
                        <Jumbotron Background="Background.Warning" Margin="Margin.Is3">
                            <JumbotronTitle Size="JumbotronTitleSize.Is4">National Socialist Content</JumbotronTitle>
                            <JumbotronSubtitle>
                                ⚠️ This release is marked with the "national socialist" tag.<br/>
                                We do not endorse or support any of the associated ideologies.<br/>
                                Our role is solely to document and archive all forms of musical expression,
                                regardless of their origin or context. ⚠️
                            </JumbotronSubtitle>
                        </Jumbotron>
                    </Column>
                </Row>
            }
            <Row Margin="Margin.Is3.OnX">
                <Column Padding="Padding.Is3.OnAll" ColumnSize="ColumnSize.Is3">
                    <Image Style="border-radius:10px; height:auto; width: 100%;" 
                           Class="neumorphism-shadow-default" 
                           Source="@_album.ArtworkUrl"/>
                </Column>
                <Column Padding="Padding.Is3.OnAll" ColumnSize="ColumnSize.Is9">
                    <Card>
                        <CardBody>
                            <CardTitle Size="5">
                                Details
                            </CardTitle>
                            <ListGroup Flush>
                                @if (null != _album.OriginalReleaseDate)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Release Date
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            @_album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")
                                        </DescriptorValue>
                                    </Descriptor>
                                }

                                @if (null != _album.ReleaseType)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Release Type
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            @_album.ReleaseType.Value.ToString()
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                                
                                @if (_album.PrimaryGenres is not null && 0 < _album.PrimaryGenres.Count)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Genres
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            <Div Flex="Flex.Wrap">
                                                @foreach (var genre in _album.PrimaryGenres)
                                                {
                                                    <GenreBadge Genre="@genre" />
                                                }
                                            </Div>
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                                
                                @if (_album.InfluenceGenres is not null && 0 < _album.InfluenceGenres.Count)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Influences
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            <Div Flex="Flex.Wrap">
                                                @foreach (var genre in _album.InfluenceGenres)
                                                {
                                                    <GenreBadge Influence Genre="@genre" />
                                                }
                                            </Div>
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                            </ListGroup>
                        </CardBody>
                    </Card>
                </Column>
            </Row>
            <Row Margin="Margin.Is3.OnAll">
                <Button Clicked="EditTrackListShowModal" Color="Color.Success">
                    <Icon Name="IconName.Edit" Margin="Margin.Is2.OnX"/>
                    Edit Track List
                </Button>
                
                <Button Clicked="EditAlbumShowModal" Margin="Margin.Is2.FromStart" Color="Color.Secondary">
                    <Icon Name="IconName.Pen" />
                </Button>
            </Row>
        </CardBody>
    </Card>
}

<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />
<AlbumTrackListEditModal @ref="_trackListEditModal" OnSave="OnQuitModal" />

@code {

    [Parameter] public string? Id { get; set; }

    private ILogger _logger = null!;

    private AlbumEditModal? _albumEditModal;
    private AlbumTrackListEditModal? _trackListEditModal;

    private OutAlbum? _album;
    private List<OutSong> _albumSongs = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _logger = LoggerProvider.CreateLogger(nameof(AlbumView));

        await LoadAlbum();
    }

    private async Task LoadAlbum()
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            _logger.LogError("❌ Album ID is null or empty.");
            return;
        }
        
        if (!long.TryParse(Id, out var albumId))
        {
            _logger.LogError("❌ Invalid Album ID format: {Id}", Id);
            return;
        }

        _album = await UcGet.ExecuteAsync(albumId, "artist_genre");
        
        if (_album is null)
        {
            _logger.LogError("⚠️ No album found for ID: {Id}", Id);
            return;
        }
        
        _logger.LogInformation($"✅ Album loaded: {_album.Name} ({_album.Id})");
        StateHasChanged();

        if (_album.PrimaryGenres is not null && 0 < _album.PrimaryGenres.Count)
        {
            _album.PrimaryGenres = await UcFindInGenres.ExecuteAsync(_album.PrimaryGenres.Select(g => g.Id).ToList());
            _logger.LogInformation($"🏷️ Primary genres loaded for {_album.Name} ({_album.Id})");
            StateHasChanged();
        }

        if (_album.InfluenceGenres is not null && 0 < _album.InfluenceGenres.Count)
        {
            _album.InfluenceGenres = await UcFindInGenres.ExecuteAsync(_album.InfluenceGenres.Select(g => g.Id).ToList());
            _logger.LogInformation($"🏷️ Influence genres loaded for {_album.Name} ({_album.Id})");
            StateHasChanged();
        }
    }

    private void EditTrackListShowModal()
    {
        if (null == _album)
        {
            _logger.LogError("❌ Cannot edit tracklist: album is null.");
            return;
        }
        
        _trackListEditModal?.Show(_album);
    }

    private void EditAlbumShowModal()
    {
        if (null == _album)
        {
            _logger.LogError("❌ Cannot edit album: album is null.");
            return;
        }
        
        if (null == _album.Artist)
        {
            _logger.LogError("⚠️ Cannot edit album: artist is null.");
            return;
        }
        
        _albumEditModal?.Show(_album.Artist, _album);
    }

    private async Task OnQuitModal()
    {
        await LoadAlbum();
    }

}