@page "/"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.Genre

@inject ICountService<OutArtist> UcCountArtists
@inject ICountService<OutAlbum> UcCountAlbums
@inject ICountService<OutSong> UcCountSongs
@inject ICountService<OutGenre> UcCountGenres

<HeadContent>
    <link rel="stylesheet" href="Css/Features/Search/search-overlay.css" />
    <link rel="stylesheet" href="Css/Features/Pages/home.css"/>
</HeadContent>

<MudGrid Class="home-container">
    <MudItem xs="12" Class="flex-center">
        <MudCard Class="glass-card home-card pa-6">
            <MudText Typo="Typo.h1" Class="montserrat text-mega-bold">
                Welcome to Musicx!
            </MudText>
            <MudText Typo="Typo.body1" Class="mb-4 color-secondary">
                Counting @_artistCount artists, @_albumCount albums, @_songCount songs & @_genreCount genres
            </MudText>
            
            <MudCarousel AutoCycle AutoCycleTime="TimeSpan.FromSeconds(4)"
                         TData="RenderFragment" Class="home-carousel"
                         ShowArrows="@false" ShowBullets>
                <MudCarouselItem Color="@Color.Primary">
                    <div class="d-flex home-carousel-card">
                        <MudText Typo="Typo.h3">🎶 Discover new artists</MudText>
                    </div>
                </MudCarouselItem>
                <MudCarouselItem Color="@Color.Secondary">
                    <div class="d-flex home-carousel-card">
                        <MudText Typo="Typo.h3">💿 Explore trending albums</MudText>
                    </div>
                </MudCarouselItem>
                <MudCarouselItem Color="@Color.Tertiary">
                    <div class="d-flex home-carousel-card">
                        <MudText Typo="Typo.h3">🎧 Dive into unique genres</MudText>
                    </div>
                </MudCarouselItem>
            </MudCarousel>
        </MudCard>
    </MudItem>
</MudGrid>