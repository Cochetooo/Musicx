@page "/User/{id}"

@using System.Globalization
@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Models.Auth

@inject ILoggerFactory LoggerFactory
@inject IGetUseCase<OutUser> UcGet
@inject IGetAlbumAttributesByUser UcGetAlbumAttrs
@inject IUserClientContext UserClientContext
@inject IGetRatingDistribByUser<OutAlbum> UcGetAlbumRatingDistrib

@if (null == _user)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        <!-- Bio -->
        <div class="user-hero">
            <style>
                .user-hero::before {
                    background-image: url('@_user.PictureUrl');
                }
            </style>
            
            <div class="user-hero-content">
                <div class="user-hero-image">
                    <MudImage Alt="Profile Picture" Width="192" Height="192"
                              Elevation="8"
                              Class="rounded-circle" Src="@_user.PictureUrl" />
                </div>
                
                <div>
                    <MudText Typo="Typo.h2" Class="montserrat mb-2 text-bold user-name clamped-text-2 animate-text">
                        @_user.Name
                    </MudText>
                    
                    <MudText Typo="Typo.body2" Class="text-light text-color-secondary text-shadow mb-4">
                        Short bio goes here.
                    </MudText>
                    
                    @if (_user.Id == UserClientContext.CurrentUser?.Id)
                    {
                        <MudStack Justify="Justify.FlexStart" Row Spacing="3">
                            <MudButton Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Filled">
                                Edit Profile
                            </MudButton>
                        
                            <MudButton Color="Color.Dark" StartIcon="@Icons.Material.Filled.Settings"
                                       Variant="Variant.Filled">
                                Settings
                            </MudButton>
                        </MudStack>
                    }
                </div>
                
                <div>
                    <MudStack Justify="Justify.FlexEnd" Row Spacing="3">
                        @if (_user.Id == UserClientContext.CurrentUser?.Id)
                        {
                                                    
                            <MudButton Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.DeleteForever"
                                       Variant="Variant.Filled">
                                Clear Ratings
                            </MudButton>
                        }
                        
                        <MudButton Color="Color.Surface" StartIcon="@Icons.Material.Filled.Download"
                                   Variant="Variant.Filled">
                            Export Ratings
                        </MudButton>
                        
                        @if (_user.Id != UserClientContext.CurrentUser?.Id)
                        {
                            <MudButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Variant="Variant.Filled">
                                Follow
                            </MudButton>
                        }
                    </MudStack>
                </div>
            </div>
        </div>
        
        <MudGrid Spacing="2">
            <MudItem xs="12" md="2">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                        Rating Distribution
                    </MudText>

                    <MudDivider Class="my-3"/>

                    @if (_albumRatingDistrib is not null && _albumCount > 0)
                    {
                        foreach (var ratingCount in _albumRatingDistrib.RatingCounts.OrderByDescending(rc => rc.Key))
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Style="width: 100%" Spacing="4">
                                <!-- Label à gauche -->
                                <MudText Class="montserrat"
                                         Typo="Typo.caption"
                                         Style="min-width: 100px;">
                                    <span style="font-weight: 300;" class="text-color-secondary montserrat">
                                        <!-- @RatingHelper.GetRatingFormatted(ratingCount.Key - 9, UserClientContext.CurrentUser?.PrefRatingMode ?? 0) - @RatingHelper.GetRatingFormatted(ratingCount.Key, UserClientContext.CurrentUser?.PrefRatingMode ?? 0) -->
                                        @(ratingCount.Key - 9) - @ratingCount.Key
                                    </span>
                                    <span style="font-weight: 500; font-size: 0.925em; margin-left: 4px;" class="montserrat">
                                        (@ratingCount.Value)
                                    </span>
                                </MudText>

                                <!-- Barre à droite, qui s’étend -->
                                <MudProgressLinear Class="rating-bar flex-grow"
                                                   Style="@($"--bar-color:{RatingHelper.GetColorForRating(ratingCount.Key - 5)}; width: 100%")"
                                                   Rounded="true"
                                                   Value="@(ratingCount.Value / (double)_albumCount * 100)"
                                                   Size="Size.Large"/>
                            </MudStack>
                        }
                    }
                </MudPaper>
                
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                        Statistics
                    </MudText>
                    
                    <MudDivider Class="my-3"/>
                    
                    <MudList T="RenderFragment" Dense>
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat text-color-primary">
                                    Average Rating
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat" Color="Color.Primary">
                                    --.--
                                </MudText>
                            </MudStack>
                        </MudListItem>
                        
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat text-color-primary">
                                    A-M artists ratio
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat" Color="Color.Primary">
                                    --% / --%
                                </MudText>
                            </MudStack>
                        </MudListItem>
                        
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat text-color-primary">
                                    Rating Variance
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat text-color-primary">
                                    --.--
                                </MudText>
                            </MudStack>
                        </MudListItem>
                        
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat text-color-primary">
                                    Most Rated Release Year
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat" Color="Color.Primary">
                                    2000
                                </MudText>
                            </MudStack>
                        </MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTable ServerData="@LoadUserAttrData" ReadOnly
                          Elevation="8"
                          Breakpoint="Breakpoint.Sm"
                          RowClass="rating-row"
                          RowStyleFunc="@((item, _) => $"--rating-color:{RatingHelper.GetColorForRating(item.Rating)}")"
                          @ref="_albumRatingsTable"
                          Class="mt-4 pa-2 bg-surface animate-hover-up" Dense>
                    <ColGroup>
                        <col />
                        <col style="width: 100%;"/>
                        <col style="width: 120px;"/>
                        <col style="width: 100px;"/>
                    </ColGroup>
                    <ToolBarContent>
                        <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">Ratings (@_albumCount)</MudText>
                        <MudSpacer />
                        <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Search"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium" Class="mt-0" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Rating ?? 0))">
                                Rating
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            Album
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.CollectionType ?? 0))">
                                Collection
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.UpdatedAt))">
                                Date
                            </MudTableSortLabel>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Rating" Class="rating-col">
                            <MudText Typo="Typo.body1" Class="montserrat text-color-primary rating-text">
                                @RatingHelper.GetRatingFormatted(context.Rating, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                            </MudText>
                        </MudTd>
                        
                        <MudTd DataLabel="Releases">
                            <MudLink Href="@($"/Album/{@context.Album.Id}")">
                                <MudStack Justify="Justify.FlexStart" Row>
                                    <MudImage Src="@context.Album.ArtworkUrl" Alt="@context.Album.Name"
                                              Width="48" Height="48"
                                              Class="rounded-lg"
                                              Elevation="25"/>

                                    <AlbumListQuickInfo class="mx-3" ShowArtist="true"
                                                        Album="@context.Album"/>
                                </MudStack>
                            </MudLink>
                        </MudTd>

                        <MudTd DataLabel="Collection">
                            @(context.CollectionType?.ToString() ?? string.Empty)
                        </MudTd>

                        <MudTd DataLabel="Date" Style="justify-items: center;">
                            <MudText Typo="Typo.body2" Class="text-color-primary text-light">
                                @context.UpdatedAt.ToString("dd MMM", CultureInfo.CurrentCulture)
                            </MudText>
                            <MudText Typo="Typo.body1" Class="text-color-primary text-bold">
                                @context.UpdatedAt.ToString("yyyy", CultureInfo.CurrentCulture)
                            </MudText>
                        </MudTd>
                    </RowTemplate>

                    <PagerContent>
                        <MudTablePager/>
                    </PagerContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                        Favorites
                    </MudText>
                    
                    <MudDivider Class="my-3"/>
                </MudPaper>
                
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                        Friends
                    </MudText>
                    
                    <MudDivider Class="my-3"/>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

<style>
    .rating-bar .mud-progress-linear-bar {
        background-color: var(--bar-color) !important;
    }

    .rating-col {
        position: relative;
        overflow: hidden;
        transition: width 0.25s ease-in;
        width: auto;
    }

    .rating-col:hover {
        width: 150px;
    }

    .rating-col::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 0;
        background: linear-gradient(
            90deg,
            var(--rating-color) 0%,
            color-mix(in srgb, var(--rating-color) 60%, transparent) 45%,
            color-mix(in srgb, var(--rating-color) 30%, transparent) 65%,
            transparent 100%
        );
        opacity: 0.36;
    }

    .rating-text {
        position: relative;
        z-index: 1;
        font-weight: 600;
        text-shadow:
            0 1px 2px rgba(0,0,0,0.45),
            0 0 4px rgba(0,0,0,0.25);
    }
</style>