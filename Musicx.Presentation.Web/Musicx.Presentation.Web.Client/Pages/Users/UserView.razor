@page "/User/{id}"

@using System.Globalization
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Shared.Interfaces.Localization
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Application.Shared.Interfaces.UseCases.User
@using Musicx.Application.Shared.Interfaces.UseCases.User.AlbumAttribute
@using Musicx.Application.Shared.Interfaces.UseCases.User.Ratings
@using Musicx.Application.Shared.Models.User.Ratings
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.User
@using Musicx.Presentation.Web.Client.Components.Albums
@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Components.Genres
@using Musicx.Presentation.Web.Client.Components.Ratings
@using Musicx.Presentation.Web.Client.Features.Users.ViewModels.UserGenreRatings

@inject ILoggerFactory LoggerFactory
@inject IFindOneByIdService<InUser, OutUser> UcGet
@inject IFindAlbumAttributesByUserService UcFindAlbumAttrs
@inject IUserClientContext UserClientContext
@inject IFindRatingDistribByUserService<OutAlbum> UcFindAlbumRatingDistrib
@inject IFindUserGenreRatingsService UcFindUserGenreRatings
@inject IFindUserDataViewService UcUserDataView
@inject IDeleteService<InUserAlbumAttribute> UcDeleteAllRatings
@inject IExportUserRatingsService UcExportRatings
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ITranslationService T

@inject UserGenreRatingsViewModel GenreRatingsViewModel

@if (null == _user)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        <!-- Bio -->
        <div class="user-hero" style="--hero-url: url('@(_user.BannerUrl ?? _user.PictureUrl)');
            --hero-filter: @(_user.PrefBannerBlur && _user.BannerUrl is not null ? "none" : "blur(24px) saturate(0.9) brightness(0.4)");">
            <div class="user-hero-content">
                <div class="user-hero-image">
                    @if (_user.PictureUrl is not null)
                    {
                        <MudImage Alt="Profile Picture" Width="192" Height="192"
                                  @key="_user.PictureUrl"
                                  Elevation="8"
                                  Class="rounded-circle" Src="@_user.PictureUrl"/>
                    }
                </div>
                
                <div>
                    <MudText Typo="Typo.h2" Class="montserrat mb-2 text-bold user-name clamped-text-2 animate-text">
                        @_user.Name
                    </MudText>
                    
                    <MudText Typo="Typo.body2" Class="text-light color-secondary text-shadow mb-2">
                        @if (UserAge is not null)
                        {
                            @T.Get("Web.UserView.AgeYearsOld", UserAge) <text> ⸱ </text>
                        }
                        
                        @T.Get("Web.UserView.JoinedAgo", DurationHelper.FormatYearMonthDayDuration(_user.CreatedAt, DateTime.Now))
                    </MudText>
                    
                    
                    <MudText Typo="Typo.body2" Class="text-light color-primary text-shadow mb-4">
                        @_user.Biography
                    </MudText>
                    
                    @if (_user.Id == UserClientContext.CurrentUser?.Id)
                    {
                        <MudStack Justify="Justify.FlexStart" Row Spacing="3">
                            <MudLink Href="/User/Edit">
                                <MudButton Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Edit"
                                           Variant="Variant.Filled">
                                    @T["Web.UserView.EditProfile"]
                                </MudButton>
                            </MudLink>
                        </MudStack>
                    }
                </div>
                
                <div>
                    <MudStack Justify="Justify.FlexEnd" Row Spacing="3">
                        @if (_user.Id == UserClientContext.CurrentUser?.Id)
                        {
                                                    
                            <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever"
                                       OnClick="@OnClearRatingsButtonClicked"
                                       Variant="Variant.Filled">
                                @T["Web.UserView.ClearRatings"]
                            </MudButton>
                        }
                        
                        <MudButton Color="Color.Surface" StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="@OnExportRatingsButtonClicked"
                                   Variant="Variant.Filled">
                            @T["Web.UserView.ExportRatings"]
                        </MudButton>
                        
                        @if (_user.Id != UserClientContext.CurrentUser?.Id)
                        {
                            <MudButton Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd"
                                       Variant="Variant.Filled">
                                @T["Web.Common.Follow"]
                            </MudButton>
                        }
                    </MudStack>
                </div>
            </div>
        </div>
        
        <MudGrid Spacing="2">
            <MudItem xs="12" md="2">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="@T["Web.UserView.RatingDistribution"]" />
                    <MudDivider Class="my-3"/>

                    @if (_albumRatingDistrib is not null && _albumCount > 0)
                    {
                        foreach (var ratingCount in _albumRatingDistrib.RatingCounts.OrderByDescending(rc => rc.Key))
                        {
                            <MudStack Row AlignItems="AlignItems.Center" Style="width: 100%" Spacing="4">
                                <!-- Label à gauche -->
                                <MudText Class="montserrat"
                                         Typo="Typo.caption"
                                         Style="min-width: 80px;">
                                    <span style="font-weight: 300;" class="color-secondary montserrat">
                                        <!-- @RatingHelper.GetRatingFormatted(ratingCount.Key - 9, UserClientContext.CurrentUser?.PrefRatingMode ?? 0) - @RatingHelper.GetRatingFormatted(ratingCount.Key, UserClientContext.CurrentUser?.PrefRatingMode ?? 0) -->
                                        @(ratingCount.Key - 9) - @ratingCount.Key
                                    </span>
                                    <span style="font-weight: 500; font-size: 0.925em; margin-left: 4px;" class="montserrat">
                                        (@ratingCount.Value)
                                    </span>
                                </MudText>

                                <!-- Barre à droite, qui s’étend -->
                                <MudProgressLinear Class="rating-bar flex-grow"
                                                   Style="@($"--bar-color:{RatingHelper.GetColorForRating((ratingCount.Key - 5) * 100)}; width: 100%")"
                                                   Rounded="true"
                                                   Value="@(ratingCount.Value / (double)_maxRatingDistribCount * 100)"
                                                   Size="Size.Large"/>
                            </MudStack>
                        }
                    }
                </MudPaper>
                
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="@T["Web.UserView.Statistics"]" />
                    <MudDivider Class="my-3"/>
                    
                    <MudList T="RenderFragment" Dense>
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat color-secondary">
                                    @T["Web.UserView.AverageRating"]
                                </MudText>
                                <DonutRating Rating="@_albumRatingDistrib?.AverageRating"
                                             Size="DonutRatingSize.ExtraSmall"
                                             RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"/>
                            </MudStack>
                        </MudListItem>
                                                
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat color-secondary">
                                    @T["Web.UserView.RatingStandardDeviation"]
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat color-primary" Style="min-width: 50px;">
                                    ± @RatingHelper.GetRatingFormatted(_albumRatingDistrib?.RatingStandardDev, 
                                          UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                </MudText>
                            </MudStack>
                        </MudListItem>
                        
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat color-secondary">
                                    @T["Web.UserView.MostRatedReleaseYear"]
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat color-primary">
                                    @(_albumRatingDistrib?.MostRatedReleaseYear.ToString() ?? "-")
                                </MudText>
                            </MudStack>
                        </MudListItem>
                        
                        <MudListItem>
                            <MudStack Row Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body1" Class="text-light montserrat color-secondary">
                                    @T["Web.UserView.ArtistsRatioAM"]
                                </MudText>
                                <MudText Typo="Typo.body1" Class="text-bold montserrat color-primary">
                                    @Math.Round(_albumRatingDistrib?.ArtistNameRatioAMvsNZ * 100 ?? 0)% / 
                                    @(100 - Math.Round(_albumRatingDistrib?.ArtistNameRatioAMvsNZ * 100 ?? 0))%
                                </MudText>
                            </MudStack>
                        </MudListItem>
                    </MudList>
                </MudPaper>
                
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="@T["Web.UserView.Friends"]" />
                    <MudDivider Class="my-3"/>
                </MudPaper>
                
            </MudItem>
            
            <MudItem xs="12" md="7">
                <MudTable ServerData="@LoadUserAttrData" ReadOnly
                          Elevation="8"
                          Breakpoint="Breakpoint.Sm"
                          RowStyleFunc="@((item, _) => $"--rating-color:{RatingHelper.GetColorForRating(item.Rating)}")"
                          @ref="_albumRatingsTable"
                          Class="mt-4 pa-2 bg-main animate-hover-up" Dense>
                    <ColGroup>
                        <col />
                        <col style="width: 100%;"/>
                        <col style="width: 120px;"/>
                        <col style="width: 100px;"/>
                    </ColGroup>
                    <ToolBarContent>
                        <PanelTitle Text="@T["Web.UserView.Ratings"]" Count="@_albumCount.ToString()" />
                        <MudSpacer/>
                        
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="@T["Web.UserView.SearchRatings"]"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium" Class="mt-0"/>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>
                            <MudTableSortLabel SortLabel="Rating" SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Rating ?? 0))">
                                @T["Web.UserView.Rating"]
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortLabel="Album" SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Album.Artist?.Name ?? string.Empty))">
                                @T["Web.UserView.Album"]
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortLabel="Collection" SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.CollectionType ?? 0))">
                                @T["Web.UserView.Collection"]
                            </MudTableSortLabel>
                        </MudTh>
                        <MudTh>
                            <MudTableSortLabel SortLabel="Date" SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.UpdatedAt))">
                                @T["Web.UserView.Date"]
                            </MudTableSortLabel>
                        </MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Rating" Class="rating-col">
                            <MudText Typo="Typo.h5" Class="color-primary text-bold rating-text"
                                     Style="width: fit-content;">
                                @RatingHelper.GetRatingFormatted(context.Rating, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                            </MudText>
                        </MudTd>
                        
                        <MudTd DataLabel="Releases">
                            <MudLink Href="@($"/Album/{@context.Album.Id}")">
                                <MudStack Justify="Justify.FlexStart" Row>
                                    <MudImage Src="@context.Album.ArtworkUrl" Alt="@context.Album.Name"
                                              @key="context.Album.ArtworkUrl"
                                              Width="64" Height="64"
                                              Class="rounded-lg"
                                              Elevation="25"/>

                                    <AlbumListQuickInfo class="mx-3" ShowArtist="true"
                                                        ShowGenres="true"
                                                        Album="@context.Album"/>
                                </MudStack>
                            </MudLink>
                        </MudTd>

                        <MudTd DataLabel="Collection">
                            @(context.CollectionType?.ToString() ?? string.Empty)
                        </MudTd>

                        <MudTd DataLabel="Date" Style="justify-items: center;">
                            <MudText Typo="Typo.body2" Class="color-primary text-light">
                                @context.UpdatedAt.ToString("dd MMM", CultureInfo.CurrentCulture)
                            </MudText>
                            <MudText Typo="Typo.body1" Class="color-primary text-bold">
                                @context.UpdatedAt.ToString("yyyy", CultureInfo.CurrentCulture)
                            </MudText>
                        </MudTd>
                    </RowTemplate>

                    <PagerContent>
                        <MudTablePager/>
                    </PagerContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" md="3">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <PanelTitle Text="@T["Web.UserView.FavouriteGenres"]" />

                        <MudSwitch @bind-Value="GenreRatingsViewModel.ShowWeighted"
                                   Color="Color.Tertiary"
                                   LabelPlacement="Placement.Start"
                                   Class="genre-rating-switch"
                                   Label="@(GenreRatingsViewModel.ShowWeighted ? T["Web.UserView.Weighted"] : T["Web.UserView.Raw"])"/>

                        <MudButton OnClick="@OnExpandTopGenresButtonClicked">
                            @if (GenreRatingsViewModel.TopGenresExpanded)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ExpandLess"/>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ExpandMore"/>
                            }
                        </MudButton>
                    </MudStack>

                    <MudDivider Class="my-3"/>

                    @if (GenreRatingsViewModel.DisplayedGenreRatings.Count > 0)
                    {
                        <MudList Dense T="RenderFragment">
                            @foreach (var genreRating in GenreRatingsViewModel.DisplayedGenreRatings.Take(5))
                            {
                                <MudListItem>
                                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                            <GenreBadge Genre="@MapGenreBadge(genreRating)" Clickable Size="Size.Small" />
                                        </MudStack>

                                        @if (GenreRatingsViewModel.ShowWeighted)
                                        {
                                            <MudText Typo="Typo.body2"
                                                     Class="text-bold"
                                                     Style="@("color: " + GetGenreRatingPercentColor(genreRating))">
                                                @GetGenreRatingPercentText(genreRating)
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body2" Class="text-bold color-primary">
                                                @T.Get("Web.UserView.AlbumsCount", genreRating.AlbumCount)
                                            </MudText>
                                        }
                                    </MudStack>
                                </MudListItem>
                            }
                            
                            @if (GenreRatingsViewModel.DisplayedGenreRatings.Count > 5)
                            {
                                <MudCollapse Expanded="@GenreRatingsViewModel.TopGenresExpanded">
                                    @foreach (var genreRating in GenreRatingsViewModel.DisplayedGenreRatings.Skip(5))
                                    {
                                        <MudListItem>
                                            <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                                    <GenreBadge Genre="@MapGenreBadge(genreRating)" Clickable Size="Size.Small" />
                                                </MudStack>

                                                @if (GenreRatingsViewModel.ShowWeighted)
                                                {
                                                    <MudText Typo="Typo.body2"
                                                             Class="text-bold"
                                                             Style="@("color: " + GetGenreRatingPercentColor(genreRating))">
                                                        @GetGenreRatingPercentText(genreRating)
                                                    </MudText>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Class="text-bold color-primary">
                                                        @T.Get("Web.UserView.AlbumsCount", genreRating.AlbumCount)
                                                    </MudText>
                                                }
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudCollapse>
                            }
                        </MudList>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="color-secondary">
                            @T["Web.UserView.NoGenreData"]
                        </MudText>
                    }
                </MudPaper>
                
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="@T["Web.UserView.FavouriteAlbums"]" />
                    <MudDivider Class="my-3"/>

                    <MudStack Row
                              Wrap="Wrap.Wrap"
                              Justify="Justify.Center"
                              Spacing="3">

                        @foreach (var album in _favAlbums)
                        {
                            <MudLink Href="@($"/Album/{album.Id}")"
                                     Underline="Underline.None"
                                     Class="album-link">

                                <MudPaper Elevation="3"
                                          Class="pa-2 album-card">

                                    <MudImage Src="@album.ArtworkUrl"
                                              Alt="@album.Name"
                                              Width="160"
                                              Height="160"
                                              Class="album-art rounded-lg"/>

                                    <MudText Typo="Typo.subtitle2"
                                             Align="Align.Center"
                                             Class="mt-2 text-bold clamped-text-2">
                                        @album.Name
                                    </MudText>

                                    @if (album.Artist?.Name is not null)
                                    {
                                        <MudText Typo="Typo.subtitle2"
                                                 Align="Align.Center"
                                                 Class="color-secondary clamped-text-2">
                                            @album.Artist.Name
                                        </MudText>
                                    }

                                </MudPaper>
                            </MudLink>
                        }

                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <MudDialog @ref="_exportRatingsModal">
            <TitleContent>
                @T["Web.UserView.ExportRatings"]
            </TitleContent>
            <DialogContent>
                <MudText Class="mb-2">@T["Web.UserView.SelectExportFormat"]</MudText>
                <MudRadioGroup T="UserRatingsExportFormat" @bind-Value="_selectedExportFormat">
                    <MudRadio Value="@UserRatingsExportFormat.Csv" Color="Color.Primary">CSV (.csv)</MudRadio>
                    <MudRadio Value="@UserRatingsExportFormat.Xlsx" Color="Color.Primary">Excel (.xlsx)</MudRadio>
                    <MudRadio Value="@UserRatingsExportFormat.Json" Color="Color.Primary">JSON (.json)</MudRadio>
                </MudRadioGroup>
            </DialogContent>
            <DialogActions>
                <MudButton Color="Color.Secondary" Variant="Variant.Text" OnClick="@OnCancelExportButtonClicked">
                    @T["Web.Common.Cancel"]
                </MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Download" OnClick="@OnConfirmExportButtonClicked">
                    @T["Web.Common.Download"]
                </MudButton>
            </DialogActions>
        </MudDialog>
        
    </MudContainer>
}

<style>
    .rating-bar .mud-progress-linear-bar {
        background-color: var(--bar-color) !important;
    }

    .album-link {
        text-decoration: none;
    }

    .album-card {
        width: 180px;
        transition: all 0.25s ease;
        border-radius: 16px;
    }

    .album-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.25);
    }

    .album-art {
        object-fit: cover;
        border-radius: 14px;
        transition: transform 0.25s ease;
    }

    .album-card:hover .album-art {
        transform: scale(1.05);
    }
    
    .genre-rating-switch {
        padding: 2px 8px;
        border-radius: 999px;
        background: rgba(255,255,255,0.05);
    }
</style>