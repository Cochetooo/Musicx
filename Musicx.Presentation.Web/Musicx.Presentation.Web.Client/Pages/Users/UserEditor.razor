@page "/User/Edit"
@using System.Globalization
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Security
@using Musicx.Application.Web.Interfaces.UseCases.User.Avatar
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Components.Base

@inject IUserClientContext UserClientContext
@inject ISaveService<InUser> UcSave
@inject IAuthUserSavePasswordService UcSavePassword
@inject ISaveAvatarService UcSaveAvatar
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 bg-main pa-6 animate-hover-up">
    <MudStack Spacing="4">
        <PanelTitle Text="Edit Profile" />

        @if (_user is null)
        {
            <MudAlert Severity="Severity.Warning">
                Please sign in to edit your profile.
            </MudAlert>
        }
        else
        {
            <!-- Avatar -->
            <MudStack Row Spacing="4" AlignItems="AlignItems.Center">
                <MudAvatar Size="Size.Large">
                    <MudImage Src="@_user.PictureUrl"/>
                </MudAvatar>

                <MudFileUpload T="IBrowserFile"
                               OnFilesChanged="OnAvatarSelected">
                    <CustomContent>
                        <MudFab Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="@context.OpenFilePickerAsync"
                                StartIcon="@Icons.Material.Filled.Image"
                                Label="Upload avatar"/>
                    </CustomContent>
                </MudFileUpload>
            </MudStack>

            <!-- Bio -->
            <MudTextField T="string"
                          Label="Bio"
                          Lines="5"
                          Variant="Variant.Outlined"
                          @bind-Value="_user.Biography"/>

            <!-- Email + birthdate -->
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Email"
                                  ReadOnly
                                  Value="@_user.Email"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_user.EmailConfirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTooltip Text="Cannot edit birth date">
                        <MudTextField T="string" Label="Birth date"
                                      Disabled="true"
                                      Value="@_user.BirthDate?.ToString("dd MMM yyyy")"/>
                    </MudTooltip>
                </MudItem>
            </MudGrid>

            <!-- Password -->
            <MudDivider/>
            <MudText Typo="Typo.h6">Change Password</MudText>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="New password" InputType="InputType.Password" @bind-Value="_newPassword"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Confirm password" InputType="InputType.Password" @bind-Value="_confirmPassword"/>
                </MudItem>
            </MudGrid>

            <!-- Preferences -->
            <MudDivider/>
            <MudText Typo="Typo.h6">Preferences</MudText>

            <MudStack Row Spacing="4" Wrap="Wrap.Wrap">
                <MudSwitch @bind-Value="_user.PrefDarkMode" Color="Color.Primary"
                           Label="Dark Mode"
                           ThumbIcon="@Icons.Material.Filled.DarkMode"/>
                <MudSwitch @bind-Value="_user.PrefSimpleGenre" Color="Color.Secondary"
                           Label="Simple Album Genre Display"/>
                <MudSwitch @bind-Value="_user.PrefShowRatings" Color="Color.Tertiary"
                           Label="Show Ratings"/>
                <MudSwitch @bind-Value="_user.PrefAutoFollow" Color="Color.Warning"
                           Label="Auto-follow artists with a good rating"
                           ThumbIcon="@Icons.Material.Filled.AutoAwesome"/>
            </MudStack>
            <MudText Typo="Typo.caption" Class="color-secondary">
                When enabled, rating an album above @(RatingHelper.GetRatingFormatted(7000m, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)) automatically follows its artist.
            </MudText>
            
            <MudDivider/>
            
            <!-- Language -->
            <MudText Typo="Typo.h6">Language</MudText>
            <MudSelect T="string"
                       Label="Preferred language"
                       Variant="Variant.Outlined"
                       @bind-Value="_user.PrefLanguage">
                @foreach (var language in Languages)
                {
                    <MudSelectItem Value="@language.Code">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <Flag CountryName="@language.CountryName" />
                            <MudText>@language.Label</MudText>
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>

            <!-- Rating mode -->
            <MudDivider/>
            <MudText Typo="Typo.h6">Rating Display Mode</MudText>

            <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.Center" Spacing="2" Class="rating-mode-group">
                @foreach (var mode in RatingModes)
                {
                    <MudButton Variant="@(_user.PrefRatingMode == mode.Item1 ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Secondary"
                               StartIcon="@mode.Item2"
                               Style="min-width: 180px"
                               OnClick="@(() => SetRatingMode(mode.Item1))">
                        @mode.Item1.ToDescriptionString()
                    </MudButton>
                }
            </MudStack>

            <!-- Connected accounts -->
            <MudDivider/>
            <MudStack Row Spacing="4">
                @if (_user.GoogleId is null)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Error">
                        Connect Google
                    </MudButton>
                }

                @if (_user.LastFmUsername is null)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.MusicNote"
                               Color="Color.Warning">
                        Connect LastFM
                    </MudButton>
                }
            </MudStack>

            <MudText Typo="Typo.caption" Class="color-secondary">
                Account created on @_user.CreatedAt.ToString("ddd dd MMM yyyy 'at' HH:mm:ss", CultureInfo.InvariantCulture)
            </MudText>

            <MudDivider/>

            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Save">
                Save Changes
            </MudButton>
        }
    </MudStack>
</MudContainer>

<style>
    .rating-mode-group .mud-button-root {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    
    .rating-mode-group .mud-button-root:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
</style>