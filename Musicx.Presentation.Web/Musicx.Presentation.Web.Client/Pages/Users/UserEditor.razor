@page "/User/Edit"
@using System.Globalization
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Shared.Interfaces.Localization
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Application.Shared.Interfaces.UseCases.Security
@using Musicx.Application.Shared.Interfaces.UseCases.User.Avatar
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Components.Fields
@using Musicx.Presentation.Web.Client.Helpers

@inject IUserClientContext UserClientContext
@inject IApiClient Api
@inject HttpClient Http
@inject IAuthUserSavePasswordService UcSavePassword
@inject ISaveAvatarService UcSaveAvatar
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ITranslationService T
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 bg-main pa-6 user-editor-shell">
    <MudStack Spacing="4">
        <PanelTitle Text="@T["Web.UserEditor.Title"]" />

        @if (_user is null)
        {
            <MudAlert Severity="Severity.Warning">
                @T["Web.UserEditor.SignInRequired"]
            </MudAlert>
        }
        else
        {
            <MudTabs Rounded="true" TabPanelsClass="pa-4" Elevation="1">
                <MudTabPanel Text="@T["Web.UserEditor.TabProfile"]" Icon="@Icons.Material.Filled.Person">
                    <MudStack Spacing="4">
                        <MudPaper Class="pa-4 user-profile-header" Elevation="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                                <MudAvatar Size="Size.Large" Class="user-profile-avatar">
                                    <MudImage Src="@_user.PictureUrl" />
                                </MudAvatar>

                                <MudStack Spacing="1" Class="flex-grow-1">
                                    <MudLink Href="@($"/User/{_user.Id}")" Underline="Underline.Hover" Typo="Typo.h4" Class="text-bold">
                                        @_user.Name
                                    </MudLink>
                                    <MudText Typo="Typo.body2" Class="color-secondary">
                                        @_user.Email
                                    </MudText>
                                </MudStack>

                                <MudFileUpload T="IBrowserFile" OnFilesChanged="OnAvatarSelected">
                                    <CustomContent>
                                        <MudFab Color="Color.Primary"
                                                Size="Size.Small"
                                                OnClick="@context.OpenFilePickerAsync"
                                                StartIcon="@Icons.Material.Filled.Image"
                                                Label="@T["Web.UserEditor.UploadAvatar"]" />
                                    </CustomContent>
                                </MudFileUpload>
                            </MudStack>
                        </MudPaper>

                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string"
                                              Label="@T["Web.UserEditor.Username"]"
                                              Variant="Variant.Outlined"
                                              @bind-Value="_user.Name" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="string"
                                                 Label="@T["Web.UserEditor.CountryOrigin"]"
                                                 Placeholder="@T["Web.UserEditor.CountrySearchPlaceholder"]"
                                                 SearchFunc="@SearchCountry"
                                                 Variant="Variant.Outlined"
                                                 @bind-Value="_user.OriginCountry" />
                            </MudItem>
                        </MudGrid>

                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" Label="@T["Web.UserEditor.Email"]"
                                              ReadOnly
                                              Value="@_user.Email"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_user.EmailConfirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudTooltip Text="@T["Web.UserEditor.BirthDateLocked"]">
                                    <MudTextField T="string" Label="@T["Web.UserEditor.BirthDate"]"
                                                  Disabled="true"
                                                  Variant="Variant.Outlined"
                                                  Value="@_user.BirthDate?.ToString("dd MMM yyyy")" />
                                </MudTooltip>
                            </MudItem>
                        </MudGrid>
                        
                        <MudDivider Class="my-3" />

                        <MarkdownEditor Label="@T["Web.UserEditor.Bio"]"
                                        Lines="7"
                                        Value="@_user.Biography"
                                        ValueChanged="@(value => _user.Biography = value)" />

                        <MudPaper Class="pa-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Preview</MudText>
                            <div class="markdown-body">@MarkdownRenderer.Render(_user.Biography)</div>
                        </MudPaper>

                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Save" StartIcon="@Icons.Material.Filled.Save">
                            @T["Web.UserEditor.SaveProfile"]
                        </MudButton>

                        <MudDivider Class="my-3" />

                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">@T["Web.UserEditor.ChangePassword"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="@T["Web.UserEditor.NewPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" @bind-Value="_newPassword" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" Label="@T["Web.UserEditor.ConfirmPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" @bind-Value="_confirmPassword" />
                                </MudItem>
                            </MudGrid>
                            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="@SavePassword">
                                @T["Web.UserEditor.SavePassword"]
                            </MudButton>
                        </MudStack>
                        
                        <MudDivider />
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Wrap="Wrap.Wrap">
                            <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="@SignOut">
                                @T["Web.UserEditor.SignOut"]
                            </MudButton>
                            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="@DeleteAccount">
                                @T["Web.UserEditor.DeleteAccount"]
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="@T["Web.UserEditor.TabSettings"]" Icon="@Icons.Material.Filled.Tune">
                    <MudGrid Class="settings-grid">
                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-2 settings-nav" Elevation="0">
                                @foreach (var category in SettingsCategories)
                                {
                                    <MudButton FullWidth="true"
                                               Variant="Variant.Text"
                                               Class="@GetCategoryButtonClass(category)"
                                               OnClick="@(() => ScrollToSettingsCategory(category))">
                                        @GetCategoryLabel(category)
                                    </MudButton>
                                }
                                
                                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@Save" StartIcon="@Icons.Material.Filled.Save" Class="mt-3">
                                    @T["Web.UserEditor.SaveSettings"]
                                </MudButton>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="9">
                            <MudPaper Class="pa-4 settings-content" Elevation="0">
                                <section id="display" class="settings-section">
                                    <MudText Typo="Typo.h6">@T["Web.UserEditor.Display"]</MudText>
                                    <MudDivider Class="my-2" />
                                    <MudStack Spacing="2">
                                        <MudSwitchM3 @bind-Value="_user.PrefDarkMode" Color="Color.Secondary" 
                                                     Label="@T["Web.UserEditor.DarkMode"]" ThumbIcon="@Icons.Material.Filled.DarkMode"
                                                     ThumbOffIcon="@Icons.Material.Filled.LightMode" />
                                        
                                        <MudSwitchM3 @bind-Value="_user.PrefSimpleGenre" Color="Color.Secondary" 
                                                     Label="@T["Web.UserEditor.SimpleGenreDisplay"]" />
                                        
                                        <MudSwitchM3 @bind-Value="_user.PrefHighGraphics" Color="Color.Secondary" 
                                                     Label="@T["Web.UserEditor.HighGraphics"]" />
                                    </MudStack>
                                </section>

                                <section id="ratings" class="settings-section">
                                    <MudText Typo="Typo.h6">@T["Web.UserEditor.Ratings"]</MudText>
                                    <MudDivider Class="my-2" />
                                    <MudStack Spacing="2">
                                        <MudSwitchM3 @bind-Value="_user.PrefShowRatings" Color="Color.Secondary" 
                                                   Label="@T["Web.UserEditor.ShowRatings"]" ThumbIcon="@Icons.Material.Filled.Check" />
                                        
                                        <MudSwitchM3 @bind-Value="_user.PrefAutoFollow" Color="Color.Secondary" 
                                                   Label="@T["Web.UserEditor.AutoFollow"]" ThumbIcon="@Icons.Material.Filled.AutoAwesome" />
                                        
                                        <MudSwitchM3 @bind-Value="_user.PrefAutoComputeAdvancedRatings" Color="Color.Secondary" 
                                                   Label="@T["Web.UserEditor.AutoComputeAdvancedRatings"]" ThumbIcon="@Icons.Material.Filled.AutoAwesome" />

                                        <MudText Typo="Typo.subtitle1" Class="mt-3">@T["Web.UserEditor.RatingMode"]</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" Spacing="2" Class="rating-mode-group">
                                            @foreach (var mode in RatingModes)
                                            {
                                                <MudButton Variant="@(_user.PrefRatingMode == mode.Item1 ? Variant.Filled : Variant.Outlined)"
                                                           Color="Color.Secondary"
                                                           StartIcon="@mode.Item2"
                                                           Style="min-width: 180px"
                                                           OnClick="@(() => SetRatingMode(mode.Item1))">
                                                    @mode.Item1.ToDescriptionString()
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudStack>
                                </section>

                                <section id="language" class="settings-section">
                                    <MudText Typo="Typo.h6">@T["Web.UserEditor.Language"]</MudText>
                                    <MudDivider Class="my-2" />
                                    <MudSelect T="string"
                                               Label="@T["Web.UserEditor.PreferredLanguage"]"
                                               Variant="Variant.Outlined"
                                               @bind-Value="_user.PrefLanguage">
                                        @foreach (var language in Languages)
                                        {
                                            <MudSelectItem Value="@language.Code">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <Flag CountryName="@language.CountryName" />
                                                    <MudText>@language.Label</MudText>
                                                </MudStack>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </section>

                                <section id="connections" class="settings-section">
                                    <MudText Typo="Typo.h6">@T["Web.UserEditor.Connections"]</MudText>
                                    <MudDivider Class="my-2" />
                                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                        @if (_user.GoogleId is null)
                                        {
                                            <MudButton StartIcon="@Icons.Material.Filled.AccountCircle" Color="Color.Error">
                                                @T["Web.UserEditor.ConnectGoogle"]
                                            </MudButton>
                                        }

                                        @if (_user.LastFmUsername is null)
                                        {
                                            <MudButton StartIcon="@Icons.Material.Filled.MusicNote" Color="Color.Warning">
                                                @T["Web.UserEditor.ConnectLastFm"]
                                            </MudButton>
                                        }
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Class="color-secondary mt-2">
                                        @T.Get("Web.UserEditor.CreatedAt", _user.CreatedAt.ToString("ddd dd MMM yyyy 'at' HH:mm:ss", CultureInfo.InvariantCulture))
                                    </MudText>
                                </section>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        }
    </MudStack>
</MudContainer>

<style>
    .user-editor-shell {
        border-radius: 16px;
    }

    .user-profile-header {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
    }

    .user-profile-avatar {
        width: 112px;
        height: 112px;
    }

    .settings-grid {
        min-height: 62vh;
    }

    .settings-nav {
        position: sticky;
        top: 88px;
        align-self: flex-start;
        height: fit-content;
        max-height: calc(100vh - 200px);
        overflow-y: auto;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .settings-nav-button {
        justify-content: flex-start;
        text-transform: none;
        font-weight: 500;
    }

    .settings-nav-button.is-active {
        font-weight: 800;
    }

    .settings-content {
        overflow-y: auto;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .settings-section {
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .settings-section:last-child {
        margin-bottom: 0;
        border-bottom: none;
    }

    .rating-mode-group .mud-button-root {
        transition: transform var(--mx-motion-fast, 0.15s) var(--mx-ease-standard, ease), box-shadow var(--mx-motion-fast, 0.15s) var(--mx-ease-standard, ease);
    }

    .rating-mode-group .mud-button-root:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    }
</style>