@page "/Album/{id}"
@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.Ratings
@using Musicx.Presentation.Web.Client.Components.Songs
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Components.Genres

@inject IGetUseCase<OutAlbum> UcGet
@inject IGetAlbumByArtistUseCase UcGetArtistAlbums
@inject IGetSongByAlbumUseCase UcGetSongs
@inject IGetAlbumAttributesByAlbum UcGetAlbumAttrs
@inject ISaveUseCase<InUserAlbumAttribute> UcSaveUserAttrib
@inject ILoggerFactory LoggerProvider
@inject IUserClientContext UserClientContext

@if (null == _album)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        
        <!-- Alerts -->
        
        @if (_album.IsFarRight)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                This release is marked with the "national socialist" tag.<br/>
                We do not endorse or support any of the associated ideologies.<br/>
                Our role is solely to document and archive all forms of musical expression,
                regardless of their origin or context.
            </MudAlert>
        }
        
        <div class="album-hero" style="--album-url: url('@_album.ArtworkUrl');">
            <style>
                .album-hero::before {
                    background-image: url('@_album.ArtworkUrl');
                }
            </style>
            
            <div class="album-hero-content">
                <div class="album-hero-image glass-paper">
                    <div class="cursor-pointer pa-3" 
                         style="position: relative; width: 100%;"
                         @onclick="() => _isArtworkRevealed = !_isArtworkRevealed">
                        <MudImage Src="@_album.ArtworkUrl"
                                  Elevation="8"
                                  Class="@($"rounded-lg {(_album.IsExplicitContent && !_isArtworkRevealed ? "blurred" : "")}")"
                                  ObjectFit="ObjectFit.Cover"
                                  Style="width: 100%; aspect-ratio: 1 / 1;" />

                        @if (_album.IsExplicitContent && !_isArtworkRevealed)
                        {
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
                                        background: rgba(0, 0, 0, 0.3); padding: 10px; border-radius: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" />
                                <span class="mt-2 text-sm font-semibold">Sensitive content</span>
                            </div>
                        }
                    </div>
                    
                    @if (_previousAlbum is not null || _nextAlbum is not null)
                    {
                        <MudCardActions Class="justify-between">
                            <MudStack Class="ma-2 pa-1 rounded bg-gray d-flex flex-column flex-md-row" 
                                      Style="width: 100%;">
                                @if (_previousAlbum is not null)
                                {
                                    <MudLink Href="@("/Album/" + _previousAlbum.Id)">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowLeft" />
                                            <MudImage Src="@_previousAlbum.ArtworkUrl"
                                                      Elevation="4"
                                                      Class="rounded"
                                                      Width="24"
                                                      Height="24"/>
                                            <MudText Typo="Typo.caption" Class="neighbor-album-text mr-1">
                                                @_previousAlbum.Name
                                            </MudText>
                                        </MudStack>
                                    </MudLink>
                                }
                                
                                <MudSpacer/>
                                
                                @if (_nextAlbum is not null)
                                {
                                    <MudLink Href="@("/Album/" + _nextAlbum.Id)">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                            <MudImage Src="@_nextAlbum.ArtworkUrl"
                                                      Elevation="4"
                                                      Class="rounded"
                                                      Width="24"
                                                      Height="24"/>
                                            <MudText Typo="Typo.caption" Class="neighbor-album-text ml-1">
                                                @_nextAlbum.Name
                                            </MudText>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowRight" />
                                        </MudStack>
                                    </MudLink>
                                }
                            </MudStack>
                        </MudCardActions>
                    }
                </div>
                
                <div class="glass-paper">
                    <MudTooltip Inline="false" Text="@_album.Name" Delay="500">
                        <ChildContent>
                            <h1 class="album-title animate-text clamped-text-2">
                                @_album.Name
                            </h1>
                        </ChildContent>
                    </MudTooltip>

                    @if (_album.EnglishName is not null)
                    {
                        <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-muted">
                            [@_album.EnglishName]
                        </MudText>
                    }

                    @if (_album.Artist is not null)
                    {
                        <MudLink Typo="Typo.h6" Class="ml-8 montserrat text-italic text-color-secondary"
                                 Href="@($"/Artist/{_album.Artist.Id}")">
                            @if (_album.ArtistAlias is not null)
                            {
                                @_album.ArtistAlias
                            }
                            else
                            {
                                @_album.Artist.Name
                            }
                        </MudLink>
                    }

                    <MudDivider Class="my-2"/>

                    <GenreDetails Album="@_album" @bind-DetailedView="@_showDetailedView"/>
                    <MudSwitch @bind-Value="_showDetailedView"
                               Color="Color.Primary"
                               Label="Show more details"
                               ThumbIcon="@Icons.Material.Filled.ViewWeek"
                               Class="my-2"/>

                    <MudDivider Class="my-2"/>

                    <MudStack Spacing="1" AlignItems="AlignItems.Center"
                              Class="mt-4" Wrap="Wrap.Wrap"
                              Justify="Justify.SpaceEvenly" Row>
                        @if (UserClientContext.Can("album.edit"))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Class="mx-1"
                                       OnClick="@EditAlbumShowModal">
                                Edit Album Info
                            </MudButton>
                        }

                        @if (UserClientContext.CurrentUser is not null &&
                             UserClientContext.Can("album.review"))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       Class="mx-1">
                                Review
                            </MudButton>
                        }

                        @if (UserClientContext.CurrentUser is not null &&
                             UserClientContext.Can("album.rate"))
                        {
                            <EditableRatingBadge
                                Editable
                                Size="Size.Large"
                                RatingMode="@UserClientContext.CurrentUser.PrefRatingMode"
                                Value="@_userAttribute.Rating"
                                ValueChanged="@(v => Rate(v))"/>
                        }

                        @if (UserClientContext.CurrentUser is not null &&
                             UserClientContext.Can("album.attr"))
                        {
                            <!-- <MudDatePicker 
                                DateChanged="ChangeDateDiscovery"
                                Label="Discovery Date"
                                T="DateTime?"
                                Class="mx-1"
                                Style="width: 160px;"
                                Variant="Variant.Outlined"/> -->

                            <MudMenu Label="Collection"
                                     Variant="Variant.Filled"
                                     Dense
                                     Size="Size.Small"
                                     Class="mx-1"
                                     Color="Color.Primary">
                                @foreach (var collectionType in Enum.GetValues<CollectionType>())
                                {
                                    <MudMenuItem>@collectionType.ToDescriptionString()</MudMenuItem>
                                }
                            </MudMenu>

                            <MudExpansionPanels Dense
                                                Class="d-inline-block mx-1 rounded-lg"
                                                Elevation="2">
                                <MudExpansionPanel Text="Tags" Gutters="false" Class="p-2">
                                    <MudTextField T="string"
                                                  Placeholder="Add a tag..."
                                                  Variant="Variant.Outlined"
                                                  Class="flex-grow-1"/>
                                    <MudButton Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Size="Size.Small">
                                        Add
                                    </MudButton>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    </MudStack>
                </div>
                
                <div style="width: 100%" class="pa-2">
                    <div style="justify-items: center">
                        <DonutRating
                            Rating="@_album.Stats?.Average"
                            RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                            Size="DonutRatingSize.Medium"/>

                        <MudText Typo="Typo.body2" Class="montserrat text-color-primary text-bold mt-2">
                            @(_album.Stats?.Count ?? 0) ratings
                        </MudText>
                    </div>
                    
                    <MudDivider Class="my-2" />

                    @if (null != _album.OriginalReleaseDate)
                    {
                        <MudText Class="text-color-secondary mt-2">
                            📅 Release Date:&nbsp;

                            <MudText Inline Class="text-color-primary text-mega-bold montserrat">
                                @_album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")
                            </MudText>
                        </MudText>
                    }

                    <MudText Class="text-color-secondary mt-2">
                        🎛️ Recording Dates:&nbsp;

                        <MudText Inline Class="text-color-primary text-mega-bold montserrat">
                            @(_album.BeginRecordDate?.ToString("dd/MM/yyyy") ?? "?")
                            &nbsp;->&nbsp;
                            @(_album.EndRecordDate?.ToString("dd/MM/yyyy") ?? "?")
                        </MudText>
                    </MudText>

                    <MudText Class="text-color-secondary mt-2">
                        💿 Release Type:&nbsp;

                        <MudText Inline Class="text-color-primary text-mega-bold montserrat">
                            @(_album.ReleaseType?.ToDescriptionString() ?? "-")
                        </MudText>
                    </MudText>
                </div>
            </div>
        </div>
        
        <MudGrid>
            <MudItem xs="12" md="5">
                <!-- Track List -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">🎵 Track List</MudText>
                    <MudDivider Class="my-3" />
                    <MudTable ReadOnly
                              Items="@_albumSongs"
                              Elevation="8"
                              CustomHeader="@true" CustomFooter="@true"
                              Class="my-3" Style="width: 100%"
                              Dense>
                        <HeaderContent>
                            <MudTHeadRow>
                                <MudTh>#</MudTh>
                                <MudTh>Title</MudTh>
                                <MudTh>Duration</MudTh>
                            </MudTHeadRow>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd Style="width: 40px;" DataLabel="#">
                                @if (_album.DiscTotal is null || _album.DiscTotal < 2)
                                {
                                    @context.TrackNumber
                                }
                                else
                                {
                                    @($"{context.DiscNumber}.{context.TrackNumber}")
                                }
                            </MudTd>
                            <MudTd DataLabel="Title">
                                <SongTitleStylized Song="@context"/>
                            </MudTd>
                            <MudTd DataLabel="Duration" Style="width: 80px;">@context.Duration.FormatDuration()</MudTd>
                        </RowTemplate>

                        <FooterContent>
                            <MudTFootRow>
                                <MudTd colspan="3">
                                    Total Duration: @_album.TotalDuration.FormatDuration()
                                </MudTd>
                            </MudTFootRow>
                        </FooterContent>
                    </MudTable>
                    
                    @if (UserClientContext.Can("album.edit"))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@EditTrackListShowModal" StartIcon="@Icons.Material.Filled.Edit">
                            Edit Tracklist
                        </MudButton>
                    }
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <!-- Credit -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">📒 Credits</MudText>
            
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">💽 Releases</MudText>
                    <MudDivider Class="my-3"/>
                    
                    <!-- Issues -->
                        <MudList T="string">
                            @if (_album.Releases is not null)
                            {
                                foreach (var release in _album.Releases)
                                {
                                    <MudListItem>@release.Label?.Name - @release.CatalogNumber</MudListItem>
                                }
                            }
                        </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <!-- Reviews -->
        <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
            <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">📝 User Reviews</MudText>
            <MudDivider Class="my-3" />
            
            <MudList T="RenderFragment">
                <MudListItem>
                    <MudText Class="text-bold">User123</MudText>
                    <MudText Typo="Typo.caption" Class="text-color-disabled">01/01/2023</MudText>
                    <MudText Typo="Typo.body2">Contenu de la review…</MudText>
                </MudListItem>
            </MudList>
            
            <MudDivider Class="my-2" />
            
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="pa-3">
                <MudText Typo="Typo.h6" Class="text-extra-bold">Staff Review</MudText>
                <MudText Typo="Typo.caption" Class="text-color-disabled">Staff · 02/01/2023</MudText>
                <MudText Typo="Typo.body1">Critique officielle mise en valeur…</MudText>
            </MudAlert>
        </MudPaper>
        
        <MudGrid>
            <MudItem xs="12" md="4">
                <!-- Suggestions -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">
                        🔗 Similar Releases
                    </MudText>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="8">
                <!-- Ratings et collections -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">🖍️ User Ratings & Collections</MudText>
                    <MudDivider Class="my-3" />
            
                    <MudTable @ref="_albumRatingsTable"
                              Striped Bordered="false"
                              ServerData="@LoadUserAttrData"
                              Dense
                              Breakpoint="Breakpoint.Sm">
                        <ColGroup>
                            <col />
                            <col style="width: 100px;" />
                            <col style="width: 100px" />
                            <col style="width: 100px" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.User.Name))">
                                    Name
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.UpdatedAt))">
                                    Date
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.CollectionType ?? 0))">
                                    Collection
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Rating ?? 0))">
                                    Rating
                                </MudTableSortLabel>
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">
                                <MudLink Href="@($"/User/{context.User.Id}")">
                                    <MudText Typo="Typo.body1" Class="text-mega-bold montserrat" Color="Color.Primary">
                                        @context.User.Name
                                    </MudText>
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Date">
                                <MudText Typo="Typo.caption" Class="text-color-secondary text-italic">
                                    @context.UpdatedAt.ToString("dd/MM/yyyy")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Collection">
                                @(context.CollectionType.ToString() ?? string.Empty)
                            </MudTd>
                            <MudTd DataLabel="Rating">
                                <MudChip T="string"
                                         Class="text-bold"
                                         Style="@($"background-color: {RatingHelper.GetColorForRating(context.Rating)};" +
                                                $"color: white")">
                                    @RatingHelper.GetRatingFormatted(context.Rating, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTablePager />
                        </FooterContent>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <!-- Zone anecdotes -->
        <!--
        <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
            <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">Additional Info</MudText>
            <MudDivider Class="my-3" />
            
            <MudText Typo="Typo.body2" Class="text-italic">Some fun facts...</MudText>
        </MudPaper> -->
                
        <!-- Tileset Artist Disco -->
        <MudExpansionPanels Class="mt-4">
            <MudExpansionPanel Text="Artist Discography">
                
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudContainer>
}

<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />
<AlbumTrackListEditModal @ref="_trackListEditModal" OnSave="OnQuitModal" />

<style>
    .blurred {
        filter: blur(10px);
    }

    .neighbor-album-text {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>