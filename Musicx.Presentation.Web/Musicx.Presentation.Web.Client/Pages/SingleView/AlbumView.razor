@page "/Album/{id}"

@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Components.GenreDetails

@inject IGetUseCase<OutAlbum> UcGet
@inject IGetAlbumByArtistUseCase UcGetArtistAlbums
@inject IGetSongByAlbumUseCase UcGetSongs
@inject ILoggerFactory LoggerProvider

<MudBreadcrumbs Items="@_breadcrumb" />

@if (null == _album)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudCard Elevation="6" Class="animate-hover-up">
        <MudCardHeader Class="pa-8" Style="background-color: var(--mud-palette-background-gray);">
            <MudStack>
                <MudText Typo="Typo.h2" Class="montserrat" Style="font-weight: 800">@_album.Name</MudText>
                @if (_album.Artist is not null)
                {
                    <MudLink Typo="Typo.h6" Class="ml-8" Href="@($"/Artist/{_album.Artist.Id}")">
                        @_album.Artist.Name
                    </MudLink>
                }
            </MudStack>
        </MudCardHeader>
        <MudCardContent>
            @if (_album.IsFarRight)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    This release is marked with the "national socialist" tag.<br/>
                    We do not endorse or support any of the associated ideologies.<br/>
                    Our role is solely to document and archive all forms of musical expression,
                    regardless of their origin or context.
                </MudAlert>
            }
            
            <MudGrid>
                <MudItem xs="12" md="3" Class="pa-6">
                    <div class="relative cursor-pointer" @onclick="() => _isArtworkRevealed = !_isArtworkRevealed">
                        <MudImage Src="@_album.ArtworkUrl"
                                  Elevation="8"
                                  Class="@($"rounded-lg animate-hover-up {(_album.IsNsfw && !_isArtworkRevealed ? "blurred" : "")}")"
                                  Style="width: 100%; height: auto;" />

                        @if (_album.IsNsfw && !_isArtworkRevealed)
                        {
                            <div class="inset-0 flex flex-col items-center justify-center bg-black bg-opacity-50 text-white rounded-lg"
                                 style="position: absolute;">
                                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" />
                                <span class="mt-2 text-sm font-semibold">Sensitive content</span>
                            </div>
                        }
                    </div>
                    
                    <MudStack Row Class="mt-3">
                        @if (_previousAlbum is not null)
                        {
                            <MudLink Href="@("/Album/" + _previousAlbum.Id)">
                                <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowLeft" />
                                    <MudImage Src="@_previousAlbum.ArtworkUrl"
                                              Elevation="4"
                                              Class="rounded"
                                              Width="24"
                                              Height="24"/>
                                    <MudText Typo="Typo.caption" Class="neighbor-album-text mr-1">
                                        @_previousAlbum.Name
                                    </MudText>
                                </MudStack>
                            </MudLink>
                        }
                        
                        <MudSpacer/>
                        
                        @if (_nextAlbum is not null)
                        {
                            <MudLink Href="@("/Album/" + _nextAlbum.Id)">
                                <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                    <MudImage Src="@_nextAlbum.ArtworkUrl"
                                              Elevation="4"
                                              Class="rounded"
                                              Width="24"
                                              Height="24"/>
                                    <MudText Typo="Typo.caption" Class="neighbor-album-text ml-1">
                                        @_nextAlbum.Name
                                    </MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowRight" />
                                </MudStack>
                            </MudLink>
                        }
                    </MudStack>
                </MudItem>
                
                <MudItem xs="12" md="9" Class="pa-6">
                    <MudCard Elevation="8" Class="rounded-lg">
                        <MudCardHeader>
                            <MudText Typo="Typo.h5" Class="montserrat ml-3">Details</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudList Dense T="RenderFragment">
                                @if (null != _album.OriginalReleaseDate)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Release Date
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            @_album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                                
                                @if (null != _album.ReleaseType)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Release Type
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            @_album.ReleaseType.Value.ToString()
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                                
                                @if (null != _album.BeginRecordDate && null != _album.EndRecordDate)
                                {
                                    <Descriptor>
                                        <DescriptorLabel>
                                            Recording Dates
                                        </DescriptorLabel>
                                        <DescriptorValue>
                                            
                                        </DescriptorValue>
                                    </Descriptor>
                                }
                                
                                <MudDivider Class="my-5" />
                                
                                <GenreDetails Album="@_album" @bind-DetailedView="@_showDetailedView" />
                            </MudList>
                            
                            <MudSwitch @bind-Value="_showDetailedView"
                                       Color="Color.Primary"
                                       Label="Show more details"
                                       ThumbIcon="@Icons.Material.Filled.ViewWeek"
                                       Class="my-2" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled" 
                                       StartIcon="@Icons.Material.Filled.EditNote"
                                       Class="mx-2"
                                       Color="Color.Success"
                                       OnClick="@EditTrackListShowModal">
                                Edit Track List
                            </MudButton>
                    
                            <MudIconButton Variant="Variant.Filled" 
                                           Icon="@Icons.Material.Filled.Edit"
                                           Class="mx-2"
                                           Color="Color.Secondary"
                                           OnClick="@EditAlbumShowModal" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem Class="pa-6" xs="12" md="3">
                    <MudTable Items="@_albumSongs" ReadOnly
                              Style="width: 100%" Dense>
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Title</MudTh>
                            <MudTh>Duration</MudTh>
                        </HeaderContent>
                        
                        <RowTemplate>
                            <MudTd Style="max-width: 80px;" DataLabel="#">@context.TrackNumber</MudTd>
                            <MudTd DataLabel="Title">@context.Title</MudTd>
                            <MudTd DataLabel="Duration">@context.Duration.FormatDuration()</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />
<AlbumTrackListEditModal @ref="_trackListEditModal" OnSave="OnQuitModal" />

<style>
    .blurred {
        filter: blur(10px);
    }

    .neighbor-album-text {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>