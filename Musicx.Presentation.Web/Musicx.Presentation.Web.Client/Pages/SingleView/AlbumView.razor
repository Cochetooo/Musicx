    .blurred {
        filter: blur(15px);
    }

    .rating-expand-hint {
        opacity: .8;
        animation: mx-bounce 1.3s infinite;
    }

    .wiki-button {
        background: #fff !important;
        color: #111 !important;
        border: 1px solid #000 !important;
    }

    .mud-theme-dark .wiki-button {
        background: #111 !important;
        color: #fff !important;
        border: 1px solid #fff !important;
    }

    .neighbor-album-text {
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .tracklist-table {
        background: transparent;
    }

    .tracklist-table .track-no {
        font-weight: 600;
    }

    .tracklist-table .track-title {
        font-size: 1rem;
    }

    .tracklist-table .track-duration {
        font-size: .85rem;
        color: var(--mud-palette-text-secondary);
    }
</style>