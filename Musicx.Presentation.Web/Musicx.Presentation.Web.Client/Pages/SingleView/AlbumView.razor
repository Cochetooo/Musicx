@page "/Album/{id}"
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Shared.Interfaces.Localization
@using Musicx.Application.Shared.Interfaces.UseCases.User.AlbumAttribute
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.User
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Components.Fields
@using Musicx.Presentation.Web.Client.Components.Genres
@using Musicx.Presentation.Web.Client.Components.Ratings
@using Musicx.Presentation.Web.Client.Components.Songs
@using Musicx.Presentation.Web.Client.Helpers
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Modals.Voting

@inject IApiClient Api
@inject IFindAlbumAttributesByAlbumService UcFindAlbumAttrs
@inject IFindAlbumAttributesByAlbumUserService UcFindUserServiceAlbumAttr
@inject ILoggerFactory LoggerProvider
@inject IUserClientContext UserClientContext
@inject ISnackbar Snackbar
@inject ITranslationService T

@if (null == _album)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        
        <!-- Alerts -->
        
        @if (_album.IsFarRight)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                This release is marked with the "national socialist" tag.<br/>
                We do not endorse or support any of the associated ideologies.<br/>
                Our role is solely to document and archive all forms of musical expression,
                regardless of their origin or context.
            </MudAlert>
        }
        
        <div class="album-hero" style="--hero-url: url('@_album.ArtworkUrl');">
            <div class="album-hero-content">
                <div>
                    <div class="cursor-pointer album-hero-image pa-2"
                         style="position: relative; width: 100%;"
                         @onclick="() => _isArtworkRevealed = !_isArtworkRevealed">
                        <MudImage Src="@_album.ArtworkUrl"
                                  @key="_album.ArtworkUrl"
                                  Elevation="8"
                                  Class="@($"rounded-lg {((_album.IsExplicitContent || _album.IsGraphicContent) && !_isArtworkRevealed ? "blurred" : "")}")"
                                  ObjectFit="ObjectFit.Cover"
                                  Style="width: 100%; aspect-ratio: 1 / 1;" />

                        @if ((_album.IsExplicitContent || _album.IsGraphicContent) && !_isArtworkRevealed)
                        {
                            <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
                                        background: rgba(0, 0, 0, 0.3); padding: 10px; border-radius: 8px;">
                                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" />
                                <span class="mt-2 text-sm font-semibold">Sensitive content</span>
                            </div>
                        }
                    </div>
                    
                    @if (_previousAlbum is not null || _nextAlbum is not null)
                    {
                        <MudCardActions Class="justify-between">
                            <MudStack Class="ma-2 pa-1 rounded glass-paper d-flex flex-column flex-md-row"
                                      Style="width: 100%;">
                                @if (_previousAlbum is not null)
                                {
                                    <MudLink Href="@("/Album/" + _previousAlbum.Id)">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowLeft" />
                                            <MudImage Src="@_previousAlbum.ArtworkUrl"
                                                      @key="_previousAlbum.ArtworkUrl"
                                                      Elevation="4"
                                                      Class="rounded"
                                                      Width="24"
                                                      Height="24"/>
                                            <MudText Typo="Typo.caption" Class="neighbor-album-text mr-1">
                                                @_previousAlbum.Name
                                            </MudText>
                                        </MudStack>
                                    </MudLink>
                                }
                                
                                <MudSpacer/>
                                
                                @if (_nextAlbum is not null)
                                {
                                    <MudLink Href="@("/Album/" + _nextAlbum.Id)">
                                        <MudStack AlignItems="AlignItems.Center" Spacing="1" Row>
                                            <MudImage Src="@_nextAlbum.ArtworkUrl"
                                                      @key="_nextAlbum.ArtworkUrl"
                                                      Elevation="4"
                                                      Class="rounded"
                                                      Width="24"
                                                      Height="24"/>
                                            <MudText Typo="Typo.caption" Class="neighbor-album-text ml-1">
                                                @_nextAlbum.Name
                                            </MudText>
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowRight" />
                                        </MudStack>
                                    </MudLink>
                                }
                            </MudStack>
                        </MudCardActions>
                    }
                </div>
                
                <div>
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" 
                              Class="mx-2 mt-2 album-headline-row" Spacing="2">
                        <div>
                            <MudTooltip Inline="false" Text="@_album.Name" Delay="500">
                                <ChildContent>
                                    <h1 class="album-title animate-text clamped-text-2">
                                        @_album.Name
                                    </h1>
                                </ChildContent>
                            </MudTooltip>

                            @if (_album.EnglishName is not null)
                            {
                                <MudText Typo="Typo.h5" Class="montserrat text-bold color-muted">
                                    [@_album.EnglishName]
                                </MudText>
                            }
                                
                            @if (_album.Artist is not null)
                            {
                                <MudLink Typo="Typo.h6" Class="ml-2 montserrat color-secondary text-shadow"
                                         Href="@($"/Artist/{_album.Artist.Id}")">
                                    @if (_album.ArtistAlias is not null)
                                    {
                                        @_album.ArtistAlias
                                    }
                                    else
                                    {
                                        @_album.Artist.Name
                                    }
                                </MudLink>
                            }
                        </div>
            
                        <MudStack Class="album-header-right" AlignItems="AlignItems.End" Justify="Justify.SpaceBetween" Spacing="2">
                            @if (UserClientContext.Can("album.edit"))
                            {
                                <MudMenu Dense Variant="Variant.Text" Color="Color.Inherit"
                                         Class="admin-settings-menu"
                                         Icon="@Icons.Material.Filled.Settings">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@EditAlbumShowModal">@T["Web.AlbumView.EditAlbum"]</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.FormatListNumbered" OnClick="@EditTrackListShowModal">@T["Web.AlbumView.EditTracklist"]</MudMenuItem>
                                </MudMenu>
                            }

                            <MudStack Spacing="0" Class="album-meta-text" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                                @if (_album.OriginalReleaseDate is not null || _album.ReleaseType is not null)
                                {
                                    <MudText Typo="Typo.body2" Align="Align.Right" Class="text-extra-light album-meta-line">
                                        @T["Web.AlbumView.ReleasedOn"]
                                        @if (_album.OriginalReleaseDate is not null)
                                        {
                                            <span class="text-bold album-release-date">&nbsp;@_album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        @if (_album.OriginalReleaseDate is not null && _album.ReleaseType is not null)
                                        {
                                            <span> ⸱ </span>
                                        }
                                        @if (_album.ReleaseType is not null)
                                        {
                                            <span class="text-light">@_album.ReleaseType.ToDescriptionString()</span>
                                        }
                                    </MudText>
                                }

                                @if (_album.BeginRecordDate is not null || _album.EndRecordDate is not null)
                                {
                                    <MudText Typo="Typo.body2" Align="Align.Right" Class="text-extra-light album-meta-line">
                                        @T["Web.AlbumView.Recorded"] 
                                        <span class="album-recorded-dates">
                                            &nbsp;@(_album.BeginRecordDate?.ToString("dd/MM/yyyy") ?? "?") — @(_album.EndRecordDate?.ToString("dd/MM/yyyy") ?? "?")
                                        </span>
                                    </MudText>
                                }

                                @if (_album.Releases?.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.Label?.Name))?.Label?.Name is { } labelName)
                                {
                                    <MudText Typo="Typo.body2" Class="font-italic text-extra-light album-meta-line" Align="Align.Right">
                                        @T["Web.AlbumView.Label"] <span class="album-recorded-dates">@labelName</span>
                                    </MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudStack>
                    
                    <MudDivider Class="my-3"/>
                    
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                        <div class="album-genres-block">
                            @if (!_showDetailedView)
                            {
                                <MudText Typo="Typo.body1" Class="text-light text-italic mb-1">@T["Web.AlbumView.GenresLabel"]</MudText>
                            }
                            
                            <GenreDetails Size="Size.Medium" Descriptor="false" Album="@_album" @bind-DetailedView="@_showDetailedView"/>
                        </div>

                        <MudStack Spacing="2">
                            @if (UserClientContext.CurrentUser is not null)
                            {
                                <MudButton EndIcon="@Icons.Material.Filled.DoneAll"
                                           OnClick="@OpenVoteGenreModal"
                                           Variant="Variant.Filled"
                                           Size="Size.Medium"
                                           Color="Color.Primary">
                                    @T["Web.AlbumView.VoteGenres"]
                                </MudButton>
                            }

                            <MudButton EndIcon="@Icons.Material.Filled.Brush"
                                       OnClick="@(() => _showDetailedView = !_showDetailedView)"
                                       Variant="Variant.Filled"
                                       Size="Size.Medium"
                                       Class="@($"album-side-button {(_showDetailedView ? "is-detailed" : "is-simple")}")"
                                       Color="Color.Surface">
                                @(_showDetailedView ? T["Web.AlbumView.GenreDetailed"] : T["Web.AlbumView.GenreSimple"])
                            </MudButton>
                        </MudStack>
                    </MudStack>
                    
                    <MudDivider Class="my-3" />
                    
                    @if (UserClientContext.CurrentUser is not null && UserClientContext.Can("album.rate"))
                    {
                        if (DateTime.UtcNow >= (_album.OriginalReleaseDate ?? DateTime.MinValue))
                        {
                            <MudStack Justify="Justify.Center">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="0"
                                          Justify="Justify.Center" Class="album-main-rating">
                                    <EditableRatingBadge Editable
                                                         Size="Size.Large"
                                                         RatingMode="@UserClientContext.CurrentUser.PrefRatingMode"
                                                         Value="@_userAttribute.Rating"
                                                         ValueChanged="@(v => Rate(v))" />
                                
                                    <MudTooltip Text="@T["Web.AlbumView.ToggleAdvancedFactors"]">
                                        <MudIconButton Icon="@(_showAdvancedFactorEditor ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       Color="Color.Inherit"
                                                       Size="Size.Medium"
                                                       OnClick="@(() => _showAdvancedFactorEditor = !_showAdvancedFactorEditor)" />
                                    </MudTooltip>
                                </MudStack>
                                <MudText Typo="Typo.caption" Align="Align.Center" Class="color-secondary mb-2">
                                    @T["Web.AlbumView.YourRatingHint"]
                                </MudText>
                            </MudStack>
                        }
                        
                        if (_showAdvancedFactorEditor)
                        {
                            <MudStack Row Justify="Justify.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mx-2 my-3" Style="width: 100%">
                                @foreach (var factor in _albumFactors)
                                {
                                    <MudStack AlignItems="AlignItems.Center">
                                        <EditableRatingBadge Editable
                                                             RatingMode="@UserClientContext.CurrentUser.PrefRatingMode"
                                                             Value="@factor.Getter(_userAttribute)"
                                                             ValueChanged="@(v => OnAlbumFactorChanged(factor, (short?)v))" />
                                        <MudText Typo="Typo.caption" Class="text-light color-secondary">@factor.Label</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                            
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="album-factors-actions mt-2">
                                <MudSpacer />
                                <MudButton Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           Disabled="@(!_hasAnyAlbumFactor)"
                                           OnClick="@ComputeAlbumRatingFromFactors">
                                    @T["Web.AlbumView.ComputeNow"]
                                </MudButton>

                                <MudSpacer />
                                <MudSwitch T="bool"
                                           Class="album-autocompute-switch"
                                           Color="Color.Success"
                                           Value="@_autoComputeAlbumRating"
                                           ValueChanged="@OnAutoComputeAlbumRatingChanged"
                                           Label="@T["Web.AlbumView.AutoComputeShort"]" />
                            </MudStack>
                        }
                        
                        <MudDivider Class="my-3" />
                    }
                    
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" 
                              Wrap="Wrap.Wrap">
                        @if (UserClientContext.CurrentUser is not null && UserClientContext.Can("album.attr"))
                        {
                            <div class="album-action-item">
                                <MudDatePicker Date="@_userAttribute.DiscoveryDate"
                                               DateChanged="ChangeDateDiscovery"
                                               Label="@T["Web.AlbumView.DiscoveryDate"]"
                                               Style="width: 200px;"
                                               Class="album-action-control"
                                               Variant="Variant.Outlined" />
                            </div>

                            <MudMenu Label="@(_userAttribute.CollectionType?.ToDescriptionString() ?? T["Web.AlbumView.Collection"])"
                                     Class="album-action-control"
                                     Variant="Variant.Filled"
                                     Dense
                                     StartIcon="@Icons.Material.Filled.LibraryMusic"
                                     Color="Color.Secondary">
                                @foreach (var collectionType in Enum.GetValues<CollectionType>())
                                {
                                    <MudMenuItem OnClick="@(() => ChangeCollection(collectionType))">
                                        @collectionType.ToDescriptionString()
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        }

                        @if (UserClientContext.CurrentUser is not null && UserClientContext.Can("album.review"))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       Class="album-action-control"
                                       StartIcon="@Icons.Material.Filled.NoteAdd"
                                       OnClick="@(()=>_showReviewEditor = !_showReviewEditor)">
                                @T["Web.AlbumView.WriteReview"]
                            </MudButton>
                        }

                        @if (!string.IsNullOrWhiteSpace(_album.WikipediaUrl))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Dark"
                                       StartIcon="@Icons.Material.Filled.TravelExplore"
                                       Href="@_album.WikipediaUrl"
                                       Target="_blank"
                                       Class="wiki-button album-action-control">
                                @T["Web.AlbumView.SeeOnWikipedia"]
                            </MudButton>
                        }
                    </MudStack>
                    
                    @if (_showReviewEditor && UserClientContext.CurrentUser is not null)
                    {
                        <MudPaper Class="mt-3 pa-3">
                            <MarkdownEditor Label="Review"
                                            Lines="8"
                                            Value="@_userAttribute.Review"
                                            ValueChanged="@(value => _userAttribute.Review = value)" />
                            <MudStack Row Spacing="2" Class="mt-2">
                                <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="@SaveReview">Publish</MudButton>
                                <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="@(()=>_showReviewEditor=false)">Close</MudButton>
                            </MudStack>
                        </MudPaper>
                    }
                </div>
                
                @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                {
                    <div style="width: 100%" class="pa-2">
                        <div class="album-rating-hover-card">
                            <div class="album-rating-hover-summary">
                                <MudText Typo="Typo.h5" Class="montserrat">
                                    🌐 @T["Web.AlbumView.GlobalRatingLabel"]
                                </MudText>
                                
                                <div>
                                    <DonutRating
                                        Rating="@_album.Stats?.Average"
                                        RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode)"
                                        Size="DonutRatingSize.Large"/>
                                </div>

                                <MudText Typo="Typo.subtitle2" Align="Align.Center" 
                                         Class="color-secondary mt-2 album-rating-count">
                                    @(_album.Stats?.Count ?? 0) @T["Web.AlbumView.RatingsSuffix"]
                                </MudText>
                            </div>
                            
                            <MudDivider Class="my-2" />
                            
                            @if (_albumFactorAverages.Count > 0)
                            {
                                <MudGrid Class="my-2" Spacing="1">
                                    @foreach (var factor in _albumFactorAverages.OrderByDescending(x => x.Value))
                                    {
                                        <MudItem xs="12" xl="6">
                                            <MudStack Class="factor-card" Spacing="1">
                                                <MudStack Row Justify="Justify.SpaceBetween">
                                                    <MudText Typo="Typo.caption" Class="text-extra-light">
                                                        @factor.Key
                                                    </MudText>
                                                    <MudText Typo="Typo.body2" Class="text-bold color-primary">
                                                        @RatingHelper.GetRatingFormatted(factor.Value, UserClientContext.CurrentUser?.PrefRatingMode)
                                                    </MudText>
                                                </MudStack>
                                                <MudProgressLinear Value="@(factor.Value / 100.0)"
                                                                   Min="0"
                                                                   Max="100"
                                                                   Rounded
                                                                   Color="Color.Primary"/>
                                            </MudStack>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }

                            <div class="album-rating-hover-details">
                                <div class="album-rating-mini-card album-rating-donut-card">
                                    <MudText Typo="Typo.h6" Class="montserrat">
                                        ⭐ @T["Web.AlbumView.FanRatingLabel"]
                                    </MudText>
                                    
                                    <div>
                                        <DonutRating Rating="@_album.Stats?.FanAverage"
                                                     RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode)"
                                                     Size="DonutRatingSize.Small"/>
                                    </div>
                                    
                                    <MudText Typo="Typo.subtitle2" Align="Align.Center"
                                             Class="color-secondary album-rating-count">
                                        @(_album.Stats?.FanCount ?? 0) @T["Web.AlbumView.RatingsSuffix"]
                                    </MudText>
                                </div>

                                <div class="album-rating-mini-card album-rating-donut-card">
                                    <MudText Typo="Typo.h6" Class="montserrat">👤 @T["Web.AlbumView.NonFanRatingLabel"]</MudText>
                                    
                                    <div>
                                        <DonutRating Rating="@_album.Stats?.NonFanAverage"
                                                     RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode)"
                                                     Size="DonutRatingSize.Small"/>
                                    </div>
                                    
                                    <MudText Typo="Typo.subtitle2" Align="Align.Center"
                                             Class="color-secondary album-rating-count">
                                        @(_album.Stats?.NonFanCount ?? 0) @T["Web.AlbumView.RatingsSuffix"]
                                    </MudText>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="💽 Releases"/>
                    <MudDivider Class="my-3"/>

                    <!-- Issues -->
                    <MudList T="string">
                        @if (_album.Releases is not null)
                        {
                            foreach (var release in _album.Releases)
                            {
                                <MudListItem>@release.Label?.Name - @release.CatalogNumber</MudListItem>
                            }
                        }
                    </MudList>
                </MudPaper>
                
                <!-- Reviews -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="📝 Reviews" Count="@_albumReviews.Count.ToString()"/>
                    <MudDivider Class="my-3"/>

                    @if (_albumReviews.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No review published at the moment.</MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var review in _albumReviews)
                            {
                                <MudPaper Class="pa-3 bg-default" Elevation="4">
                                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudAvatar Size="Size.Medium">
                                                <MudImage Src="@review.User.PictureUrl" Alt="@review.User.Name"/>
                                            </MudAvatar>
                                            <MudText Typo="Typo.h5" Class="text-bold">@review.User.Name</MudText>
                                            @if (review.ReviewSource is not null)
                                            {
                                                <MudChip Size="Size.Small" T="RenderFragment" Style="@($"background:{review.ReviewSource.Color};color:white;")">
                                                    <MudLink Href="@review.ReviewSource.Url" Target="_blank" Class="text-white">@review.ReviewSource.Name</MudLink>
                                                </MudChip>
                                            }
                                        </MudStack>

                                        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.caption" Class="text-color-disabled">
                                                @((review.ReviewPostedAt ?? review.UpdatedAt).ToString("dd/MM/yyyy"))
                                            </MudText>

                                            <DonutRating Rating="@review.Rating"
                                                         RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode)"
                                                         Size="DonutRatingSize.ExtraSmall"/>
                                        </MudStack>
                                    </MudStack>

                                    <MudDivider Class="my-2"/>

                                    <div class="markdown-body mt-2">@MarkdownRenderer.Render(review.Review)</div>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudPaper>

                <!-- Ratings et collections -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="🔢 Ratings"/>
                    <MudDivider Class="my-3"/>

                    <MudTable @ref="_albumRatingsTable"
                              Striped Bordered="false"
                              Dense
                              Elevation="8"
                              ServerData="@LoadUserAttrData"
                              RowStyleFunc="@((item, _) => $"--rating-color:{RatingHelper.GetColorForRating(item.Rating)}")"
                              Breakpoint="Breakpoint.Sm">
                        <ColGroup>
                            <col/>
                            <col style="width: 100%"/>
                            <col style="width: 100px"/>
                            <col style="width: 100px"/>
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Rating ?? 0))">
                                    Rating
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.User.Name))">
                                    Name
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.UpdatedAt))">
                                    Rating Date
                                </MudTableSortLabel>
                            </MudTh>
                            <MudTh>
                                <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.CollectionType ?? 0))">
                                    Collection
                                </MudTableSortLabel>
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Rating" Class="rating-col">
                                <MudText Typo="Typo.h5" Class="color-primary text-bold rating-text"
                                         Style="width: fit-content;">
                                    @RatingHelper.GetRatingFormatted(context.Rating, UserClientContext.CurrentUser?.PrefRatingMode)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Name">
                                <MudLink Href="@($"/User/{context.User.Id}")">
                                    <MudText Typo="Typo.body1" Class="text-bold color-primary">
                                        @context.User.Name
                                    </MudText>
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Date">
                                <MudText Typo="Typo.caption" Class="color-secondary text-italic">
                                    @context.UpdatedAt.ToString("dd/MM/yyyy")
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="Collection">
                                @(context.CollectionType.ToString() ?? string.Empty)
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager/>
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <!-- Track List -->
                <MudPaper Class="mt-4 pa-3 bg-main animate-hover-up">
                    <PanelTitle Text="🎵 Tracks"/>
                    <MudDivider Class="my-3"/>
                    @if (UserClientContext.CurrentUser is not null && UserClientContext.Can("album.rate"))
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.HowToVote"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="mb-2"
                                   OnClick="@OpenSongVoteModal">
                            Vote genres & rate songs
                        </MudButton>
                    }
                    <MudTable ReadOnly
                              Items="@_albumSongs"
                              Elevation="0"
                              CustomHeader="@true" CustomFooter="@true"
                              Dense
                              Class="my-3 tracklist-table" Style="width: 100%">
                        <HeaderContent>
                            <MudTHeadRow>
                                <MudTh Class="color-secondary text-light">#</MudTh>
                                <MudTh Class="color-secondary text-light">Title</MudTh>
                                <MudTh Class="color-secondary text-light">Duration</MudTh>
                            </MudTHeadRow>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd Style="width: 30px;" DataLabel="#" Class="track-no color-secondary">
                                @if (_album.DiscTotal is null || _album.DiscTotal < 2)
                                {
                                    @context.TrackNumber
                                }
                                else
                                {
                                    @($"{context.DiscNumber}.{context.TrackNumber}")
                                }
                            </MudTd>
                            <MudTd DataLabel="Title" Class="track-title">
                                <SongTitleStylized Song="@context"/>
                            </MudTd>
                            <MudTd DataLabel="Duration" Style="width: 80px;" Class="track-duration">
                                @context.Duration.FormatDuration()
                            </MudTd>
                        </RowTemplate>

                        <FooterContent>
                            <MudTFootRow>
                                <MudTd colspan="3" Class="text-light color-secondary">
                                    Total Duration: <span class="text-bold color-primary">@_album.TotalDuration.FormatDuration()</span>
                                </MudTd>
                            </MudTFootRow>
                        </FooterContent>
                    </MudTable>
                </MudPaper>
                
                <!-- Credit -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="📒 Credits"/>
                </MudPaper>
                
                <!-- Similar Releases -->
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <PanelTitle Text="🔗 Similar Releases" />
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />
        <AlbumTrackListEditModal @ref="_trackListEditModal" OnSave="OnQuitModal" />
        <AlbumSongGenreVoteModal @ref="_songGenreVoteModal" OnSave="OnQuitModal" />
        <AlbumGenreVoteModal @ref="_genreVoteModal" OnSave="OnQuitModal" />
    </MudContainer>
}

