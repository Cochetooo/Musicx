@page "/Artist/{id}"
@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Infrastructure.Shared.Models.ExternalMusicData
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists
@using Musicx.Presentation.Web.Client.Components.GenreDetails

@inject IGetUseCase<OutArtist> UcGet
@inject IGetAlbumByArtistUseCase UcGetAlbums
@inject ILoggerFactory LoggerProvider
@inject IUserClientContext UserClientContext

<MudBreadcrumbs Items="@_breadcrumb" />

@if (null == _artist)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudCard Class="mt-4 glass-card animate-hover-up bg-gray">
        <MudCardHeader>
            <MudImage Src="@_artist.ArtworkUrl" Elevation="25" Style="width: 200px; border-radius: 10px"/>

            <MudStack Class="pl-8">
                <MudText Typo="Typo.h1" Style="font-size: 5rem;" Class="montserrat text-extra-bold mb-1">
                    @_artist.Name 
                </MudText>
                
                @if (_artist.Country is not null)
                {
                    <MudText Typo="Typo.h5" Class="my-1">
                        <Flag CountryName="@_artist.Country" />
                    </MudText>
                }
                
                <MudDivider Class="mt-2"/>
            
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="montserrat text-bold">
                    @_artist.CalculatedGenres
                </MudText>
            
                <MudText Typo="Typo.caption" Color="Color.Tertiary" Class="montserrat text-italic">
                    @_artist.CalculatedInfluences
                </MudText>
            </MudStack>
        </MudCardHeader>
        <MudCardContent>
            <MudTabs Elevation="2" Rounded ApplyEffectsToContainer PanelClass="pa-6 bg-default">
                <MudTabPanel Text="Releases" Icon="@Icons.Material.Filled.LibraryMusic">
                    <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row Class="mb-5">
                        <MudText Typo="Typo.caption">Type</MudText>

                        <MudStack Spacing="2" Row>
                            @foreach (var releaseType in _availableReleaseTypes)
                            {
                                <MudButton
                                    Color="Color.Primary"
                                    OnClick="@(() => ToggleReleaseType(releaseType))"
                                    Variant="@GetVariant(releaseType)">
                                    @releaseType.Key.ToString()
                                </MudButton>
                            }
                        </MudStack>

                        <MudSpacer/>

                        @if (UserClientContext.Can("artist.album.add"))
                        {
                            <MudButton OnClick="@AddAlbumShowModal"
                                       Class="my-5"
                                       Color="Color.Success"
                                       Variant="Variant.Filled"
                                       StartIcon="@Icons.Material.Filled.AddCircle">
                                New Release
                            </MudButton>
                        }

                        <MudIconButton
                            Icon="@Icons.Material.Filled.List"
                            Color="Color.Primary"
                            OnClick="@(() => ToggleListView(true))"
                            Variant="@GetListVariant()"/>

                        <MudIconButton
                            Icon="@Icons.Material.Filled.MoreVert"
                            Color="Color.Primary"
                            OnClick="@(() => ToggleListView(false))"
                            Variant="@GetListVariant(inverted: true)"/>
                        
                        <MudSelect 
                                Variant="Variant.Outlined"
                                AdornmentIcon="@Icons.Material.Filled.Sort"
                                AdornmentColor="Color.Primary"
                                Label="Sort By"
                                Immediate
                                FitContent
                                T="@((string, bool))" 
                                ValueChanged="@(v => SortBy(v))">
                            <MudSelectItem Value="@(("ReleaseDate", false))">Release Date</MudSelectItem>
                            <MudSelectItem Value="@(("ReleaseDate", true))">Release Date - desc</MudSelectItem>
                            <MudSelectItem Value="@(("Name", false))">Name A->Z</MudSelectItem>
                            <MudSelectItem Value="@(("Name", true))">Name Z->A</MudSelectItem>
                            <MudSelectItem Value="@(("Rating", false))">Rating</MudSelectItem>
                            <MudSelectItem Value="@(("Rating", true))">Rating - desc</MudSelectItem>
                        </MudSelect>
                    </MudStack>

                    @if (_isReleasesListView)
                    {
                        <MudList T="RenderFragment" Dense>
                            @foreach (var album in _artistAlbums)
                            {
                                if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                        out var value) && value)
                                {
                                    <div class="album-list">
                                        <MudListItem>
                                            <MudLink Href="@($"/Album/{album.Id}")">
                                                <MudStack AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Row>
                                                    <MudStack Justify="Justify.FlexStart" Row>
                                                        <MudImage Src="@album.ArtworkUrl" Alt="@album.Name"
                                                                  Width="48" Height="48"
                                                                  Class="rounded-lg"
                                                                  Elevation="25"/>

                                                        <AlbumListQuickInfo class="mx-3" Album="@album"/>
                                                    </MudStack>

                                                    <MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Row>
                                                        @if (album.SimplifiedGenreName is not null && album.SimplifiedGenreColor is not null)
                                                        {
                                                            <MudChip
                                                                Class="montserrat py-1 px-3 ma-1 genre-badge"
                                                                Style="@GetSimplifiedGenreStyle(album)"
                                                                Label="@true">
                                                                @album.SimplifiedGenreName
                                                            </MudChip>
                                                        }
                                                        
                                                        <MudDivider Vertical />
                                                        
                                                        <MudBadge Content="@(album.Stats?.Count ?? 0)"
                                                                  Color="Color.Dark"
                                                                  Overlap="true"
                                                                  Bordered="true"
                                                                  Origin="Origin.BottomRight">
                                                            <MudChip T="string"
                                                                     Class="text-bold"
                                                                     Style="@($"background-color: {RatingHelper.GetColorForRating(album.Stats?.Average)};" +
                                                                            $"color: white; width: 100px; max-width: 100px;")" >
                                                                @RatingHelper.GetRatingFormatted(album.Stats?.Average, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                                            </MudChip>
                                                        </MudBadge>
                                                    </MudStack>
                                                </MudStack>
                                            </MudLink>
                                        </MudListItem>
                                    </div>
                                }
                            }
                        </MudList>
                    }
                    else
                    {
                        <Div Class="d-flex flex-wrap gap-2">
                            @foreach (var album in _artistAlbums)
                            {
                                if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                        out var value) && value)
                                {
                                    <div style="width: 150px;" Class="album-tile pa-1">
                                        <MudTooltip Duration="750"
                                                    Delay="1000"
                                                    Placement="Placement.Top"
                                                    Arrow>
                                            <ChildContent>
                                                <MudLink Href="@($"/Album/{album.Id}")">
                                                    <MudBadge Content="@RatingHelper.GetRatingFormatted(album.Stats?.Average, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                                              Overlap="true"
                                                              Color="Color.Dark"
                                                              Bordered="true"
                                                              Class="mb-1"
                                                              BadgeClass="pa-2 text-bold montserrat"
                                                              Origin="Origin.BottomCenter">
                                                        <MudImage Src="@album.ArtworkUrl" Alt="@album.Name"
                                                                  Width="128" Height="128"
                                                                  Class="rounded-lg"
                                                                  Elevation="8"/>
                                                    </MudBadge>
                                                    
                                                    <AlbumListQuickInfo Album="album"/>
                                                </MudLink>
                                            </ChildContent>
                                            <TooltipContent>
                                                <MudText Typo="Typo.h6" Class="montserrat">@album.Name</MudText>
                                                
                                                @if (album.OriginalReleaseDate is not null)
                                                {
                                                    <MudText Typo="Typo.caption">@album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")</MudText>
                                                }
                                            
                                                <GenreDetails Album="@album" Size="Size.Small" DetailedView />
                                            </TooltipContent>
                                        </MudTooltip>
                                    </div>
                                }
                            }
                        </Div>
                    }
                </MudTabPanel>
                
                <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="5" Row>
                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Success"
                            StartIcon="@Icons.Material.Filled.PersonAdd">
                            Follow
                        </MudButton>

                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Warning"
                            OnClick="@EditArtistShowModal"
                            StartIcon="@Icons.Material.Filled.EditNote">
                            Edit Info
                        </MudButton>
                    </MudStack>

                    <MudList T="RenderFragment">
                        @if (_artist.Discriminator == ArtistDiscriminator.Band)
                        {
                            if (null != _artist.FormationDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Formed
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.FormationDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.SplitDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Split
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.SplitDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                        @if (_artist.Discriminator == ArtistDiscriminator.Person)
                        {
                            if (null != _artist.BirthDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Born
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.BirthDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.DeathDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Died
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.DeathDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                        <Descriptor>
                            <DescriptorLabel>
                                Country
                            </DescriptorLabel>
                            <DescriptorValue>
                                <Flag CountryName="@_artist.Country"/> @_artist.Country
                            </DescriptorValue>
                        </Descriptor>
                    </MudList>
                </MudTabPanel>
                
                <MudTabPanel Text="History" Icon="@Icons.Material.Filled.MultilineChart">
                    <MudChart
                        ChartType="ChartType.Line"
                        ChartSeries="@_historySeries"
                        ChartOptions="@_historyChartOptions"
                        XAxisLabels="@_xAxisChartLabels"
                        AxisChartOptions="@_axisChartOptions"/>
                </MudTabPanel>
            </MudTabs>
        </MudCardContent>
    </MudCard>
}

<ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" />
<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />