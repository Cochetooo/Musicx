@page "/Artist/{id}"
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Album
@using Musicx.Application.Web.Interfaces.UseCases.Artist
@using Musicx.Application.Web.Interfaces.UseCases.User.AlbumAttribute
@using Musicx.Contracts.Dto.Requests.Artist
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Components.Albums
@using Musicx.Presentation.Web.Client.Components.Artists
@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Components.Ratings
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists

@inject IFindArtistDataViewService UcArtistDataView
@inject ISaveService<InUserArtistAttribute> UcSaveArtistAttr
@inject HttpClient Http
@inject ILoggerFactory LoggerProvider
@inject IUserClientContext UserClientContext

@if (null == _artist)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
        <div class="artist-hero" style="--hero-url: url('@_artist.ArtworkUrl');">
            <div class="artist-hero-content">
                <div class="artist-hero-image glass-paper">
                    <MudImage Src="@_artist.ArtworkUrl" Alt="@_artist.Name"
                              @key="_artist.ArtworkUrl"
                              Style="width: 100%" Class="rounded-lg" />
                    
                </div>
                
                <div class="glass-paper">
                    <MudTooltip Inline="false" Text="@_artist.Name" Delay="500">
                        <ChildContent>
                            <h1 class="artist-title animate-text clamped-text-2">
                                @_artist.Name
                            </h1>
                        </ChildContent>
                    </MudTooltip>

                    <MudDivider Class="my-3"/>

                    <ArtistGenreSummary PrimaryGenres="@_primaryGenres"
                                        Influences="@_influences"
                                        Descriptors="@_descriptors"
                                        Scenes="@_scenes"
                                        Movements="@_movements"
                                        SimpleMode="@_simpleGenreMode" />

                    <MudStack Row Class="mt-3" AlignItems="AlignItems.Center" Spacing="4">
                        <MudText Typo="Typo.subtitle2" Class="text-shadow color-secondary">
                            👥 Followers: @_followersCount
                        </MudText>
                        <MudText Typo="Typo.subtitle2" Class="text-shadow color-secondary">
                            💿 Releases: @_artistAlbums.Total
                        </MudText>
                        <MudText Typo="Typo.subtitle2" Class="text-shadow color-secondary">
                            🌍 Country: <Flag CountryName="@_artist.CurrentCountry"/>
                        </MudText>
                    </MudStack>

                    <div class="mt-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudTooltip Text="@(_isCurrentUserFollowing ? "Unfollow this artist" : "Follow this artist")">
                                <ChildContent>
                                    <MudButton Class="@("artist-follow-button " + (_isCurrentUserFollowing ? "is-following" : string.Empty))"
                                               Variant="Variant.Filled"
                                               Color="@(_isCurrentUserFollowing ? Color.Warning : Color.Dark)"
                                               StartIcon="@(_isCurrentUserFollowing ? Icons.Material.Filled.Star : Icons.Material.Filled.StarOutline)"
                                               Disabled="@(UserClientContext.CurrentUser is null || !UserClientContext.Can("user.album.attrs.save"))"
                                               OnClick="@ToggleArtistFollowAsync">
                                        <span>@(_isCurrentUserFollowing ? "Following" : "Follow")</span>
                                    </MudButton>
                                </ChildContent>
                            </MudTooltip>

                            @* small place for quick actions *@
                            <MudButton
                                Variant="Variant.Outlined"
                                Color="Color.Warning"
                                OnClick="@EditArtistShowModal"
                                StartIcon="@Icons.Material.Filled.EditNote">
                                Edit Info
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary">Share</MudButton>
                        </MudStack>
                    </div>
                </div>
                
                <div class="glass-paper donut-box pa-2">
                    <div style="justify-items: center" class="mb-2">
                        <MudText Typo="Typo.subtitle1" Class="montserrat text-bold">🌐 Global</MudText>
                        <MudText Typo="Typo.caption" Class="color-secondary">@_artistRatingSummary.Count ratings</MudText>
                        <DonutRating Rating="@_artistRatingSummary.Average" 
                                     RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)" 
                                     Size="DonutRatingSize.Medium" />
                    </div>
                    <MudStack Justify="Justify.SpaceAround" Row Spacing="2">
                        <div style="justify-items: center">
                            <MudText Typo="Typo.subtitle2" Class="montserrat">⭐ Fan Rating</MudText>
                            <DonutRating Rating="@_artistRatingSummary.FanAverage"
                                         RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                         Size="DonutRatingSize.Small"/>
                        </div>
                        <div style="justify-items: center">
                            <MudText Typo="Typo.subtitle2" Class="montserrat">👤 Non-Fan Rating</MudText>
                            <DonutRating Rating="@_artistRatingSummary.NonFanAverage"
                                         RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                         Size="DonutRatingSize.Small"/>
                        </div>
                    </MudStack>
                </div>
            </div>
        </div>
        
        <MudGrid Class="my-4" Spacing="3">
            @* Main column: Releases *@
            <MudItem xs="12" md="9">
                <MudPaper Class="bg-main pa-4">
                    <PanelTitle Text="Releases" />
                    <MudDivider Class="my-3"/>

                    @* TOOLBAR COMPONENT *@
                    <AlbumViewToolbar OnSearch="OnSearch" OnSort="OnSort" OnViewModeChanged="OnViewModeChanged"
                                      OnZoomChanged="OnZoomChanged" OnGroupByChanged="OnToggleGroup"
                                      OnRatingModeChanged="OnRatingModeChanged" AllowAdd="@UserClientContext.Can("artist.album.add")"
                                      OnNewRelease="AddAlbumShowModal" SelectedSort="@_selectedSort"
                                      InitialViewMode="@_viewMode" InitialRatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode)"/>

                    @* Main view switcher: List / Grid / Timeline *@
                    @if (_viewMode == ReleasesViewMode.List)
                    {
                        <AlbumListView Albums="@_filteredAlbums" Zoom="@_zoomLevel"
                                       UserRatings="@_userAttrs"
                                       RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                       IsGrouped="@_groupByType"/>
                    }
                    else if (_viewMode == ReleasesViewMode.Grid)
                    {
                        <AlbumGridView Albums="@_filteredAlbums" Zoom="@_zoomLevel"
                                       RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                       ShowRating
                                       ShowRatingCount
                                       IsGrouped="@_groupByType"/>
                    }
                    else if (_viewMode == ReleasesViewMode.Timeline)
                    {
                        <AlbumTimelineView Albums="@(_filteredAlbums
                                .Where(a =>  a.Stats?.Average is not null && a.Stats.Average > 0 
                                    && (a.ReleaseType == ReleaseType.Lp || a.ReleaseType == ReleaseType.DjMix 
                                    || a.ReleaseType == ReleaseType.Demo || a.ReleaseType == ReleaseType.Ep))
                                .ToList())" />
                    }
                </MudPaper>
            </MudItem>

            <!-- Side column: Details -->
            <MudItem xs="12" md="3">
                <MudPaper Class="glass-paper pa-4">
                    <PanelTitle Text="Info" />
                    <MudDivider Class="my-2" />

                    <MudList Dense="true" T="RenderFragment">
                        @if (!string.IsNullOrWhiteSpace(_artist.Alias))
                        {
                            <Descriptor>
                                <DescriptorLabel>👀 Also Known As</DescriptorLabel>
                                <DescriptorValue>@_artist.Alias</DescriptorValue>
                            </Descriptor>
                        }
                        @if (_artist.CurrentCountry is not null)
                        {
                            <Descriptor>
                                <DescriptorLabel>🌍 Location</DescriptorLabel>
                                <DescriptorValue>
                                    @_artist.CurrentCountry
                                    @if (_artist.CurrentRegion is not null)
                                    {
                                        <span>, @_artist.CurrentRegion</span>
                                    }
                                    @if (_artist.CurrentTown is not null)
                                    {
                                        <span>, @_artist.CurrentTown</span>
                                    }
                                </DescriptorValue>
                            </Descriptor>
                        }
                        @if (_artist.OriginCountry is not null)
                        {
                            <Descriptor>
                                <DescriptorLabel>🌏 Origin Location</DescriptorLabel>
                                <DescriptorValue>
                                    @_artist.OriginCountry
                                    @if (_artist.OriginRegion is not null)
                                    {
                                        <span>, @_artist.OriginRegion</span>
                                    }
                                    @if (_artist.OriginTown is not null)
                                    {
                                        <span>, @_artist.OriginTown</span>
                                    }
                                </DescriptorValue>
                            </Descriptor>
                        }
                        @if (_artist.Discriminator == ArtistDiscriminator.Band)
                        {
                            if (null != _artist.FormationDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        👥 Formed
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.FormationDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.SplitDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        🚫 Split
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.SplitDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                        @if (_artist.Discriminator == ArtistDiscriminator.Person)
                        {
                            if (null != _artist.FirstName || null != _artist.LastName)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        🔤 Name
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @if (_artist.FirstName is not null)
                                        {
                                            @(_artist.FirstName + " ");
                                        }
                                        
                                        @if (_artist.LastName is not null)
                                        {
                                            @_artist.LastName
                                        }
                                    </DescriptorValue>
                                </Descriptor>
                            }
                            
                            if (null != _artist.BirthDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        👶 Born
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.BirthDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.DeathDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        ☠️ Died
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.DeathDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

<ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" />
<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />

