@page "/Artist/{id}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums
@using Musicx.Presentation.Web.Client.Modals.Admin.Artists
@using Musicx.Presentation.Web.Client.Components.GenreDetails

@inject IGetUseCase<OutArtist> UcGet
@inject IGetAlbumByArtistUseCase UcGetAlbums
@inject ILoggerFactory LoggerProvider

<MudBreadcrumbs Items="@_breadcrumb" />

@if (null == _artist)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudCard Class="mt-4" Style="background-color: var(--mud-palette-background-gray);">
        <MudCardHeader>
            <MudImage Src="@_artist.ArtworkUrl" Elevation="25" Style="width: 200px; border-radius: 10px"/>

            <MudText Typo="Typo.h1" Style="font-weight: 900; font-size: 5rem;" Class="pl-8 montserrat">
                @_artist.Name
            </MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudTabs Elevation="2" Rounded ApplyEffectsToContainer PanelClass="pa-6" Style="background-color: var(--mud-palette-background);">
                <MudTabPanel Text="Releases" Icon="@Icons.Material.Filled.LibraryMusic">
                    <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Row Class="mb-5">
                        <MudText Typo="Typo.caption">Type</MudText>

                        <MudStack Spacing="2" Row>
                            @foreach (var releaseType in _availableReleaseTypes)
                            {
                                <MudButton
                                    Color="Color.Primary"
                                    OnClick="@(() => ToggleReleaseType(releaseType))"
                                    Variant="@GetVariant(releaseType)">
                                    @releaseType.Key.ToString()
                                </MudButton>
                            }
                        </MudStack>

                        <MudSpacer/>

                        <MudButton OnClick="@AddAlbumShowModal"
                                   Class="my-5"
                                   Color="Color.Success"
                                   Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.AddCircle">
                            New Release
                        </MudButton>

                        <MudIconButton
                            Icon="@Icons.Material.Filled.List"
                            Color="Color.Primary"
                            OnClick="@(() => ToggleListView(true))"
                            Variant="@GetListVariant()"/>

                        <MudIconButton
                            Icon="@Icons.Material.Filled.MoreVert"
                            Color="Color.Primary"
                            OnClick="@(() => ToggleListView(false))"
                            Variant="@GetListVariant(inverted: true)"/>
                    </MudStack>

                    @if (_isReleasesListView)
                    {
                        <MudList T="RenderFragment" Dense>
                            @foreach (var album in _artistAlbums)
                            {
                                if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                        out var value) && value)
                                {
                                    <MudListItem Class="album-list">
                                        <MudLink Href="@($"/Album/{album.Id}")">
                                            <MudStack AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Row>
                                                <MudStack Justify="Justify.FlexStart" Row>
                                                    <MudImage Src="@album.ArtworkUrl" Alt="@album.Name"
                                                              Width="48" Height="48"
                                                              Class="rounded-lg"
                                                              Elevation="25"/>

                                                    <AlbumListQuickInfo class="mx-3" Album="@album"/>
                                                </MudStack>

                                                @if (album.SimplifiedGenreName is not null && album.SimplifiedGenreColor is not null)
                                                {
                                                    <MudChip
                                                        Class="montserrat py-1 px-3 ma-1"
                                                        Style="@GetSimplifiedGenreStyle(album)">
                                                        @album.SimplifiedGenreName
                                                    </MudChip>
                                                }
                                            </MudStack>
                                        </MudLink>
                                    </MudListItem>
                                }
                            }
                        </MudList>
                    }
                    else
                    {
                        <Div Class="d-flex flex-wrap gap-2">
                            @foreach (var album in _artistAlbums)
                            {
                                if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                        out var value) && value)
                                {
                                    <div style="width: 150px;" Class="album-tile pa-1">
                                        <MudTooltip Duration="750"
                                                    Delay="1000"
                                                    Placement="Placement.Top"
                                                    Arrow>
                                            <ChildContent>
                                                <MudLink Href="@($"/Album/{album.Id}")">
                                                    <MudImage Src="@album.ArtworkUrl" Alt="@album.Name"
                                                              Width="128" Height="128"
                                                              Class="rounded-lg"
                                                              Elevation="8"/>
                                                    <AlbumListQuickInfo Album="album"/>
                                                </MudLink>
                                            </ChildContent>
                                            <TooltipContent>
                                                <MudText Typo="Typo.h6" Class="montserrat">@album.Name</MudText>
                                                
                                                @if (album.OriginalReleaseDate is not null)
                                                {
                                                    <MudText Typo="Typo.caption">@album.OriginalReleaseDate.Value.ToString("dd/MM/yyyy")</MudText>
                                                }
                                            
                                                <GenreDetails Album="@album" Size="Size.Small" DetailedView />
                                            </TooltipContent>
                                        </MudTooltip>
                                    </div>
                                }
                            }
                        </Div>
                    }
                </MudTabPanel>
                
                <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
                    <MudStack Spacing="5" Row>
                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Success"
                            StartIcon="@Icons.Material.Filled.PersonAdd">
                            Follow
                        </MudButton>

                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Warning"
                            OnClick="@EditArtistShowModal"
                            StartIcon="@Icons.Material.Filled.EditNote">
                            Edit Info
                        </MudButton>
                    </MudStack>

                    <MudList T="RenderFragment">
                        @if (_artist.Discriminator == ArtistDiscriminator.Band)
                        {
                            if (null != _artist.FormationDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Formed
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.FormationDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.SplitDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Split
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.SplitDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                        @if (_artist.Discriminator == ArtistDiscriminator.Person)
                        {
                            if (null != _artist.BirthDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Born
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.BirthDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }

                            if (null != _artist.DeathDate)
                            {
                                <Descriptor>
                                    <DescriptorLabel>
                                        Died
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        @_artist.DeathDate.Value.ToString("dd / MM / yyyy")
                                    </DescriptorValue>
                                </Descriptor>
                            }
                        }
                        <Descriptor>
                            <DescriptorLabel>
                                Country
                            </DescriptorLabel>
                            <DescriptorValue>
                                <Flag CountryName="@_artist.Country"/> @_artist.Country
                            </DescriptorValue>
                        </Descriptor>
                    </MudList>
                </MudTabPanel>
                
                <MudTabPanel Text="History" Icon="@Icons.Material.Filled.MultilineChart">
                    <MudChart
                        ChartType="ChartType.Line"
                        ChartSeries="@_historySeries"
                        ChartOptions="@_historyChartOptions"
                        XAxisLabels="@_xAxisChartLabels"
                        AxisChartOptions="@_axisChartOptions"/>
                </MudTabPanel>
            </MudTabs>
        </MudCardContent>
    </MudCard>
}

<ArtistEditModal @ref="_artistEditModal" OnSave="OnQuitModal" />
<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />

<style>
    .album-tile {
        transition: transform 0.3s ease-in-out;
    }
    
    .album-tile:hover {
        transform: scale(1.1);
    }
    
    .album-list {
        transition: transform 0.25s ease-in-out;
    }
    
    .album-list:hover {
        transform: scale(1.03);
    }
</style>