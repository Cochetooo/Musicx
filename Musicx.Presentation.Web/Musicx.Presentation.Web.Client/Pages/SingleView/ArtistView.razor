@page "/Artist/{id}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums

@inject IGetUseCase<OutArtist> UcGet
@inject IFindInUseCase<OutGenre> UcFindInGenres
@inject IGetAlbumByArtistUseCase UcGetAlbums
@inject ILoggerProvider LoggerProvider

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink TextColor="TextColor.Secondary" To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink TextColor="TextColor.Secondary" To="#">Artists</BreadcrumbLink>
    </BreadcrumbItem>
    @if (null == _artist)
    {
        <BreadcrumbItem>
            <BreadcrumbLink TextColor="TextColor.Primary" To="#">-</BreadcrumbLink>
        </BreadcrumbItem>
    }
    else
    {
        <BreadcrumbItem>
            <BreadcrumbLink TextColor="TextColor.Primary" To="#">@_artist.Name</BreadcrumbLink>
        </BreadcrumbItem>
    }
</Breadcrumb>

@if (null == _artist)
{
    <SpinKit Type="SpinKitType.Pulse" />
}
else
{
    <Card Margin="Margin.Is4.OnY" Background="Background.Primary">
        <CardHeader Background="Background.Secondary" Flex="Flex.JustifyContent.Start.OnDesktop"
                    Padding="Padding.Is3.OnX">        
            <Image Style="width: 200px; border-radius:10px" Shadow="Shadow.Small" Source="@_artist.ArtworkUrl" />
            
            <Heading Padding="Padding.Is5.FromStart.OnDesktop"
                     Italic
                     Flex="Flex.AlignItems.Center"
                     Style="font-weight: 900; font-size: 5rem;" TextColor="TextColor.Primary">
                @_artist.Name
            </Heading>
        </CardHeader>
        <CardBody TextColor="TextColor.Primary">
            <Row Margin="Margin.Is3.OnX">
                <Column Padding="Padding.Is3.OnAll" ColumnSize="ColumnSize.Is3.OnDesktop">
                    <Card>
                        <CardHeader Background="Background.Primary">
                            <Button Color="Color.Secondary">
                                <Icon Name="IconName.UserPlus" Margin="Margin.Is2.OnX" />
                                Follow
                            </Button>
                        </CardHeader>
                        <CardBody Background="Background.Primary">
                            <CardTitle Size="3" TextColor="TextColor.Primary">
                                Details
                            </CardTitle>
                            <ListGroup Background="Background.Primary" Flush>
                                @if (_artist.Discriminator == ArtistDiscriminator.Band)
                                {
                                    if (null != _artist.FormationDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Formed
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.FormationDate.Value.ToString("dd / MM / yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }

                                    if (null != _artist.SplitDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Split
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.SplitDate.Value.ToString("dd / MM / yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }
                                }
                                @if (_artist.Discriminator == ArtistDiscriminator.Person)
                                {
                                    if (null != _artist.BirthDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Born
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.BirthDate.Value.ToString("dd / MM / yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }

                                    if (null != _artist.DeathDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Died
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.DeathDate.Value.ToString("dd / MM / yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }
                                }
                                <Descriptor>
                                    <DescriptorLabel>
                                        Country
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        <Flag CountryName="@_artist.Country"/> @_artist.Country
                                    </DescriptorValue>
                                </Descriptor>
                            </ListGroup>
                        </CardBody>
                    </Card>
                </Column>
                <Column ColumnSize="ColumnSize.Is9.OnDesktop" Padding="Padding.Is3.OnAll">
                    <Card>
                        <CardBody Background="Background.Primary">
                            <CardTitle Size="3" TextColor="TextColor.Primary">
                                Releases
                            </CardTitle>
                            <Div Flex="Flex.JustifyContent.Between">
                                <Fields>
                                    <Field>
                                        <FieldLabel Margin="Margin.Is2.FromEnd" TextColor="TextColor.Primary">
                                            Type
                                        </FieldLabel>
                                        <FieldBody>
                                            <Buttons>
                                                @foreach (var releaseType in _availableReleaseTypes)
                                                {
                                                    <Button Color="Color.Info"
                                                            TextColor="TextColor.Primary"
                                                            Clicked="@(() => ToggleReleaseType(releaseType))"
                                                            Outline="@(!releaseType.Value)">
                                                        @releaseType.Key.ToString()
                                                    </Button>
                                                }
                                            </Buttons>
                                        </FieldBody>
                                    </Field>
                                </Fields>
                                
                                <Div>
                                    <Button Color="Color.Info"
                                            TextColor="TextColor.Primary"
                                            Clicked="@(() => ToggleListView(true))"
                                            Outline="@(!_isReleasesListView)">
                                        <Icon Name="IconName.List" />
                                    </Button>
                                    
                                    <Button Color="Color.Info"
                                            TextColor="TextColor.Primary"
                                            Clicked="@(() => ToggleListView(false))"
                                            Outline="@(_isReleasesListView)">
                                        <Icon Name="IconName.GripVertical" />
                                    </Button>
                                </Div>
                            </Div>
                            <Div Gap="Gap.Is2" Flex="Flex.Wrap">
                                @if (_isReleasesListView)
                                {
                                    <ListGroup Flush Width="Width.Is100">
                                        @foreach (var album in _artistAlbums)
                                        {
                                            if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                                    out var value) && value)
                                            {
                                                <ListGroupItem Background="Background.Secondary">
                                                    <Div ElementId="#album-list-animate" Class="album-tile" Padding="Padding.Is1">
                                                        <Animate Anchor="#album-animate" Auto
                                                                 Animation="Animations.FadeRight" DelayMilliseconds="50">
                                                            <Blazorise.Link To="@($"/Album/{album.Id}")" Flex="Flex.AlignItems.Start.JustifyContent.Between">
                                                                <Div Flex="Flex._">
                                                                    <Figure Size="FigureSize.Is48x48">
                                                                        <FigureImage Source="@album.ArtworkUrl" AlternateText="@album.Name"
                                                                                     Shadow="Shadow.Default"
                                                                                     Class="neumorphism-shadow-default"
                                                                                     Rounded/>
                                                                    </Figure>

                                                                    <Div Margin="Margin.Is3.OnX">
                                                                        <AlbumListQuickInfo Bigger Album="album"/>
                                                                    </Div>
                                                                </Div>

                                                                <Div Flex="Flex._">
                                                                    @if (album.SimplifiedGenreName is not null && album.SimplifiedGenreColor is not null)
                                                                    {
                                                                        <Badge Padding="Padding.Is1.OnY.Is3.OnX"
                                                                               Class="neumorphism-shadow-default montserrat"
                                                                               TextSize="TextSize.Small"
                                                                               Style="@GetSimplifiedGenreStyle(album)"
                                                                               Margin="Margin.Is1"
                                                                               Pill>
                                                                            @album.SimplifiedGenreName
                                                                        </Badge>
                                                                    }
                                                                </Div>
                                                            </Blazorise.Link>
                                                        </Animate>
                                                    </Div>
                                                </ListGroupItem>
                                            }
                                        }
                                    </ListGroup>
                                }
                                else
                                {
                                    @foreach (var album in _artistAlbums)
                                    {
                                        if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                                out var value) && value)
                                        {
                                            <Div ElementId="#album-animate" Class="album-tile" Padding="Padding.Is1" 
                                                 Style="width: 150px;">
                                                <Animate Anchor="#album-animate" Auto
                                                         Animation="Animations.FlipUp" DelayMilliseconds="50">
                                                    <Blazorise.Link To="@($"/Album/{album.Id}")">
                                                        <Figure Size="FigureSize.Is128x128">
                                                            <FigureImage Source="@album.ArtworkUrl" AlternateText="@album.Name"
                                                                         Shadow="Shadow.Large"
                                                                         Class="neumorphism-shadow-default"
                                                                         Rounded/>
                                                            <FigureCaption>
                                                                <AlbumListQuickInfo Album="album"/>
                                                            </FigureCaption>
                                                        </Figure>
                                                    </Blazorise.Link>
                                                </Animate>
                                            </Div>
                                        }
                                    }
                                }
                            </Div>
                            <Button Clicked="AddAlbumShowModal" Margin="Margin.Is2.FromTop" Color="Color.Success">
                                <Icon Name="IconName.PlusCircle" Margin="Margin.Is2.OnX" />
                                New Release
                            </Button>
                        </CardBody>
                        <CardFooter Background="Background.Secondary">
                            <CardText>Release History</CardText>
                            <LineChart @ref="_historyChart" Style="max-height: 200px" TItem="int"/>
                        </CardFooter>
                    </Card>
                </Column>
            </Row>
        </CardBody>
    </Card>
}

<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />

<style>
    .album-tile {
        transition: transform 0.25s ease-in-out;
    }
    
    .album-tile:hover {
        transform: scale(1.1);
    }
</style>