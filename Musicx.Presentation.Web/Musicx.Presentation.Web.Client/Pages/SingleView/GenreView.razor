@page "/Genre/{id}"
@using System.Globalization
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Album
@using Musicx.Application.Web.Interfaces.UseCases.Artist
@using Musicx.Application.Web.Interfaces.UseCases.Genre
@using Musicx.Application.Web.Interfaces.UseCases.User.Ratings
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.Genre
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Components.Albums
@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Components.Charts
@using Musicx.Presentation.Web.Client.Components.Ratings
@using Musicx.Presentation.Web.Client.Helpers

@inject ILoggerFactory LoggerProvider
@inject IJSRuntime JsRuntime
@inject IFindAlbumByGenreService UcAlbumByGenre
@inject IFindGenreDataViewService UcGenreDataView
@inject IUserClientContext UserClientContext

@if (_genre is null)
{
    <MudPaper Class="pa-6 d-flex justify-center">
        <MudProgressCircular Indeterminate Size="Size.Large" />
    </MudPaper>
}
else
{
    <MudContainer MaxWidth="MaxWidth.False" Class="bg-main pa-2 pa-md-6 rounded-lg">
        
        <MudPaper Class="pa-4 pa-md-6 mb-4 glass-paper genre-hero" Elevation="0">

            <MudStack Spacing="2">

                <MudStack Row Class="genre-header rounded-lg pa-3" AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Style="@(GetHeaderStyle())">
                    <MudTooltip Text="Click to toggle short / canonical name">
                        <MudText Typo="Typo.h2" Class="montserrat text-extra-bold genre-title pl-2" @onclick="ToggleName">
                            @DisplayedName
                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="ml-2 swap-icon"/>
                        </MudText>
                        
                        <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">

                            @if (_genre.Aliases?.Any() == true)
                            {
                                foreach (var alias in _genre.Aliases)
                                {
                                    <MudChip Variant="Variant.Outlined" Size="Size.Small" T="string"
                                             Class="genre-chip-pop">@alias.Name</MudChip>
                                }
                            }

                            <MudChip Color="Color.Primary" Icon="@UiGenreHelper.GetGenreIcon(_genre)"
                                     Variant="Variant.Filled" T="string">
                                @_genre.Type
                            </MudChip>

                            @if (!string.IsNullOrWhiteSpace(_genre.CountryOrigin))
                            {
                                <MudChip Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Public" T="string">@_genre.CountryOrigin</MudChip>
                            }

                            @if (_genre.EraStart is not null || _genre.EraEnd is not null)
                            {
                                <MudChip Variant="Variant.Outlined" T="string" Icon="@Icons.Material.Filled.Schedule">@FormatEra()</MudChip>
                            }
                        </MudStack>
                    </MudTooltip>

                    @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                    {
                        <DonutRating Rating="@_albumsAvgRating" 
                                     RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)" 
                                     Size="DonutRatingSize.Medium"/>
                    }
                </MudStack>

                <MudText Typo="Typo.body2">@(_genre.Description ?? "No description yet.")</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 pa-md-6 mb-4 glass-paper" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <PanelTitle Text="Top Albums" />
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(!_canScrollTopAlbumsLeft)" OnClick="@ScrollTopAlbumsLeftAsync"/>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(!_canScrollTopAlbumsRight)" OnClick="@ScrollTopAlbumsRightAsync"/>
                </MudStack>
            </MudStack>

            <div class="top-albums-track horizontal-scroll" @ref="_topAlbumsScroller">
                @foreach (var album in _topAlbums)
                {
                    <MudLink Href="@($"/Album/{album.Id}")" Class="album-presentation-card animate-hover-up">
                        <MudImage Src="@album.ArtworkUrl" @key="album.ArtworkUrl" Alt="@album.Name" Style="width: 100%" Class="rounded-lg" Elevation="8"/>
                        <MudText Typo="Typo.body1" Class="text-bold clamped-text-1 mt-2">@album.Name</MudText>
                        <MudText Typo="Typo.caption" Class="color-secondary clamped-text-1">@(album.Artist?.Name ?? album.ArtistAlias)</MudText>
                        @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                <MudChip T="string" Size="Size.Small" Class="text-bold" Style="@($"background-color:{RatingHelper.GetColorForRating(album.Stats?.Average)};color:white")">
                                    @RatingHelper.GetRatingFormatted(album.Stats?.Average, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                </MudChip>
                                <MudText Typo="Typo.caption" Class="color-secondary">@((album.Stats?.Count ?? 0).ToString("N0", CultureInfo.CurrentCulture)) ratings</MudText>
                            </MudStack>
                        }
                    </MudLink>
                }
            </div>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="3">
                <MudPaper Class="pa-4 mt-3 glass-paper panel-animated" Elevation="0">
                    <PanelTitle Text="Hierarchy" />
                    <MudStack Spacing="1">
                        @{ var maxDepth = 0; }
                        @if (_genre.Parents?.Any() == true)
                        {
                            maxDepth = _genre.Parents.Select(p => p.Depth).Max();
                            foreach (var genre in _genre.Parents
                                         .Where(g => g.Relation.Id != _genre.Id)
                                         .OrderByDescending(g => g.Depth)
                                         .ThenBy(g => g.Relation.CanonicalName))
                            {
                                <MudLink Href="@($"/Genre/{genre.Relation.Id}")" Color="Color.Tertiary"
                                         Class="@($"ml-{(maxDepth - genre.Depth) * 3} d-block")">
                                    @genre.Relation.CanonicalName
                                </MudLink>
                            }
                        }

                        <MudLink Href="@($"/Genre/{_genre.Id}")" Color="Color.Primary"
                                 Class="@($"ml-{maxDepth * 3} d-block text-bold")">
                            @_genre.CanonicalName
                        </MudLink>

                        @if (_genre.Children?.Any() == true)
                        {
                            foreach (var genre in _genre.Children
                                         .Where(g => g.Relation.Id != _genre.Id && g.Depth == 1)
                                         .OrderBy(g => g.Relation.CanonicalName))
                            {
                                <MudLink Href="@($"/Genre/{genre.Relation.Id}")" Color="Color.Secondary"
                                         Class="@($"ml-{(maxDepth + 1) * 3} d-block")">
                                    @genre.Relation.CanonicalName
                                </MudLink>
                            }
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Class="pa-4 mt-3 glass-paper panel-animated" Elevation="0">
                    <PanelTitle Text="Ratings Evolution" />
                    @if (_yearlyRatings.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="color-secondary">Not enough ratings for timeline.</MudText>
                    }
                    else
                    {
                        <D3LineChart Data="_yearlyRatingsChartData" Height="220" />
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 glass-paper panel-animated" Elevation="0">
                    <PanelTitle Text="Releases" Count="@_albumCount.ToString()" />
                    <MudTable ServerData="@LoadAlbumsData" @ref="_albumTable" Dense Hover Elevation="0"
                              Breakpoint="Breakpoint.Sm" RowClass="album-row"
                              RowStyleFunc="@((item, _) => $"--rating-color:{RatingHelper.GetColorForRating(item.Stats?.Average)}")">
                        
                        <ColGroup>
                            <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
                            <col style="width:3px;"/>
                            <col/>
                            <col style="width: 115px;"/>
                            <col style="width: 95px;"/>
                            <col style="width: 115px;"/>
                            </MudHidden>
                        </ColGroup>
                        
                        <HeaderContent>
                            <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
                                <MudTh Style="padding: 0;"></MudTh>
                            </MudHidden>
                            
                            <MudTh>Album</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh>#</MudTh>
                            @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                            {
                                <MudTh>Rating</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Album">
                                <MudLink Href="@($"/Album/{context.Id}")">
                                    <MudStack Justify="Justify.FlexStart" Row="true" AlignItems="AlignItems.Center">
                                        <MudImage Src="@context.ArtworkUrl" Alt="@context.Name" Width="48" Height="48" Class="rounded-lg" Elevation="8"/>
                                        <AlbumListQuickInfo class="mx-3" ShowArtist="true" Album="@context"/>
                                    </MudStack>
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Date">
                                <MudText Typo="Typo.body2" Class="color-primary text-light">
                                    @context.OriginalReleaseDate?.ToString("dd MMM", CultureInfo.CurrentCulture)
                                </MudText>
                                <MudText Typo="Typo.body1" Class="color-primary text-bold">
                                    @context.OriginalReleaseDate?.ToString("yyyy", CultureInfo.CurrentCulture)
                                </MudText>
                            </MudTd>
                            <MudTd DataLabel="#">
                                <MudText Typo="Typo.body2" Class="color-primary">
                                    @((context.Stats?.Count ?? 0).ToString("N0", CultureInfo.CurrentCulture))
                                </MudText>
                            </MudTd>
                            @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                            {
                                <MudTd DataLabel="Rating">
                                    <MudChip T="string" Class="text-bold" Label="true" Style="@($"background-color:{RatingHelper.GetColorForRating(context.Stats?.Average)};color:white")">
                                        @RatingHelper.GetRatingFormatted(context.Stats?.Average, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                    </MudChip>
                                </MudTd>
                            }
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager/>
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-4 glass-paper panel-animated" Elevation="0">
                    <PanelTitle Text="Popular Artists" />
                    <MudGrid Class="mt-1">
                        @foreach (var item in _topArtists)
                        {
                            <MudItem xs="12" md="6">
                                <MudLink Href="@($"/Artist/{item.Artist.Id}")" Class="artist-card">
                                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                        <MudImage Width="56" Height="56" Alt="@item.Artist.Name" Class="rounded-lg" Src="@item.Artist.ArtworkUrl"/>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body1" Class="text-bold clamped-text-1">@item.Artist.Name</MudText>
                                            <MudText Typo="Typo.caption" Class="color-secondary">
                                                <Flag CountryName="@item.Artist.CurrentCountry"/>
                                                @if (UserClientContext.CurrentUser?.PrefShowRatings ?? true)
                                                {
                                                    <span>@RatingHelper.GetRatingFormatted(item.Rating, UserClientContext.CurrentUser?.PrefRatingMode ?? 0) · @item.RatingsCount ratings</span>
                                                }
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudLink>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

<style>
    .genre-hero {
        border: 1px solid rgba(255,255,255,0.12);
    }

    .genre-header {
        min-height: 88px;
    }

    .genre-title { cursor: pointer; transition: transform .2s ease; }
    .genre-title:hover { transform: translateX(4px); }
    .swap-icon { opacity: 0; transition: opacity .2s ease; }
    .genre-title:hover .swap-icon { opacity: 1; }

    .genre-chip-pop { animation: float-up .45s ease; }

    .top-albums-track {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding-bottom: .5rem;
    }

    .artist-card {
        display: block;
        border: 1px solid rgba(255,255,255,.11);
        border-radius: 12px;
        padding: .5rem;
        margin-bottom: .1rem;
        background: rgba(12,17,35,.36);
    }

    .panel-animated { animation: fade-in-up .35s ease both; }
    
    .album-row { position: relative; }
    .album-row:before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background-color: var(--rating-color);
        opacity: .9;
    }
</style>