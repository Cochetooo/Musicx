@page "/Genre/{id}"
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components

@inject ILoggerFactory LoggerProvider
@inject IGetUseCase<OutGenre> UcGet
@inject IGetAlbumByGenreUseCase UcAlbumByGenre

<MudBreadcrumbs Items="@_breadcrumb" />

@if (null == _genre)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudCard Class="mt-4">
        <MudCardHeader Style="@GetHeaderStyle()">
            <MudText Typo="Typo.h1" Class="pl-5 text-italic text-mega-bold" Style="font-size: 5rem;">
                @_genre.Name
            </MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Class="ma-3">
                <MudItem xs="12" md="3" Class="pa-3">
                    <MudCard>
                        <MudCardHeader>
                            <MudText Typo="Typo.h4">Description</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            @if (_genre.Description is not null)
                            {
                                <MudText Typo="Typo.body2">
                                    @_genre.Description
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="text-italic">
                                    There is no description yet.
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="9" Class="pa-3">
                    <MudCard>
                        <MudCardHeader>
                            <MudText Typo="Typo.h4">Releases</MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudList T="RenderFragment" Dense>
                                @foreach (var album in _genreAlbums)
                                {
                                    <MudListItem>
                                        <MudLink Href="@($"/Album/{album.Id}")">
                                            <MudStack AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Row>
                                                <MudStack Justify="Justify.FlexStart" Row>
                                                    <MudImage Src="@album.ArtworkUrl" Alt="@album.Name"
                                                              Width="48" Height="48"
                                                              Style="border-radius: 5px"
                                                              Elevation="25"/>

                                                    <AlbumListQuickInfo class="mx-3" Album="@album"/>
                                                </MudStack>

                                                <MudStack Justify="Justify.FlexEnd" Row>
                                                    @if (album.PrimaryGenres is not null)
                                                    {
                                                        @foreach (var genre in album.PrimaryGenres)
                                                        {
                                                            if (genre.Name != _genre.Name)
                                                            {
                                                                <GenreBadge Genre="@genre" Clickable />
                                                            }
                                                        }
                                                    }
                                                </MudStack>
                                            </MudStack>
                                        </MudLink>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}