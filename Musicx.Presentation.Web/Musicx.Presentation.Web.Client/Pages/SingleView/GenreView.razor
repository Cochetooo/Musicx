@page "/Genre/{id}"
@using System.Globalization
@using Musicx.Application.Shared.Helpers
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Responses
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Components.Albums
@using Musicx.Presentation.Web.Client.Components.Ratings

@inject ILoggerFactory LoggerProvider
@inject IGetUseCase<InGenre, OutGenre> UcGet
@inject IGetAlbumByGenreUseCase UcAlbumByGenre
@inject IUserClientContext UserClientContext

<MudBreadcrumbs Items="@_breadcrumb" />

@if (null == _genre)
{
    <MudProgressCircular Indeterminate />
}
else
{
    <MudCard Class="mt-4">
        <MudCardHeader Style="@GetHeaderStyle()">
            <MudText Typo="Typo.h1" Class="pl-5 montserrat text-mega-bold" Style="font-size: 5rem; text-shadow: 1px 1px 5px #77777733">
                @_genre.CanonicalName
            </MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Class="ma-3">
                <MudItem xs="12" md="4" Class="pa-2">
                    <MudCard>
                        <MudCardHeader>
                            <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                                Description
                            </MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <DonutRating
                                Rating="@_albumsAvgRating"
                                RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                                Size="DonutRatingSize.Small"
                            />
                            
                            @if (_genre.Description is not null)
                            {
                                <MudText Typo="Typo.body2" Class="description mt-2">
                                    @_genre.Description
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="description text-italic mt-2">
                                    There is no description yet.
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                    
                    <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                        <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                            Hierarchy
                        </MudText>
                        
                        <MudDivider Class="my-3" />
                        
                        @if (_genre.Parents?.Any() == true)
                        {
                            foreach (var genre in _genre.Parents)
                            {
                                if (genre.Relation.Id != _genre.Id)
                                {
                                    <MudLink Href="@($"/Genre/{genre.Relation.Id}")" Color="Color.Tertiary"
                                             Class="ml-2 d-block">
                                        @genre.Relation.CanonicalName
                                    </MudLink>
                                }
                            }
                        }
                        
                        <MudLink Href="@($"/Genre/{_genre.Id}")" Color="Color.Primary" 
                                 Class="ml-6 d-block text-bold">
                            @_genre.CanonicalName
                        </MudLink>
                        
                        @if (_genre.Children?.Any() == true)
                        {
                            foreach (var genre in _genre.Children)
                            {
                                if (genre.Relation.Id != _genre.Id)
                                {
                                    <MudLink Href="@($"/Genre/{genre.Relation.Id}")" Color="Color.Secondary"
                                             Class="ml-10 d-block">
                                        @genre.Relation.CanonicalName
                                    </MudLink>
                                }
                            }
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="8" Class="pa-2">
                    <MudCard>
                        <MudCardHeader>
                            <MudText Typo="Typo.h5" Class="montserrat text-bold text-color-primary">
                                Releases (@_albumCount)
                            </MudText>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudTable ServerData="@LoadAlbumsData" ReadOnly
                                      @ref="_albumTable"
                                      Elevation="8"
                                      Breakpoint="Breakpoint.Sm"
                                      RowClass="album-row"
                                      RowStyleFunc="@((item, _) => $"--rating-color:{RatingHelper.GetColorForRating(item.Stats?.Average)}")"
                                      Class="mt-4 pa-2 bg-surface animate-hover-up" Dense>
                                <ColGroup>
                                    <col style="width:3px;" />
                                    <col/>
                                    <col style="width: 100px;"/>
                                    <col style="width: 120px;"/>
                                    <col style="width: 100px;"/>
                                </ColGroup>
                                <HeaderContent>
                                    <MudTh Style="padding: 0;"></MudTh>
                                    <MudTh>
                                        Album
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.CollectionType ?? 0))">
                                            Other Primary Genres
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.UpdatedAt))">
                                            Date
                                        </MudTableSortLabel>
                                    </MudTh>
                                    <MudTh>
                                        <MudTableSortLabel SortBy="@(new Func<OutUserAlbumAttribute, object>(x => x.Rating ?? 0))">
                                            Rating
                                        </MudTableSortLabel>
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Releases">
                                        <MudLink Href="@($"/Album/{@context.Id}")">
                                            <MudStack Justify="Justify.FlexStart" Row>
                                                <MudImage Src="@context.ArtworkUrl" Alt="@context.Name"
                                                          Width="48" Height="48"
                                                          Class="rounded-lg"
                                                          Elevation="25"/>

                                                <AlbumListQuickInfo class="mx-3" ShowArtist="true"
                                                                    Album="@context"/>
                                            </MudStack>
                                        </MudLink>
                                    </MudTd>

                                    <MudTd DataLabel="Other Primary Genres">
                                        
                                    </MudTd>

                                    <MudTd DataLabel="Date">
                                        <MudText Typo="Typo.caption" Class="text-color-primary text-light">
                                            @context.OriginalReleaseDate?.ToString("dd MMM yy", CultureInfo.CurrentCulture)
                                        </MudText>
                                    </MudTd>

                                    <MudTd DataLabel="Rating">
                                        <MudChip T="string"
                                                 Class="text-bold"
                                                 Label="true"
                                                 Style="@($"background-color: {RatingHelper.GetColorForRating(context.Stats?.Average)};" +
                                                        $"color: white")">
                                            @RatingHelper.GetRatingFormatted(context.Stats?.Average, UserClientContext.CurrentUser?.PrefRatingMode ?? 0)
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>

                                <PagerContent>
                                    <MudTablePager/>
                                </PagerContent>
                            </MudTable>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}

<style>
    .album-row {
        position: relative;
    }

    .album-row:before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background-color: var(--rating-color);
        opacity: 0.75;
        border-radius: 2px;
    }
</style>