@page "/Artist/{id}"
@using System.Collections.Immutable
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Application.Web.Interfaces.UseCases.Specifics
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Responses
@using Musicx.Domain.Enums
@using Musicx.Presentation.Web.Client.Components
@using Musicx.Presentation.Web.Client.Modals.Admin.Albums

@inject IGetUseCase<OutArtist> UcGet
@inject IGetAlbumByArtistUseCase UcGetAlbums
@inject ILoggerProvider LoggerProvider

<Breadcrumb Margin="Margin.Is2.FromBottom">
    <BreadcrumbItem>
        <BreadcrumbLink To="/">Musicx</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbItem>
        <BreadcrumbLink To="#">Artists</BreadcrumbLink>
    </BreadcrumbItem>
    @if (null == _artist)
    {
        <BreadcrumbItem>
            <BreadcrumbLink To="#">-</BreadcrumbLink>
        </BreadcrumbItem>
    }
    else
    {
        <BreadcrumbItem>
            <BreadcrumbLink To="#">@_artist.Name</BreadcrumbLink>
        </BreadcrumbItem>
    }
</Breadcrumb>

@if (null == _artist)
{
    <SpinKit Type="SpinKitType.Pulse" />
}
else
{
    <Card Margin="Margin.Is4.OnY">
        <CardHeader Background="Background.Secondary" Flex="Flex.JustifyContent.Between.OnDesktop"
                    Padding="Padding.Is3.OnX">
            <Heading Size="HeadingSize.Is1" 
                     VerticalAlignment="VerticalAlignment.Middle"
                     TextWeight="TextWeight.Bold" TextColor="TextColor.White">
                @_artist.Name
            </Heading>
        
            <Image Style="width: 200px; border-radius:10px; box-shadow: 10px 10px 20px #116298,
             -10px -10px 20px #1578ba" Source="@_artist.ArtworkUrl" />
        </CardHeader>
        <CardBody>
            <Row Margin="Margin.Is3.OnX">
                <Column Padding="Padding.Is3.OnAll" ColumnSize="ColumnSize.Is3.OnDesktop">
                    <Card>
                        <CardHeader>
                            <Button Color="Color.Secondary">
                                <Icon Name="IconName.UserPlus" Margin="Margin.Is2.OnX" />
                                Follow
                            </Button>
                        </CardHeader>
                        <CardBody>
                            <CardTitle Size="5">
                                Details
                            </CardTitle>
                            <ListGroup Flush>
                                @if (_artist.Discriminator == ArtistDiscriminator.Band)
                                {
                                    if (null != _artist.FormationDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Formed
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.FormationDate.Value.ToString("dd/MM/yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }

                                    if (null != _artist.SplitDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Split
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.SplitDate.Value.ToString("dd/MM/yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }
                                }
                                @if (_artist.Discriminator == ArtistDiscriminator.Person)
                                {
                                    if (null != _artist.BirthDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Born
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.BirthDate.Value.ToString("dd/MM/yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }

                                    if (null != _artist.DeathDate)
                                    {
                                        <Descriptor>
                                            <DescriptorLabel>
                                                Died
                                            </DescriptorLabel>
                                            <DescriptorValue>
                                                @_artist.DeathDate.Value.ToString("dd/MM/yyyy")
                                            </DescriptorValue>
                                        </Descriptor>
                                    }
                                }
                                <Descriptor>
                                    <DescriptorLabel>
                                        Country
                                    </DescriptorLabel>
                                    <DescriptorValue>
                                        <Flag CountryName="@_artist.Country"/> @_artist.Country
                                    </DescriptorValue>
                                </Descriptor>
                            </ListGroup>
                        </CardBody>
                    </Card>
                </Column>
                <Column ColumnSize="ColumnSize.Is9.OnDesktop" Padding="Padding.Is3.OnAll">
                    <Card>
                        <CardBody>
                            <CardTitle Size="4">Releases</CardTitle>
                            <Div Flex="Flex.AlignItems.Start">
                                <Fields>
                                    <Field>
                                        <FieldLabel>Release Type</FieldLabel>
                                        <FieldBody>
                                            <Buttons>
                                                @foreach (var releaseType in _availableReleaseTypes)
                                                {
                                                    <Button Color="Color.Primary"
                                                            Clicked="@(() => ToggleReleaseType(releaseType))"
                                                            Outline="@(!releaseType.Value)"
                                                            >@releaseType.Key.ToString()</Button>
                                                }
                                            </Buttons>
                                        </FieldBody>
                                    </Field>
                                </Fields>
                            </Div>
                            <Div Class="d-flex flex-wrap gap-3">
                                @foreach (var album in _artistAlbums)
                                {
                                    if (null != album.ReleaseType && _availableReleaseTypes.TryGetValue(album.ReleaseType.Value,
                                            out var value) && value)
                                    {
                                        <Div class="p-1" Style="width: 150px;">
                                            <Blazorise.Link To="@($"/Album/{album.Id}")">
                                                <Figure Size="FigureSize.Is128x128">
                                                    <FigureImage Source="@album.ArtworkUrl" AlternateText="@album.Name"
                                                                 Rounded/>
                                                    <FigureCaption>
                                                        <Blazorise.Text TextSize="TextSize.Medium">
                                                            @switch (album.ReleaseType)
                                                            {
                                                                case ReleaseType.Compilation:
                                                                    <span class="text-warning">@album.Name</span>
                                                                    break;
                                                                case ReleaseType.Ep:
                                                                    <span class="text-primary">@album.Name</span>
                                                                    break;
                                                                case ReleaseType.Lp:
                                                                    <span class="text-dark font-weight-bolder">@album.Name</span>
                                                                    break;
                                                                case ReleaseType.Single:
                                                                    <span class="text-secondary">@album.Name</span>
                                                                    break;
                                                                case ReleaseType.AdditionalRelease:
                                                                case ReleaseType.Bootleg:
                                                                case ReleaseType.DjMix:
                                                                case ReleaseType.Live:
                                                                case ReleaseType.MixTape:
                                                                case ReleaseType.Soundtrack:
                                                                case ReleaseType.Unknown:
                                                                case ReleaseType.VideoClip:
                                                                case null:
                                                                    <span class="text-muted">@album.Name</span>
                                                                    break;
                                                                default:
                                                                    throw new ArgumentOutOfRangeException();
                                                            }
                                                        </Blazorise.Text>
                                                        @if (null != album.ReleaseDate)
                                                        {
                                                            <Blazorise.Text TextColor="TextColor.Muted">
                                                                <br/>@album.ReleaseDate.Value.Year
                                                            </Blazorise.Text>
                                                        }
                                                    </FigureCaption>
                                                </Figure>
                                            </Blazorise.Link>
                                        </Div>
                                    }
                                }
                            </Div>
                            <Button Clicked="AddAlbumShowModal" Color="Color.Success">
                                <Icon Name="IconName.PlusCircle" Margin="Margin.Is2.OnX" />
                                New Release
                            </Button>
                        </CardBody>
                        <CardFooter>
                            <CardText>Release History</CardText>
                            <LineChart @ref="_historyChart" Style="max-height: 200px" TItem="int"/>
                        </CardFooter>
                    </Card>
                </Column>
            </Row>
        </CardBody>
    </Card>
}

<AlbumEditModal @ref="_albumEditModal" OnSave="OnQuitModal" />

@code {

    [Parameter] public string? Id { get; set; }

    private ILogger _logger = null!;

    private AlbumEditModal? _albumEditModal;
    private LineChart<int> _historyChart = null!;
    
    private OutArtist? _artist;
    private List<OutAlbum> _artistAlbums = [];
    private Dictionary<ReleaseType, bool> _availableReleaseTypes = [];
    private Dictionary<int, int> _releaseCountPerYears = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _logger = LoggerProvider.CreateLogger(nameof(ArtistView));

        await LoadArtist();
    }

    private async Task LoadArtist()
    {
        if (string.IsNullOrWhiteSpace(Id))
        {
            _logger.LogError("❌ Artist ID is null or empty.");
            return;
        }

        if (!long.TryParse(Id, out var artistId))
        {
            _logger.LogError("❌ Invalid Artist ID format: {Id}", Id);
            return;
        }
        
        _artist = await UcGet.ExecuteAsync(artistId);

        if (_artist is null)
        {
            _logger.LogError("⚠️ No artist found for ID: {Id}", Id);
            return;
        }

        _logger.LogInformation($"✅ Artist loaded: {_artist.Name} ({_artist.Id})");
        StateHasChanged();
        
        _artistAlbums = await UcGetAlbums.ExecuteAsync(_artist.Id);
        _logger.LogInformation("🎵 Retrieved {Count} albums for artist {ArtistId}", _artistAlbums.Count, _artist.Id);
        
        _availableReleaseTypes = _artistAlbums
            .Where(s => s.ReleaseType.HasValue)
            .Select(s => s.ReleaseType!.Value)
            .Distinct()
            .ToDictionary(r => r, _ => true);
        
        StateHasChanged();
     
        CalculateReleasesPerYear();
        await UpdateChartAsync();

        
    }
    
    private async Task UpdateChartAsync()
    {
        await _historyChart.Clear();

        var labels = _releaseCountPerYears.Keys.Select(y => y.ToString()).ToList();
        var dataset = new LineChartDataset<int>
        {
            Label = "# of releases",
            Data = _releaseCountPerYears
                .Select(g => g.Value)
                .ToList(),
            Fill = true,
            PointRadius = 2,
            CubicInterpolationMode = "monotone"
        };
        
        await _historyChart.AddLabelsDatasetsAndUpdate(labels, dataset);
    }
    
    private void CalculateReleasesPerYear()
    {
        if (null == _artist)
        {
            _logger.LogWarning("⚠️ Cannot calculate releases: artist is null");
            return;
        }
        
        var albumsWithDate = _artistAlbums
            .Where(a => a.ReleaseDate.HasValue)
            .ToList();

        if (0 == albumsWithDate.Count)
        {
            _logger.LogWarning("⚠️ Cannot calculate releases: No album with release date.");
            _releaseCountPerYears.Clear();
            return;
        }

        int minYear = albumsWithDate.Min(a => a.ReleaseDate!.Value.Year);
        int maxYear = _artist.SplitDate?.Year ?? DateTime.Now.Year;

        var grouped = albumsWithDate
            .GroupBy(a => a.ReleaseDate!.Value.Year)
            .ToDictionary(g => g.Key, g => g.Count());

        _releaseCountPerYears = Enumerable
            .Range(minYear, maxYear - minYear + 1)
            .ToDictionary(year => year, year => grouped.TryGetValue(year, out var value) ? value : 0);
    }
    
    private void ToggleReleaseType(KeyValuePair<ReleaseType, bool> releaseType)
    {
        _availableReleaseTypes[releaseType.Key] = !releaseType.Value;
    }

    private void AddAlbumShowModal()
    {
        if (null == _artist)
        {
            _logger.LogError("❌ Cannot add album: artist is null.");
            return;
        }

        _albumEditModal?.Show(_artist);
    }

    private async Task OnQuitModal()
    {
        await LoadArtist();
    }

}