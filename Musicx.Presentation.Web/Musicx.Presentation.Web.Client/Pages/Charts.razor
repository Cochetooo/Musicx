@page "/Charts"
@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Presentation.Web.Client.Components.Albums
@using ChartType = Musicx.Contracts.Enums.ChartType

@inject IApiClient Api
@inject IUserClientContext UserClientContext

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    
    <MudPaper Class="pa-6 mb-6 bg-surface glass-card" Elevation="0">

        <MudStack Spacing="2">

            <MudText Typo="Typo.h2" Class="montserrat text-extra-bold">
                Charts
            </MudText>

            <MudText Typo="Typo.body2" Class="color-secondary">
                Generate dynamic album rankings based on custom filters.
            </MudText>

        </MudStack>

    </MudPaper>
    
    <MudPaper Class="pa-6 mb-8 bg-default glass-card" Elevation="0">

        <MudStack Spacing="6">

            <!-- BASIC FILTERS -->
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">General</MudText>

                <MudGrid Spacing="3">

                    <MudItem xs="12" md="4">
                        <MudSelect T="ChartType"
                                   Label="Chart Type"
                                   Variant="Variant.Outlined"
                                   @bind-Value="_query.ChartType">
                            @foreach (var chartType in Enum.GetValues<ChartType>())
                            {
                                <MudSelectItem Value="chartType">
                                    @chartType
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField Label="Album Name"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      @bind-Value="_query.Name"/>
                    </MudItem>

                </MudGrid>
            </MudStack>
                
            <MudDivider/>

            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">User & Release Filters</MudText>

                <MudGrid Spacing="3">

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Min Age"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MinAge"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Max Age"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MaxAge"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudDatePicker Label="Min Release"
                                       Variant="Variant.Outlined"
                                       @bind-Date="_query.MinDate"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudDatePicker Label="Max Release"
                                       Variant="Variant.Outlined"
                                       @bind-Date="_query.MaxDate"/>
                    </MudItem>

                </MudGrid>
            </MudStack>
                
            <MudDivider/>

            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Rating Filters</MudText>

                <MudGrid Spacing="3">

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Min Rating"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MinRating"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Max Rating"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MaxRating"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Min Ratings"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MinNbRatings"/>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <MudNumericField Label="Max Ratings"
                                         Variant="Variant.Outlined"
                                         @bind-Value="_query.MaxNbRatings"/>
                    </MudItem>

                </MudGrid>
            </MudStack>
        
            <MudDivider/>

            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Popularity Weight</MudText>

                <MudSlider T="short"
                           Min="1"
                           Max="10"
                           Step="1"
                           ValueLabel="true"
                           @bind-Value="_query.PopularityWeight"/>
            </MudStack>
                
            <MudDivider/>

            <MudStack AlignItems="AlignItems.End">

                <MudButton Variant="Variant.Filled"
                           Size="Size.Large"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           StartIcon="@Icons.Material.Filled.AutoGraph"
                           OnClick="@LoadChart">

                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Large" Indeterminate/>
                    }
                    else
                    {
                        <span>Generate Chart</span>
                    }

                </MudButton>

            </MudStack>
        </MudStack>
    
    </MudPaper>
    
    <MudPaper Class="pa-6 bg-surface glass-card" Elevation="0">

        <MudText Typo="Typo.h5" Class="mb-4">
            Results
        </MudText>

        <AlbumGridView Albums="@_outAlbumList.Items"
                       IsGrouped="false"
                       RatingMode="@(UserClientContext.CurrentUser?.PrefRatingMode ?? 0)"
                       ShowRank 
                       ShowRating="@(UserClientContext.CurrentUser?.PrefShowRatings ?? true)"
                       ShowRatingCount="@(UserClientContext.CurrentUser?.PrefShowRatings ?? true)"
                       Zoom="2"/>

    </MudPaper>
    
</MudContainer>