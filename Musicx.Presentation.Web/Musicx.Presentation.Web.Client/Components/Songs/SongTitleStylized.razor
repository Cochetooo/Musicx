@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

@if (Song.Type == SongType.Normal)
{
    <MudText Typo="Typo.inherit" Color="Color.Default">@Song.Title</MudText>
} 
else if (Song.Type == SongType.Bonus)
{
    <MudText Typo="Typo.inherit" Color="Color.Default">
        @Song.Title
    </MudText>
    
    <MudChip Class="ml-2 my-0" T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Label="@true">
        Bonus
    </MudChip>
}
else if (Song.Type == SongType.Demo)
{
    <MudText Typo="Typo.inherit" Color="Color.Default">
        @Song.Title
    </MudText>
    
    <MudChip Class="ml-2 my-0" T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Label="@true">
        Demo
    </MudChip>
}
else if (Song.Type == SongType.Live)
{
    <MudText Typo="Typo.inherit" Color="Color.Default" Class="text-italic">
        @Song.Title
    </MudText>
    
    <MudChip Class="ml-2 my-0" T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Label="@true">
        Live
    </MudChip>
}

@code {

    [Parameter, EditorRequired] public OutSong Song { get; set; } = null!;

}