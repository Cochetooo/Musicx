@using Musicx.Presentation.Web.Client.Components.Base
@using Musicx.Presentation.Web.Client.Models

<PanelTitle Text="@Title" />
<MudSpacer />
<MudTextField
    Value="@SearchValue"
    ValueChanged="@SearchValueChanged"
    Label="Search"
    OnKeyDown="@OnSearchKeyDown"
    Class="mr-2"
    AdornmentIcon="@Icons.Material.Filled.Search"
    Adornment="Adornment.End"
    Immediate
    Variant="Variant.Outlined" />
<MudSpacer />
<MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Row>
    @if (ViewMode == ViewMode.Normal)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="mr-2"
                       OnClick="@OnAdd" />

        <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="mr-2"
                       OnClick="@OnEnableDeleteMode" />
    }
    else if (ViewMode == ViewMode.Delete)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Close" Class="mr-2"
                       OnClick="@OnEnableNormalMode" />
        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Error" Class="mr-2"
                       OnClick="@OnConfirmDelete" />
    }

    @if (ToolbarActions is not null)
    {
        @ToolbarActions
    }

    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="@OnRefresh" />
</MudStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SearchValue { get; set; } = string.Empty;
    [Parameter, EditorRequired] public EventCallback<string> SearchValueChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<KeyboardEventArgs> OnSearchKeyDown { get; set; }

    [Parameter] public ViewMode ViewMode { get; set; } = ViewMode.Normal;

    [Parameter, EditorRequired] public EventCallback OnAdd { get; set; }
    [Parameter, EditorRequired] public EventCallback OnEnableDeleteMode { get; set; }
    [Parameter, EditorRequired] public EventCallback OnEnableNormalMode { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirmDelete { get; set; }
    [Parameter, EditorRequired] public EventCallback OnRefresh { get; set; }

    [Parameter] public RenderFragment? ToolbarActions { get; set; }
}