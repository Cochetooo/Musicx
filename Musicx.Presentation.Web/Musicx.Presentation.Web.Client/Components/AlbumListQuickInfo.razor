@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

<div @attributes="AdditionalAttributes">
    @switch (Album.ReleaseType)
    {
        case ReleaseType.Ep:
            <MudText Style="font-style: italic;" Color="Color.Secondary">
                @Album.Name
            </MudText>
            break;
        case ReleaseType.Lp:
            <MudText Style="font-weight: bold;" Color="Color.Primary">
                @Album.Name
            </MudText>
            break;
        case ReleaseType.Single:
            <MudText Color="Color.Secondary">
                @Album.Name
            </MudText>
            break;
        case ReleaseType.AdditionalRelease:
        case ReleaseType.Bootleg:
        case ReleaseType.Demo:
        case ReleaseType.DjMix:
        case ReleaseType.Live:
        case ReleaseType.MixTape:
        case ReleaseType.Soundtrack:
        case ReleaseType.Unknown:
        case ReleaseType.VideoClip:
        case ReleaseType.Compilation:
        case null:
            <MudText Color="Color.Tertiary">
                @Album.Name
            </MudText>
            break;
        default:
            throw new ArgumentOutOfRangeException();
    }

    @if (null != Album.OriginalReleaseDate)
    {
        <MudText Color="Color.Secondary" Typo="Typo.body2">@Album.OriginalReleaseDate.Value.Year</MudText>
    }
</div>

@code {

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = null!;
    
    [Parameter, EditorRequired] public OutAlbum Album { get; set; } = null!;

}