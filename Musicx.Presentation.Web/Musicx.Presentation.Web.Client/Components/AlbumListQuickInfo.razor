@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

<div @attributes="AdditionalAttributes">
    @switch (Album.ReleaseType)
    {
        case ReleaseType.Ep:
            <MudText Class="clamped-text-4" Color="Color.Primary">
                @Album.Name 
                <span class="release-type">[@Album.ReleaseType.ToDescriptionString()]</span>
            </MudText>
            break;
        case ReleaseType.Lp:
            <MudText Class="clamped-text-4 text-color-primary">
                @Album.Name
            </MudText>
            break;
        case ReleaseType.Single:
            <MudText Class="clamped-text-4 text-light" Color="Color.Primary">
                @Album.Name 
                <span class="release-type">[@Album.ReleaseType.ToDescriptionString()]</span>
            </MudText>
            break;
        default:
            <MudText Class="clamped-text-4 text-light" Color="Color.Secondary">
                @Album.Name 
                <span class="release-type">[@Album.ReleaseType?.ToDescriptionString()]</span>
            </MudText>
            break;
    }
    
    @if (ShowArtist && Album.Artist is not null)
    {
        <MudText Class="montserrat clamped-text-4" Color="Color.Inherit">
            @Album.Artist.Name
        </MudText>
    }

    @if (null != Album.OriginalReleaseDate)
    {
        <MudText Color="Color.Primary" Typo="Typo.body2">@Album.OriginalReleaseDate.Value.Year</MudText>
    }
</div>

@code {

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = null!;
    
    [Parameter, EditorRequired] public OutAlbum Album { get; set; } = null!;
    [Parameter] public bool ShowArtist { get; set; }

}

<style>
    .release-type {
        color: var(--mud-palette-text-disabled); 
        font-style: normal;
        font-size: 0.8rem;
        vertical-align: center;
    }
</style>