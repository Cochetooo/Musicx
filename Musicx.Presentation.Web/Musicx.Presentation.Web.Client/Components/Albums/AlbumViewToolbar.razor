@using Musicx.Application.Shared.Interfaces.Localization
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Pages.SingleView
@inject ITranslationService T

<MudPaper Class="pa-3 mb-3 glass-paper toolbar-shell">
    <MudStack Wrap="Wrap.Wrap" Style="width: 100%" AlignItems="AlignItems.Center"
              Spacing="2" Row>
        <MudTextField Placeholder="@T["Web.AlbumViewToolbar.SearchReleases"]"
                      Label="@T["Web.Common.Search"]"
                      Immediate
                      Margin="Margin.Dense"
                      T="string"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Value="@_searchText"
                      ValueChanged="@OnInput"
                      Class="toolbar-item toolbar-search"/>

        <MudSelect T="(string, bool)"
                   Value="@SelectedSort"
                   ValueChanged="@OnSortChanged"
                   Label="@T["Web.Common.Sort"]"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Class="toolbar-item toolbar-select">
            <MudSelectItem Value="@(("ReleaseDate", false))">@T["Web.AlbumViewToolbar.ReleaseDate"] ↓</MudSelectItem>
            <MudSelectItem Value="@(("ReleaseDate", true))">@T["Web.AlbumViewToolbar.ReleaseDate"] ↑</MudSelectItem>
            <MudSelectItem Value="@(("Name", false))">@T["Web.AlbumViewToolbar.ReleaseName"] ↓</MudSelectItem>
            <MudSelectItem Value="@(("Name", true))">@T["Web.AlbumViewToolbar.ReleaseName"] ↑</MudSelectItem>
            <MudSelectItem Value="@(("GlobalRating", false))">@T["Web.AlbumViewToolbar.GlobalRating"] ↓</MudSelectItem>
            <MudSelectItem Value="@(("GlobalRating", true))">@T["Web.AlbumViewToolbar.GlobalRating"] ↑</MudSelectItem>
            <MudSelectItem Value="@(("MyRating", false))">@T["Web.AlbumViewToolbar.PersonalRating"] ↓</MudSelectItem>
            <MudSelectItem Value="@(("MyRating", true))">@T["Web.AlbumViewToolbar.PersonalRating"] ↑</MudSelectItem>
            <MudSelectItem Value="@(("NbRating", false))">@T["Web.AlbumViewToolbar.NbRatings"] ↓</MudSelectItem>
            <MudSelectItem Value="@(("NbRating", true))">@T["Web.AlbumViewToolbar.NbRatings"] ↑</MudSelectItem>
        </MudSelect>

        <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="toolbar-item">
            <MudText Typo="Typo.caption" Class="view-mode-label">@T["Web.AlbumViewToolbar.DisplayMode"]</MudText>
            <MudButtonGroup Size="Size.Small" Class="view-mode-group">
                <MudButton StartIcon="@(_viewMode == ReleasesViewMode.List ? Icons.Material.Filled.List : Icons.Material.Outlined.List)"
                           Variant="@GetViewVariant(ReleasesViewMode.List)"
                           Color="@GetViewColor(ReleasesViewMode.List)"
                           Class="view-mode-btn"
                           OnClick="@(() => ChangeView(ReleasesViewMode.List))">
                    @T["Web.Common.List"]
                </MudButton>
                <MudButton StartIcon="@(_viewMode == ReleasesViewMode.Grid ? Icons.Material.Filled.GridView : Icons.Material.Outlined.GridView)"
                           Variant="@GetViewVariant(ReleasesViewMode.Grid)"
                           Color="@GetViewColor(ReleasesViewMode.Grid)"
                           Class="view-mode-btn"
                           OnClick="@(() => ChangeView(ReleasesViewMode.Grid))">
                    Grid
                </MudButton>
                <MudButton StartIcon="@(_viewMode == ReleasesViewMode.Timeline ? Icons.Material.Filled.Timeline : Icons.Material.Outlined.Timeline)"
                           Variant="@GetViewVariant(ReleasesViewMode.Timeline)"
                           Color="@GetViewColor(ReleasesViewMode.Timeline)"
                           Class="view-mode-btn"
                           OnClick="@(() => ChangeView(ReleasesViewMode.Timeline))">
                    Timeline
                </MudButton>
            </MudButtonGroup>
        </MudStack>

        <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="toolbar-item zoom-block">
            <MudText Typo="Typo.caption">Zoom (@_zoom.ToString("0.0")x)</MudText>
            <MudSlider T="double"
                       Min="1.2"
                       Max="2.4"
                       Step="0.1"
                       Value="@_zoom"
                       ValueChanged="@OnZoomValueChanged"
                       Class="toolbar-zoom"/>
        </MudStack>

        <MudSwitch T="bool"
                   Value="@_groupBy"
                   ValueChanged="@OnGroupByValueChanged"
                   Color="Color.Primary"
                   Label="Group by type"
                   Class="toolbar-item"/>

        <MudSelect T="RatingMode"
                   Value="@_selectedRatingMode"
                   ValueChanged="@ChangeRatingMode"
                   Label="Rating Mode"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Class="toolbar-item toolbar-select">
            @foreach (var rm in Enum.GetValues<RatingMode>())
            {
                <MudSelectItem Value="rm">@rm.ToDescriptionString()</MudSelectItem>
            }
        </MudSelect>

        @if (AllowAdd)
        {
            <MudTooltip Text="Add a New Release">
                <MudFab Color="Color.Success"
                        Size="Size.Small"
                        Icon="@Icons.Material.Filled.Add"
                        Label="Add"
                        OnClick="@(() => OnNewRelease.InvokeAsync(null))"
                        Class="toolbar-item add-release-btn"/>
            </MudTooltip>
        }
    </MudStack>
</MudPaper>

<style>
    .toolbar-shell {
        border-radius: 12px;
    }

    .toolbar-item {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .toolbar-item:hover {
        transform: translateY(-1px);
    }

    .toolbar-search {
        min-width: 220px;
    }

    .toolbar-select {
        min-width: 190px;
    }

    .zoom-block {
        min-width: 200px;
    }

    .toolbar-zoom {
        width: 150px;
    }

    .view-mode-label {
        margin-right: 2px;
        opacity: 0.8;
    }

    .view-mode-group {
        border-radius: 10px;
        overflow: hidden;
    }

    .view-mode-btn {
        min-width: 95px;
        transition: transform 0.15s ease, background-color 0.2s ease;
    }

    .view-mode-btn:active {
        transform: scale(0.98);
    }

    .add-release-btn {
        box-shadow: var(--mud-elevation-4);
    }
</style>