@using Musicx.Application.Shared.Helpers
@using Musicx.Presentation.Web.Client.Components.Ratings

@foreach (var group in GroupedAlbums)
{
    <MudPaper Class="pa-4 mb-6 glass-paper">
        @if (IsGrouped)
        {
            <MudText Typo="Typo.h6" Class="montserrat text-bold mb-2">
                @group.Key.ToDescriptionString() (@group.Value.Count)
            </MudText>
            <MudDivider Class="mb-3"/>
        }

        @foreach (var album in group.Value)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1 animate-swipe-right">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudImage Src="@album.ArtworkUrl" Width="@((int)(Zoom * 48))" Height="@((int)(Zoom * 48))"
                              @key="album.ArtworkUrl"
                              Class="rounded-lg mr-3" Elevation="8"/>
                    <MudStack Spacing="1">
                        <MudLink Href="@($"/Album/{album.Id}")">
                            <MudText Typo="Typo.body1" Class="@("color-primary" 
                                                              + (album.Stats is { Average: > 7200, Count: >= 10 } ? " text-extra-bold" : string.Empty))">
                                @album.Name
                                @if (album.EnglishName is not null)
                                {
                                    <MudText Class="color-secondary">
                                        [@album.EnglishName]
                                    </MudText>
                                }
                            </MudText>
                        </MudLink>
                        <MudText Typo="Typo.caption" Class="color-secondary">
                            @if (album.ArtistAlias is not null)
                            {
                                <span class="color-primary">@album.ArtistAlias · </span>
                            }
                            @album.ReleaseType?.ToDescriptionString() ·
                            @album.OriginalReleaseDate?.ToString("yyyy") ·
                            @if (album.SimplifiedGenreName is not null)
                            {
                                <MudChip
                                    Size="Size.Small"
                                    T="string"
                                    Class="py-1 px-3 ma-1 genre-badge"
                                    Style="@GetSimplifiedGenreStyle(album)"
                                    Label="@true">
                                    @album.SimplifiedGenreName
                                </MudChip>
                            }
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="album-list-rating-hover-card">
                    @{
                        var rating = UserRatings?.Items
                            .FirstOrDefault(ur => ur.Album.Id == album.Id)
                            ?.Rating;

                        if (rating is not null)
                        {
                            <EditableRatingBadge
                                Editable="@false"
                                Size="Size.Small"
                                RatingMode="RatingMode"
                                Value="@rating"/>
                        }
                    }

                    <div class="album-list-rating-summary">
                        <DonutRating Rating="@album.Stats?.Average" RatingMode="RatingMode" Size="DonutRatingSize.Small"/>
                        <MudText Typo="Typo.body2" Class="montserrat text-bold" Style="width: 50px; text-align: end;">
                            @(album.Stats?.Count ?? 0)
                            <MudText Typo="Typo.caption" Class="color-secondary">
                                &nbsp;ratings
                            </MudText>
                        </MudText>
                    </div>
                    
                    <div class="album-list-rating-details">
                        <div class="album-list-rating-pill">
                            ⭐ @RatingHelper.GetRatingFormatted(album.Stats?.FanAverage, RatingMode) 
                            <span class="text-light color-secondary">· @(album.Stats?.FanCount ?? 0)</span>
                        </div>
                        <div class="album-list-rating-pill">
                            👤 @RatingHelper.GetRatingFormatted(album.Stats?.NonFanAverage, RatingMode) 
                            <span class="text-light color-secondary">· @(album.Stats?.NonFanCount ?? 0)</span>
                        </div>
                    </div>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-1"/>
        }
    </MudPaper>
}

<style>
    .album-list-rating-hover-card {
        position: relative;
    }

    .album-list-rating-summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .album-list-rating-details {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        max-width: 0;
        overflow: hidden;
        opacity: 0;
        transform: translateX(-4px);
        transition: max-width 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
        white-space: nowrap;
    }

    .album-list-rating-hover-card:hover .album-list-rating-details {
        max-width: 220px;
        opacity: 1;
        transform: translateX(0);
    }

    .album-list-rating-pill {
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.05);
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 700;
    }
</style>