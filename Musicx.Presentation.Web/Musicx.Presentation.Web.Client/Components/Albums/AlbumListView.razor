@using Musicx.Presentation.Web.Client.Components.Ratings

@foreach (var group in GroupedAlbums)
{
    <MudPaper Class="pa-4 mb-6 glass-paper">
        @if (IsGrouped)
        {
            <MudText Typo="Typo.h6" Class="montserrat text-bold mb-2">
                @group.Key.ToDescriptionString() (@group.Value.Count)
            </MudText>
            <MudDivider Class="mb-3"/>
        }

        @foreach (var album in group.Value)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1 animate-swipe-right">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudImage Src="@album.ArtworkUrl" Width="@((int)(Zoom * 48))" Height="@((int)(Zoom * 48))"
                              @key="album.ArtworkUrl"
                              Class="rounded-lg mr-3" Elevation="8"/>
                    <MudStack Spacing="1">
                        <MudLink Href="@($"/Album/{album.Id}")">
                            <MudText Typo="Typo.body1" Class="@("color-primary" 
                                                              + (album.Stats is { Average: > 7200, Count: >= 10 } ? " text-mega-bold" : string.Empty))">
                                @album.Name
                                @if (album.EnglishName is not null)
                                {
                                    <MudText Class="color-secondary">
                                        [@album.EnglishName]
                                    </MudText>
                                }
                            </MudText>
                        </MudLink>
                        <MudText Typo="Typo.caption" Class="color-secondary">
                            @if (album.ArtistAlias is not null)
                            {
                                <span class="color-primary">@album.ArtistAlias · </span>
                            }
                            @album.ReleaseType?.ToDescriptionString() ·
                            @album.OriginalReleaseDate?.ToString("yyyy") ·
                            @if (album.SimplifiedGenreName is not null)
                            {
                                <MudChip
                                    Size="Size.Small"
                                    T="string"
                                    Class="py-1 px-3 ma-1 genre-badge"
                                    Style="@GetSimplifiedGenreStyle(album)"
                                    Label="@true">
                                    @album.SimplifiedGenreName
                                </MudChip>
                            }
                        </MudText>
                    </MudStack>
                </MudStack>

                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    @{
                        var rating = UserRatings?.Items
                            .FirstOrDefault(ur => ur.Album.Id == album.Id)
                            ?.Rating;

                        if (rating is not null)
                        {
                            <EditableRatingBadge
                                Editable="@false"
                                Size="Size.Small"
                                RatingMode="RatingMode"
                                Value="@rating"/>
                        }
                    }

                    <DonutRating Rating="@album.Stats?.Average" RatingMode="RatingMode" Size="DonutRatingSize.Small"/>
                    <MudText Typo="Typo.body2" Class="montserrat text-bold" Style="width: 50px; text-align: end;">
                        @(album.Stats?.Count ?? 0)
                        <MudText Typo="Typo.caption" Class="color-secondary">
                            &nbsp;ratings
                        </MudText>
                    </MudText>
                </MudStack>
            </MudStack>

            <MudDivider Class="my-1"/>
        }
    </MudPaper>
}