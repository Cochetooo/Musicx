@using Musicx.Application.Shared.Helpers
@using Musicx.Presentation.Web.Client.Components.Ratings

@foreach (var group in GroupedAlbums)
{
    <MudPaper Class="pa-4 mb-6 glass-paper">
        @if (IsGrouped)
        {
            <MudText Typo="Typo.h6" Class="montserrat text-bold mb-2">
                @group.Key.ToDescriptionString() (@group.Value.Count)
            </MudText>
            <MudDivider Class="mb-3" />
        }

        <div class="d-flex flex-wrap gap-3 justify-center">
            @for (int rank = 0; rank < group.Value.Count; rank++)
            {
                var currentRank = rank+1;
                var album = group.Value[rank];
                <div class="album-tile pa-2" style="width:@($"{Zoom * 120}px");">
                    <MudTooltip Duration="500" Placement="Placement.Top" Arrow>
                        <ChildContent>
                            <MudLink Href="@($"/Album/{album.Id}")">
                                <div class="album-card">
                                    <div class="album-image-container">
                                        <MudImage Src="@album.ArtworkUrl"
                                                  Alt="@album.Name"
                                                  Class="rounded-lg"
                                                  Elevation="8"
                                                  Width="@((int)(Zoom * 96))"
                                                  Height="@((int)(Zoom * 96))"/>

                                        @if (ShowRank)
                                        {
                                            <div class="album-rank">#@currentRank</div>
                                        }
                                        
                                        @if (ShowRating)
                                        {
                                            <div class="album-donut">
                                                <DonutRating Rating="@album.Stats?.Average"
                                                             RatingMode="RatingMode"
                                                             Size="DonutRatingSize.ExtraSmall" />
                                            </div>
                                        }
                                        
                                        @if (ShowRatingCount)
                                        {
                                            <div class="album-count">
                                                ⭐ @album.Stats?.Count
                                            </div>
                                        }
                                    </div>
                                </div>

                                <AlbumListQuickInfo Album="album" ShowArtist />
                            </MudLink>
                        </ChildContent>
                        <TooltipContent>
                            <MudText Typo="Typo.body1">@album.Name</MudText>
                            <MudText Typo="Typo.caption">@album.OriginalReleaseDate?.ToString("yyyy")</MudText>
                            <DonutRating Rating="@album.Stats?.Average"
                                         RatingMode="RatingMode"
                                         Size="DonutRatingSize.ExtraSmall"/>
                        </TooltipContent>
                    </MudTooltip>
                </div>
            }
        </div>
    </MudPaper>
}