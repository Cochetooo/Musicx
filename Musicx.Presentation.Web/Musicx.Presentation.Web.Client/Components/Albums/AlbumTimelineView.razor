@using Musicx.Presentation.Web.Client.Components.Charts
@inject NavigationManager Navigation

<MudStack Spacing="2">
    <MudStack Row Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.caption" Class="color-secondary">Years / Graduation</MudText>
        <MudSelect T="int" Value="@YearTickInterval" ValueChanged="OnYearTickIntervalChanged" Dense="true" Variant="Variant.Outlined" Style="max-width:130px;">
            <MudSelectItem Value="1">1 year</MudSelectItem>
            <MudSelectItem Value="2">2 years</MudSelectItem>
            <MudSelectItem Value="5">5 years</MudSelectItem>
            <MudSelectItem Value="10">10 years</MudSelectItem>
        </MudSelect>
    </MudStack>
    
    <D3AlbumTimelineChart Albums="@TimelineAlbums" Height="380" YearTickInterval="@YearTickInterval" OnAlbumClicked="OnAlbumClicked" />
</MudStack>