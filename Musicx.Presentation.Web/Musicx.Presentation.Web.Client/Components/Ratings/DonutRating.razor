@using Musicx.Application.Shared.Helpers

<MudChart ChartType="ChartType.Donut"
          InputData="@_ratingData"
          ChartOptions="@_ratingOptions"
          Width="@_donutSize" Height="@_donutSize"
          Class="mud-chart-no-legend">
    <CustomGraphics>
        @{
            var ratingText = RatingHelper.GetRatingFormatted(
                Rating,
                RatingMode
            );
            
            string? top = null;
            string? bottom = null;

            if (RatingMode.IsNumeric())
            {
                ratingText += " / " + RatingMode.GetDenominator();
            }

            if (ratingText.Contains("/"))
            {
                var parts = ratingText.Split('/');
                top = parts[0].Trim();
                bottom = parts.Length > 1 ? parts[1].Trim() : null;
            }
        }
        
        <defs>
            <filter id="shadow">
                <feDropShadow dx="0.2" dy="0.8" stdDeviation="1" flood-opacity="0.8" />
            </filter>
        </defs>
        
        @if (top is null)
        {
            double coeff = 6.0 / ratingText.Length;
            coeff = Math.Max(Math.Min(coeff, 3.0), 0.8);
            int size = (int) (_textSize * coeff);
            
            <text>
                <text class="donut-inner-text"
                      x="50%" y="50%"
                      fill="@_ratingColor"
                      filter="url(#shadow)"
                      dominant-baseline="middle"
                      text-anchor="middle"
                      style="font-family: Montserrat, serif;"
                      font-size="@(size)"
                      font-weight="500">
                    @ratingText
                </text>
            </text>
        }
        else
        {
            <text>
                <text x="50%" y="50%"
                      text-anchor="middle"
                      filter="url(#shadow)"
                      fill="@_ratingColor">
                    @if (Size != DonutRatingSize.ExtraSmall)
                    {
                        <!-- Partie haute -->
                        <tspan x="50%" dy="-0.1em" font-size="@((int)(_textSize * 1.5))" 
                               style="font-family: Montserrat, serif;"
                               font-weight="400">@top</tspan>

                        <!-- Partie basse -->
                        <tspan x="50%" dy="1.7em" style="font-family: Montserrat, serif;" 
                               font-size="@(_textSize)" font-weight="600">/ @bottom</tspan>
                    }
                    else
                    {
                        <!-- Partie haute -->
                        <tspan x="50%" dy="0.4em" 
                               style="font-family: Montserrat, serif;"
                               font-size="@((int)(_textSize * 1.8))" font-weight="500">@top</tspan>
                    }
                </text>
            </text>
        }
    </CustomGraphics>
</MudChart>

<style>
    .mud-chart-no-legend .mud-chart-legend {
        display: none;
    }
</style>