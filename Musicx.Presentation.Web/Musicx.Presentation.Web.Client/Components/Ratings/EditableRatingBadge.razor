@using Musicx.Application.Shared.Helpers
@using Musicx.Contracts.Enums

<MudStack Row AlignItems="AlignItems.Center" Spacing="1">
    @if (IsTextualMode)
    {
        if (Editable && Value is not null)
        {
            <MudChip Style="@GetBadgeStyle(Value)"
                     OnClick="@ToggleCollapse"
                     OnClose="@DeleteRating"
                     Variant="Variant.Filled"
                     Label="true"
                     Size="@Size"
                     Class="glass-card"
                     T="string">
                @RatingHelper.GetRatingFormatted(Value, RatingMode)
            </MudChip>
        }
        else
        {
            <MudChip Style="@GetBadgeStyle(Value)"
                     OnClick="@ToggleCollapse"
                     Variant="@(Editable ? Variant.Filled : Variant.Outlined)"
                     Size="@Size"
                     Label="true"
                     Class="glass-card"
                     T="string">
                @RatingHelper.GetRatingFormatted(Value, RatingMode)
            </MudChip>
        }

        if (Editable)
        {
            <MudIconButton Icon="@(_isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="@ToggleCollapse" />
        }
    }
    else if (IsNumericMode)
    {
        @if (!_isEditing)
        {
            if (Editable && Value is not null)
            {
                <MudChip Style="@GetBadgeStyle(Value)"
                         OnClick="@ToggleEdit"
                         OnClose="@DeleteRating"
                         Variant="Variant.Filled"
                         Label="true"
                         Class="glass-card"
                         Size="@Size"
                         T="string">
                    @RatingHelper.GetRatingFormatted(Value, RatingMode)
                </MudChip>
            }
            else
            {
                <MudChip Style="@GetBadgeStyle(Value)"
                         OnClick="@ToggleEdit"
                         Variant="@(Editable ? Variant.Filled : Variant.Outlined)"
                         Class="glass-card"
                         Label="true"
                         Size="@Size"
                         T="string">
                    @RatingHelper.GetRatingFormatted(Value, RatingMode)
                </MudChip>
            }
        }
        else
        {
            <MudNumericField
                T="int?"
                @bind-Value="_editingValue"
                Min="0"
                Max="@MaxValue"
                Style="max-width: 120px;"
                Immediate
                Variant="Variant.Outlined"
                Class="w-20 editable-rating-input"
                OnBlur="@CancelEdit"
                OnKeyDown="@HandleNumericKey"/>
        }
    }
    else if (RatingMode == RatingMode.RatingStars)
    {
        <MudRating @bind-SelectedValue="StarValue"
                   MaxValue="10"
                   ReadOnly="@(!Editable)"
                   Color="Color.Primary"
                   Size="@Size" />
    }
    
    @if (IsTextualMode && Editable)
    {
        <MudCollapse Expanded="@_isOpen">
            <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                @foreach (var option in GetTextualOptions())
                {
                    var optionValue = option.ToInt();
                    <MudChip Style="@GetBadgeStyle(optionValue, false)"
                             Selected="@(Value == optionValue)"
                             OnClick="@(() => SetTextual(option))"
                             Label="true"
                             Variant="Variant.Filled"
                             T="string">
                        @option.ToString().SplitCamelCase()
                    </MudChip>
                }
            </MudStack>
        </MudCollapse>
    }
</MudStack>