@using Musicx.Application.Shared.Utilities
@using Musicx.Contracts.Enums

<MudStack Row AlignItems="AlignItems.Center" Spacing="1">
    @if (IsTextualMode)
    {
        if (Editable && Value is not null)
        {
            <MudChip Style="@($"background-color: {RatingHelper.GetColorForRating(Value)};color:white;min-width:80px;")"
                     OnClick="@ToggleCollapse"
                     OnClose="@DeleteRating"
                     Variant="Variant.Filled"
                     Size="@Size"
                     Class="glass-card"
                     T="string">
                @RatingHelper.GetRatingFormatted(Value, RatingMode)
            </MudChip>
        }
        else
        {
            <MudChip Style="@($"background-color: {RatingHelper.GetColorForRating(Value)};color:white;min-width:80px;")"
                     OnClick="@ToggleCollapse"
                     Variant="@(Editable ? Variant.Filled : Variant.Outlined)"
                     Size="@Size"
                     Class="glass-card"
                     T="string">
                @RatingHelper.GetRatingFormatted(Value, RatingMode)
            </MudChip>
        }
        
        <MudIconButton Icon="@(_isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       Color="Color.Default"
                       Size="Size.Small"
                       OnClick="@ToggleCollapse" />
    }
    else if (IsNumericMode)
    {
        @if (!_isEditing)
        {
            if (Editable && Value is not null)
            {
                <MudChip Style="@($"background-color: {RatingHelper.GetColorForRating(Value)};color:white;min-width:80px;")"
                         OnClick="@ToggleEdit"
                         OnClose="@DeleteRating"
                         Variant="Variant.Filled"
                         Class="glass-card"
                         Size="@Size"
                         T="string">
                    @RatingHelper.GetRatingFormatted(Value, RatingMode)
                </MudChip>
            }
            else
            {
                <MudChip Style="@($"background-color: {RatingHelper.GetColorForRating(Value)};color:white;min-width:80px;")"
                         OnClick="@ToggleEdit"
                         Variant="@(Editable ? Variant.Filled : Variant.Outlined)"
                         Class="glass-card"
                         Size="@Size"
                         T="string">
                    @RatingHelper.GetRatingFormatted(Value, RatingMode)
                </MudChip>
            }
        }
        else
        {
            <MudNumericField
                T="int?"
                @bind-Value="_editingValue"
                Min="0"
                Max="@MaxValue"
                Style="max-width: 120px;"
                Immediate
                Variant="Variant.Outlined"
                Class="w-20"
                OnBlur="@CancelEdit"
                OnKeyDown="@HandleNumericKey"/>
        }
    }
    else if (RatingMode == RatingMode.RatingStars)
    {
        <MudRating @bind-SelectedValue="StarValue"
                   MaxValue="10"
                   ReadOnly="@(!Editable)"
                   Color="Color.Primary"
                   Size="@Size" />
    }
    
    @if (IsTextualMode)
    {
        <MudCollapse Expanded="@_isOpen">
            <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                @foreach (var option in GetTextualOptions())
                {
                    var optionValue = MapTextual(option);
                    <MudChip Style="@($"background-color:{RatingHelper.GetColorForRating(optionValue)};color:white;")"
                             Selected="@(Value == optionValue)"
                             OnClick="@(() => SetTextual(option))"
                             Variant="Variant.Filled"
                             T="string">
                        @SplitCamelCase(option.ToString())
                    </MudChip>
                }
            </MudStack>
        </MudCollapse>
    }
</MudStack>