@using Musicx.Application.Shared.Utilities
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

@if (Clickable)
{
    <MudLink Href="@($"/Genre/{Genre.Id}")">
        @if (Closable)
        {
            <MudChip T="string" Size="@Size" Icon="@GetChipIcon()" Style="@GetChipStyle(Genre)" Class="@GetChipClass()" OnClose="@OnClose">
                @Genre.Name
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="@Size" Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" Class="@GetChipClass()">
                @Genre.Name
            </MudChip>
        }
    </MudLink>
}
else
{
    @if (Closable)
    {
        <MudChip T="string" Size="@Size" Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" Class="@GetChipClass()" OnClose="@OnClose">
            @Genre.Name
        </MudChip>
    }
    else
    {
        <MudChip T="string" Size="@Size" Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" Class="@GetChipClass()">
            @Genre.Name
        </MudChip>
    }
}


@code {

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = null!;
    
    [Parameter, EditorRequired] public OutGenre Genre { get; set; } = null!;
    [Parameter] public bool Influence { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetChipStyle(OutGenre genre)
    {
        var background = genre.Color ?? ColorHelper.DarkColor;
        var textColor = ColorHelper.IsColorLight(background)
            ? ColorHelper.DarkColor
            : "#ffffff";

        if (Influence)
        {
            return $"background-color:{background}; opacity: 0.75; color:{textColor}; font-style: italic;";
        }
        
        return Genre.Type switch
        {
            GenreType.Basic => $"background-color:{background}; color:{textColor}; font-weight:600;",
            GenreType.Scene => $"border:1px solid {background}; color:{background}; background:{textColor}; font-weight: bold",
            GenreType.Movement => $"border:1px dashed {background}; color:{background}; background:{textColor}; font-weight: bold",
            GenreType.Descriptor => $"background-color:{background}; color:{textColor}; opacity:0.85; border-radius:16px;",
            _ => $"background-color:{background}; color:{textColor};"
        };
    }
    
    private string GetChipClass()
    {
        return Genre.Type switch
        {
            GenreType.Basic => "chip-basic montserrat hover-scale",
            GenreType.Scene => "chip-scene montserrat hover-fade",
            GenreType.Movement => "chip-movement montserrat hover-fade",
            GenreType.Descriptor => "chip-descriptor montserrat hover-pulse",
            _ => "chip-default montserrat"
        };
    }
    
    private string GetChipIcon()
    => Genre.Type switch
        {
            GenreType.Basic => Icons.Material.Filled.Label,
            GenreType.Scene => Icons.Material.Filled.Language,
            GenreType.Movement => Icons.Material.Filled.Album,
            GenreType.Descriptor => Icons.Material.Filled.TheaterComedy,
            _ => ""
        };
}