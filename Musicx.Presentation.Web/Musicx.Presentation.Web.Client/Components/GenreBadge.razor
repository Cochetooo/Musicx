@using Musicx.Application.Shared.Utilities
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

@if (Clickable)
{
    <MudLink Href="@($"/Genre/{Genre.Id}")">
        @if (Closable)
        {
            <MudChip T="string" Size="@Size" 
                     Icon="@GetChipIcon()" Style="@GetChipStyle(Genre)" 
                     Class="@GetChipClass()" OnClose="@OnClose"
                     Label="@true">
                @Genre.Name
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="@Size" 
                     Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                     Class="@GetChipClass()"
                     Label="@true">
                @Genre.Name
            </MudChip>
        }
    </MudLink>
}
else
{
    @if (Closable)
    {
        <MudChip T="string" Size="@Size" 
                 Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                 Class="@GetChipClass()" OnClose="@OnClose"
                 Label="@true">
            @Genre.Name
        </MudChip>
    }
    else
    {
        <MudChip T="string" Size="@Size" 
                 Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                 Class="@GetChipClass()"
                 Label="@true">
            @Genre.Name
        </MudChip>
    }
}


@code {

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = null!;
    
    [Parameter, EditorRequired] public OutGenre Genre { get; set; } = null!;
    [Parameter] public bool Influence { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetChipStyle(OutGenre genre)
    {
        var background = genre.Color ?? ColorHelper.DarkColor;
        var transparentBackground = ColorHelper.ToRgba(background, 0.5);
        
        var textColor = ColorHelper.IsColorLight(background)
            ? ColorHelper.DarkColor
            : "#ffffff";

        var gradient = $"linear-gradient(to right, {transparentBackground}, {background} 5%, {background} 95%, {transparentBackground})";

        if (Influence)
        {
            return $"background:{gradient}; opacity: 0.75; color:{textColor}; font-style: italic;";
        }
        
        return Genre.Type switch
        {
            GenreType.Basic => $"background:{gradient}; color:{textColor}; font-weight:600;",
            GenreType.Scene => $"border:1px solid {gradient}; color:{textColor}; background:{gradient}; font-weight: bold",
            GenreType.Movement => $"border:1px dashed {gradient}; color:{textColor}; background:{gradient}; font-weight: bold",
            GenreType.Descriptor => $"background:{gradient}; color:{textColor}; opacity:0.85; border-radius:16px;",
            _ => $"background:{gradient}; color:{textColor};"
        };
    }
    
    private string GetChipClass()
    {
        return Genre.Type switch
        {
            GenreType.Basic => "chip-basic montserrat genre-badge animate-hover-up",
            GenreType.Scene => "chip-scene montserrat genre-badge animate-hover-up",
            GenreType.Movement => "chip-movement montserrat genre-badge animate-hover-up",
            GenreType.Descriptor => "chip-descriptor montserrat genre-badge animate-hover-up",
            _ => "chip-default montserrat animate-hover-up"
        };
    }
    
    private string GetChipIcon()
    => Genre.Type switch
        {
            GenreType.Basic => Icons.Material.Filled.Label,
            GenreType.Scene => Icons.Material.Filled.Language,
            GenreType.Movement => Icons.Material.Filled.Album,
            GenreType.Descriptor => Icons.Material.Filled.TheaterComedy,
            _ => ""
        };
}