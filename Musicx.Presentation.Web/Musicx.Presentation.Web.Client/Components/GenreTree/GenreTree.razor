@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@inject ILoggerFactory LoggerFactory

<div class="genre-tree">
    @foreach (var genre in RootGenres)
    {
        @if (TypeFilter is null || 
             ((TypeFilter == GenreType.Descriptor || TypeFilter == GenreType.Scene)
            && (genre.Type == GenreType.Basic || genre.Type == GenreType.Descriptor || genre.Type == GenreType.Scene))
            || TypeFilter == genre.Type
        )
        {
            <GenreTreeNode Genre="genre"
                           Checkable="@Checkable"
                           LoadChildrenAsync="@LoadChildrenAsync"
                           OnSelectionChanged="@(o => OnSelectionChanged(o.Item1, o.Item2))" />
        }
    }
</div>

@code {

    private ILogger _logger = null!;

    [Parameter] public IReadOnlyList<OutGenre> RootGenres { get; set; } = [];
    [Parameter] public bool Checkable { get; set; }
    [Parameter] public GenreType? TypeFilter { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<OutGenre>> SelectedGenresChanged { get; set; }

    private HashSet<OutGenre> _selected = [];

    protected override void OnInitialized()
    {
        _logger = LoggerFactory.CreateLogger(nameof(GenreTree));
    }

    private async Task OnSelectionChanged(OutGenre genre, bool selected)
    {
        if (selected)
        {
            _selected.Add(genre);
        }
        else
        {
            _selected.Remove(genre);
        }

        await SelectedGenresChanged.InvokeAsync(_selected.ToList());
    }
    
    [Parameter] public Func<OutGenre, Task<IReadOnlyList<OutGenre>>>? LoadChildrenAsync { get; set; }

}