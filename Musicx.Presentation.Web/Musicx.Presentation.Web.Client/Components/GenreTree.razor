@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Responses

@inject IFindInUseCase<OutGenre> UcFindIn

<TreeView @ref="TreeView"
          Nodes="Genres"
          GetChildNodesAsync="LoadChildrenAsync"
          HasChildNodes="@(g => g.Children is not null)"
          Virtualize>
    <NodeContent>
        <Badge Style="@GetColor(context)" Margin="Margin.Is2.FromBottom" Pill>
            @if (Checkable)
            {
                <Check Margin="Margin.Is2.FromEnd" 
                       TValue="bool"
                       Checked="@SelectedGenres.Contains(context)"
                       CheckedChanged="@(check => OnCheckChanged(context, check))"/>
            }
            
            @context.Name
        </Badge>
    </NodeContent>
</TreeView>

@code {

    private TreeView<OutGenre> TreeView { get; set; } = null!;

    [Parameter] public List<OutGenre> SelectedGenres { get; set; } = [];
    [Parameter] public EventCallback<List<OutGenre>> SelectedGenresChanged { get; set; }
    [Parameter] public IReadOnlyList<OutGenre> Genres { get; set; } = [];
    [Parameter] public bool Checkable { get; set; }

    private async Task<IEnumerable<OutGenre>> LoadChildrenAsync(OutGenre genre)
    {
        if (genre.Children != null)
        {
            return await UcFindIn.ExecuteAsync(genre.Children.Select(g => g.Id), "children");
        }

        return [];
    }

    private string GetColor(OutGenre genre)
    {
        var background = genre.Color ?? ColorHelper.DarkColor;
        var textColor = ColorHelper.IsColorLight(background)
            ? ColorHelper.DarkColor
            : "white";
        
        return $"background-color: {background}; color: {textColor}; font-weight: bold;";
    }

    private async Task OnCheckChanged(OutGenre genre, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedGenres.Contains(genre))
                SelectedGenres.Add(genre);
        }
        else
        {
            SelectedGenres.Remove(genre);
        }

        await SelectedGenresChanged.InvokeAsync(SelectedGenres);
    }

}