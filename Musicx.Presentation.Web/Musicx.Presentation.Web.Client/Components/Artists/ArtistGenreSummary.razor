@using Musicx.Contracts.Dto.Responses.Specifics.Artists
@using Musicx.Contracts.Enums

<div class="artist-genre-summary">
    @if (HasOverflow)
    {
        <div class="artist-genre-summary-toolbar">
            <MudText Typo="Typo.caption" Class="artist-genre-summary-caption">
                Genre palette
            </MudText>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Size="Size.Small"
                       Class="artist-genre-summary-toggle"
                       OnClick="ToggleExpanded">
                @(_expanded ? "Show less" : "Show more")
            </MudButton>
        </div>
    }

    <div class="artist-genre-grid @(_expanded ? "is-expanded" : string.Empty)">
        @foreach (var section in Sections)
        {
            var stats = GetVisibleStats(section);

            if (0 == stats.Count)
            {
                continue;
            }

            var maxCount = GetMaxCount(stats);

            <section class="@(section.CardClass)">
                <header class="artist-genre-section-header">
                    <span class="artist-genre-section-title">@(section.Title)</span>
                </header>

                <div class="artist-genre-tags">
                    @foreach (var stat in stats)
                    {
                        <a class="@GetItemClass(section.Kind, stat, maxCount)"
                           href="@($"/Genre/{stat.Genre.Id}")"
                           title="@GetItemTitle(stat)"
                           style="@GetTagStyle(section.Kind, stat, maxCount)">
                            <span class="artist-genre-name">@GetDisplayName(stat)</span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
</div>