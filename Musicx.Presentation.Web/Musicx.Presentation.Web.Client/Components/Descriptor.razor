<ListGroupItem Background="Background.Primary">
    <Paragraph Margin="Margin.Is2.FromBottom" TextColor="TextColor.Muted">
        @DescriptorLabel
    </Paragraph>
    <Blazorise.Text TextWeight="TextWeight.Bold" TextColor="TextColor.Primary">
        @DescriptorValue
    </Blazorise.Text>
</ListGroupItem>

@code {

    [Parameter, EditorRequired] public RenderFragment? DescriptorLabel { get; set; }
    [Parameter, EditorRequired] public RenderFragment? DescriptorValue { get; set; }

}