<MudListItem T="RenderFragment">
    <MudText Class="text-color-secondary" Typo="Typo.body2">
        @DescriptorLabel
    </MudText>
    <MudText Class="text-color-primary text-bold" Typo="Typo.body1">
        @DescriptorValue
    </MudText>
</MudListItem>

@code {

    [Parameter, EditorRequired] public RenderFragment? DescriptorLabel { get; set; }
    [Parameter, EditorRequired] public RenderFragment? DescriptorValue { get; set; }

}