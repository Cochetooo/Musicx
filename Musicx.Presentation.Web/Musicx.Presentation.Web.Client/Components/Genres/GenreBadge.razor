@using Musicx.Application.Shared.Utilities
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

@if (Clickable)
{
    <MudLink Href="@($"/Genre/{Genre.Id}")" @attributes="AdditionalAttributes">
        @if (Closable)
        {
            <MudChip T="string" Size="@Size" 
                     Icon="@GetChipIcon()" Style="@GetChipStyle(Genre)" 
                     Class="@GetChipClass()" OnClose="@OnClose"
                     Label="@true">
                @Genre.CanonicalName
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="@Size" 
                     Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                     Class="@GetChipClass()"
                     Label="@true">
                @Genre.CanonicalName
            </MudChip>
        }
    </MudLink>
}
else
{
    @if (Closable)
    {
        <MudChip T="string" Size="@Size"
                 @attributes="AdditionalAttributes"
                 Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                 Class="@GetChipClass()" OnClose="@OnClose"
                 Label="@true">
            @Genre.CanonicalName
        </MudChip>
    }
    else
    {
        <MudChip T="string" Size="@Size" 
                 @attributes="AdditionalAttributes"
                 Style="@GetChipStyle(Genre)" Icon="@GetChipIcon()" 
                 Class="@GetChipClass()"
                 Label="@true">
            @Genre.CanonicalName
        </MudChip>
    }
}


@code {

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = null!;
    
    [Parameter, EditorRequired] public OutGenre Genre { get; set; } = null!;
    [Parameter] public bool Influence { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public EventCallback OnClose { get; set; }

    private string GetChipStyle(OutGenre genre)
    {
        var background = genre.Color ?? ColorHelper.DarkColor;
        var transparentBackground = ColorHelper.ToRgba(background, 0.45);
        
        var textColor = ColorHelper.IsColorLight(background)
            ? ColorHelper.DarkColor
            : "#ffffff";
        
        var fontSize = Size switch
        {
            Size.Small => "14px",
            Size.Medium => "16px",
            Size.Large => "18px",
            _ => "16px"
        } ;

        var gradient = $"linear-gradient(135deg, {background}, {transparentBackground})";

        if (Influence)
        {
            return $"background:{gradient}; opacity: 0.75; color:{textColor}; font-weight: 200; font-size: {fontSize};";
        }
        
        return Genre.Type switch
        {
            GenreType.Subgenre => $"background:{gradient}; color:{textColor}; font-weight:500; font-size: {fontSize};",
            GenreType.Scene => $"border:1px solid {gradient}; color:{textColor}; background:{gradient}; font-weight: 400; font-size: {fontSize};",
            GenreType.Movement => $"border:1px dashed {gradient}; color:{textColor}; background:{gradient}; font-weight: 400; font-size: {fontSize};",
            GenreType.Descriptor => $"background:{gradient}; color:{textColor}; opacity:0.85; border-radius:16px; font-size: 400; font-size: {fontSize};",
            _ => $"background:{gradient}; color:{textColor}; font-size: {fontSize};"
        };
    }

    private string GetChipClass()
        => Influence
            ? "genre-badge animate-hover-up"
            : "genre-badge animate-hover-up animate__animated animate__bounceIn";
    
    private string GetChipIcon()
    => Genre.Type switch
        {
            GenreType.Subgenre => Icons.Material.Filled.Label,
            GenreType.Scene => Icons.Material.Filled.Language,
            GenreType.Movement => Icons.Material.Filled.Album,
            GenreType.Descriptor => Icons.Material.Filled.TheaterComedy,
            _ => ""
        };
}