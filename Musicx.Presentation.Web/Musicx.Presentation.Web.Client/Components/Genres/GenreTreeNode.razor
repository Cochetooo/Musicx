@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Dto.Responses.Specifics.Genres

<div class="genre-node">
    <div class="genre-node-header">
        @if (Expandable)
        {
            <button class="expand-btn" @onclick="ToggleExpand">
                @if (Loading)
                {
                    <MudProgressCircular Indeterminate Size="Size.Small" Class="loading-spinner" />
                } 
                else if (Expanded)
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.ExpandMore" />
                }
                else
                {
                    <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.ChevronRight" />
                }
            </button>
        }
        else
        {
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Remove" />
        }
        
        @if (Addable)
        {
            <MudIconButton
                Icon="@Icons.Material.Filled.Add"
                Color="Color.Primary"
                Disabled="@IsSelected"
                OnClick="@(async () => await OnSelectionChange(true))"/>
        }
        
        @if (Checkable)
        {
            <MudCheckBox T="bool" Size="Size.Small"
                         Value="@IsSelected"
                         ValueChanged="@(async v => await OnSelectionChange(v))" />
        }
        
        <GenreBadge Size="Size.Small" Genre="@Genre" />
    </div>
    
    @if (Expanded)
    {
        <div class="genre-node-children animate-expand">
            @if (Children != null)
            {
                @foreach (var child in Children)
                {
                    <GenreTreeNode Genre="child.Relation"
                                   Checkable="Checkable"
                                   Addable="Addable"
                                   LoadChildrenAsync="LoadChildrenAsync"
                                   OnSelectionChanged="OnSelectionChanged" />
                }
            }
        </div>
    }
</div>

@code {

    [Parameter] public OutGenre Genre { get; set; } = null!;
    [Parameter] public bool Checkable { get; set; }
    [Parameter] public bool Addable { get; set; }
    [Parameter] public Func<OutGenre, Task<IReadOnlyList<GenreClosureNode>>>? LoadChildrenAsync { get; set; }
    [Parameter] public EventCallback<(OutGenre, bool)> OnSelectionChanged { get; set; }
    
    private bool Expanded { get; set; }
    private bool Loading { get; set; }
    private bool IsSelected { get; set; }
    
    private IReadOnlyList<GenreClosureNode>? Children { get; set; }

    private bool Expandable => Genre.Children?.Any() ?? false;

    private async Task ToggleExpand()
    {
        if (!Expandable)
        {
            return;
        }

        if (!Expanded)
        {
            Loading = true;
            await InvokeAsync(StateHasChanged);

            if (LoadChildrenAsync != null)
            {
                Children = await LoadChildrenAsync(Genre);
            }
            else
            {
                Children = Genre.Children;
            }

            Loading = false;
            Expanded = true;
        }
        else
        {
            Expanded = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSelectionChange(bool selected)
    {
        IsSelected = selected;
        await OnSelectionChanged.InvokeAsync((Genre, selected));
    }

}