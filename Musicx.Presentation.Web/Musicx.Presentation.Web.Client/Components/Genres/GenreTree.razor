@using Musicx.Contracts.Dto.Responses.Genre
@using Musicx.Contracts.Dto.Responses.Specifics.Genres
@using Musicx.Contracts.Enums

<div class="genre-tree">
    @foreach (var genre in RootGenres)
    {
        if (AllowedTypes is null || AllowedTypes.Contains(genre.Type))
        {
            <GenreTreeNode Genre="genre"
                           Checkable="@Checkable"
                           Addable="@Addable"
                           LoadChildrenAsync="@LoadChildrenAsync"
                           OnSelectionChanged="@(o => OnSelectionChanged(o.Item1, o.Item2))" />
        }
    }
</div>

@code {
    
    [Parameter] public IReadOnlyList<OutGenre> RootGenres { get; set; } = [];
    [Parameter] public bool Checkable { get; set; }
    [Parameter] public bool Addable { get; set; }
    [Parameter] public IReadOnlyCollection<GenreType>? AllowedTypes { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<OutGenre>> SelectedGenresChanged { get; set; }
    [Parameter] public Func<OutGenre, Task<IReadOnlyList<GenreClosureNode>>>? LoadChildrenAsync { get; set; }

    private readonly HashSet<long> _selectedGenreIds = [];
    private readonly List<OutGenre> _selectedGenres = [];

    private async Task OnSelectionChanged(OutGenre genre, bool selected)
    {
        if (selected)
        {
            if (_selectedGenreIds.Add(genre.Id))
            {
                _selectedGenres.Add(genre);
            }
        }
        else if (_selectedGenreIds.Remove(genre.Id))
        {
            _selectedGenres.RemoveAll(g => g.Id == genre.Id);
        }

        await SelectedGenresChanged.InvokeAsync(_selectedGenres.ToList());
    }

}