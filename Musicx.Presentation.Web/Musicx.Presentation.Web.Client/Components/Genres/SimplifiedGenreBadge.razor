@using Musicx.Application.Shared.Helpers
@using Musicx.Presentation.Web.Client.Helpers

<span class="simplified-genre-badge" style="@GetStyle()" @attributes="AdditionalAttributes">
    @Label
</span>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> AdditionalAttributes { get; set; } = new();

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string? Color { get; set; } = string.Empty;

    private string GetStyle() => GenreBadgeStyleBuilder.Build(Color);
}