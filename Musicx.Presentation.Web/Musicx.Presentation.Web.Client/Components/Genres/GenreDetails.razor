@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests.Album
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@inject IFindOneByIdService<InAlbum, OutAlbum> UcGetAlbum

@if (_isLoading)
{
    <MudProgressCircular Indeterminate />
}
else
{
    if (Descriptor)
    {
        <Descriptor>
            <DescriptorLabel>
                🎸 Genres
            </DescriptorLabel>
            <DescriptorValue>
                <div class="animation-flip-container">
                    <div class="animation-flip-card @(DetailedView ? "animation-flipped-back" : "animation-flipped-front")">
                        @if (!DetailedView && Album.SimplifiedGenreName is not null && Album.SimplifiedGenreColor is not null)
                        {
                            <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge"
                                     T="string?"
                                     Size="@Size"
                                     Label="@true"
                                     Style="@GetSimplifiedGenreStyle(Album)">
                                @Album.SimplifiedGenreName
                            </MudChip>
                        }
                        else if (DetailedView && Album.PrimaryGenres is not null && 0 < Album.PrimaryGenres.Count)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var genre in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Subgenre || g.Genre.Type == GenreType.Fusion))
                                {
                                    <GenreBadge Genre="@genre.Genre" Size="@Size" Clickable/>
                                }
                            </div>
                        }
                    </div>
                </div>
            </DescriptorValue>
        </Descriptor>

        <MudCollapse Expanded="@DetailedView">
            @if (Album.InfluenceGenres is not null && 0 < Album.InfluenceGenres.Count)
            {
                <Descriptor>
                    <DescriptorLabel>
                        🎶 Influences
                    </DescriptorLabel>
                    <DescriptorValue>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var genre in Album.InfluenceGenres)
                            {
                                <GenreBadge Size="@Size" Genre="@genre.Genre" Influence Clickable />
                            }
                        </div>
                    </DescriptorValue>
                </Descriptor>
            }
            
            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Scene))
            {
                <Descriptor>
                    <DescriptorLabel>
                        🌍 Scenes
                    </DescriptorLabel>
                    <DescriptorValue>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var scene in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Scene))
                            {
                                <GenreBadge Size="@Size" Genre="@scene.Genre" Clickable />
                            }
                        </div>
                    </DescriptorValue>
                </Descriptor>
            }
            
            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Movement))
            {
                <Descriptor>
                    <DescriptorLabel>
                        🗣️ Movements
                    </DescriptorLabel>
                    <DescriptorValue>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var movement in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Movement))
                            {
                                <GenreBadge Size="@Size" Genre="@movement.Genre" Clickable />
                            }
                        </div>
                    </DescriptorValue>
                </Descriptor>
            }

            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Descriptor))
            {
                <Descriptor>
                    <DescriptorLabel>
                        Descriptors
                    </DescriptorLabel>
                    <DescriptorValue>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var descriptor in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Descriptor))
                            {
                                <GenreBadge Size="@Size" Genre="@descriptor.Genre" />
                            }
                        </div>
                    </DescriptorValue>
                </Descriptor>
            }
        </MudCollapse>
    }
    else
    {
        <div class="animation-flip-container">
            <div class="animation-flip-card @(DetailedView ? "animation-flipped-back" : "animation-flipped-front")">
                @if (!DetailedView && Album.SimplifiedGenreName is not null && Album.SimplifiedGenreColor is not null)
                {
                    <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge"
                             T="string?"
                             Size="@Size"
                             Label="@true"
                             Style="@GetSimplifiedGenreStyle(Album)">
                        @Album.SimplifiedGenreName
                    </MudChip>
                }
                else if (DetailedView && Album.PrimaryGenres is not null && 0 < Album.PrimaryGenres.Count)
                {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge animate-hover-up" T="string" Size="@Size"
                                 Label="true" Color="Color.Surface" Style="width: 150px;">
                            🟡 Genres
                        </MudChip>
                        
                        @foreach (var genre in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Subgenre || g.Genre.Type == GenreType.Fusion))
                        {
                            <GenreBadge Genre="@genre.Genre" Size="@Size" Clickable/>
                        }
                    </div>
                }
            </div>
        </div>
        
        <MudCollapse Expanded="@DetailedView">
            @if (Album.InfluenceGenres is not null && 0 < Album.InfluenceGenres.Count)
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge animate-hover-up" T="string" Size="@Size"
                             Label="true" Color="Color.Dark" Style="width: 150px;">
                        💽 Influences
                    </MudChip>
                    
                    @foreach (var genre in Album.InfluenceGenres)
                    {
                        <GenreBadge Size="@Size" Genre="@genre.Genre" Influence Clickable/>
                    }
                </div>
            }
            
            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Scene))
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge animate-hover-up" T="string" Size="@Size"
                             Label="true" Color="Color.Dark" Style="width: 150px;">
                        🌍 Scene
                    </MudChip>
                    
                    @foreach (var scene in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Scene))
                    {
                        <GenreBadge Size="@Size" Genre="@scene.Genre" Clickable/>
                    }
                </div>
            }
            
            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Movement))
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge animate-hover-up" T="string" Size="@Size"
                             Label="true" Color="Color.Dark" Style="width: 150px;">
                        🎉 Movement
                    </MudChip>
                    
                    @foreach (var movement in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Movement))
                    {
                        <GenreBadge Size="@Size" Genre="@movement.Genre" Clickable/>
                    }
                </div>
            }

            @if (Album.PrimaryGenres is not null && Album.PrimaryGenres.Any(g => g.Genre.Type == GenreType.Descriptor))
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    <MudChip Class="montserrat py-1 px-3 ma-1 genre-badge animate-hover-up" T="string" Size="@Size"
                             Label="true" Color="Color.Dark" Style="width: 150px;">
                        🎭 Descriptors
                    </MudChip>
                    
                    @foreach (var descriptor in Album.PrimaryGenres.Where(g => g.Genre.Type == GenreType.Descriptor))
                    {
                        <GenreBadge Size="@Size" Genre="@descriptor.Genre"/>
                    }
                </div>
            }
        </MudCollapse>
    }
}