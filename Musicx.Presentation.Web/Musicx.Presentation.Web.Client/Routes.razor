<ThemeProvider Theme="@_darkTheme">
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)"/>
            <FocusOnNavigate RouteData="routeData" Selector="h1"/>
        </Found>
    </Router>
</ThemeProvider>

@code {

    private readonly Theme _darkTheme = new()
    {
        BackgroundOptions = new ThemeBackgroundOptions
        {
            Secondary = "#0baad6",
            Primary = "#136da9",
            Success = "#1ed67a",
            Info = "#87becc",
            Danger = "#c9163a",
            Warning = "#d4ca11",
        },
        BodyOptions = new ThemeBodyOptions
        {
            BackgroundColor = "#242a30",
            TextColor = "#ffffff"
        },
        ColorOptions = new ThemeColorOptions
        {
            Secondary = "#0baad6",
            Primary = "#136da9",
            Success = "#1ed67a",
            Info = "#87becc",
            Danger = "#c9163a",
            Warning = "#d4ca11",
            Dark = "#cdcdcd",
            Light = "#111111"
        },
        InputOptions = new ThemeInputOptions
        {
            CheckColor = "#ffffff",
            Color = "#ffffff",
            SliderColor = "#ffffff"
        },
        ListGroupItemOptions = new ThemeListGroupItemOptions
        {
            BackgroundLevel = 9,
            ColorLevel = -6
        },
        TextColorOptions = new ThemeTextColorOptions
        {
            Secondary = "#0baad6",
            Primary = "#136da9",
            Success = "#1ed67a",
            Info = "#87becc",
            Danger = "#c9163a",
            Warning = "#d4ca11",
            Dark = "#cdcdcd",
            Light = "#111111"
        },
    };

}