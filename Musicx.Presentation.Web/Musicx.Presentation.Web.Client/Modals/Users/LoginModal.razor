@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases.Specifics

@inject IAuthSignInUseCase UcSignIn
@inject IUserClientContext UserClientContext

<MudDialog @ref="_modalRef" Class="pa-2">
    <TitleContent>
        <MudText Typo="Typo.h3">
            Sign In
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Justify="Justify.Center">
            <MudTextField 
                T="string"
                @bind-Text="_email"
                Immediate
                Placeholder="Enter your email"
                Label="Email"
                Variant="Variant.Outlined"
            />
            
            <MudPasswordField 
                @bind-PasswordMode="_passwordMode"
                @bind-Value="_password"
                Immediate
                Placeholder="Enter your password"
                Label="Password"
                Variant="Variant.Outlined"
            />
            
            <MudTextField 
                T="string"
                @bind-Text="_password"
                Immediate
                Placeholder="Enter your password"
                Label="Password"
                InputType="InputType.Password"
                Variant="Variant.Outlined"
            />
            
            <MudButton 
                Variant="Variant.Outlined"
                Color="Color.Primary"
                Disabled="@(string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))"
                OnClick="@Login">
                Login
            </MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>