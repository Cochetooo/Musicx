@using Musicx.Application.Web.Interfaces.Models.Auth
@using Musicx.Application.Web.Interfaces.UseCases.Specifics

@inject IAuthSignInUseCase UcSignIn
@inject IUserClientContext UserClientContext

<MudDialog @ref="_modalRef" Class="pa-2">
    <TitleContent>
        <MudText Typo="Typo.h3">
            Sign In
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12">
                <MudTextField 
                    T="string"
                    @bind-Text="_email"
                    Immediate
                    Placeholder="Enter your email"
                    Label="Email"
                    Variant="Variant.Outlined"
                />
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField 
                    T="string"
                    @bind-Text="_password"
                    Immediate
                    Placeholder="Enter your password"
                    Label="Password"
                    InputType="InputType.Password"
                    Variant="Variant.Outlined"
                />
            </MudItem>
            
            <MudItem xs="12">
                <MudButton 
                    Variant="Variant.Filled"
                    Disabled="@(string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))"
                    OnClick="@Login">
                    Login
                </MudButton>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>