@using Musicx.Contracts.Enums
<div class="type-grid">
    @foreach (var type in Enum.GetValues<GenreType>())
    {
        <div class="my-2 type-card @(Node.Type == type ? "selected" : "")"
             @onclick="() => Select(type)">
            <MudText Typo="Typo.body1" Class="color-primary text-bold">@type.ToString().ToUpper()</MudText>
            <MudText Typo="Typo.body2" Class="color-secondary text-italic">@type.ToDescriptionString()</MudText>
        </div>
    }
</div>