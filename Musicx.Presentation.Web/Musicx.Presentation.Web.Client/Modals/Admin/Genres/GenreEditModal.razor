@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests.Genre
@* @using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.Genres

@inject ILoggerFactory LoggerProvider
@inject ISaveUseCase<InGenre> UcSave
@inject ISaveAllUseCase<InGenreRelation> UcSaveRelations
@inject IListUseCase<InGenre, OutGenre> UcList
@inject IFindInUseCase<InGenre, OutGenre> UcFindIn
@inject IGetUseCase<InGenre, OutGenre> UcGet
