@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.GenreTree

@inject ILoggerFactory LoggerProvider
@inject ISaveUseCase<InGenre> UcSave
@inject IListUseCase<OutGenre> UcList
@inject IFindInUseCase<OutGenre> UcFindIn

<MudDialog @ref="_modalRef">
    <TitleContent>
        Genre Editing
    </TitleContent>
    
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField 
                    T="string"
                    TextChanged="@NameTextChanged" 
                    Disabled="@(_genre.Id != 0)"
                    Immediate
                    @ref="_nameTextEdit" Label="Enter a genre..." 
                    HelperText="Name (*)" Variant="Variant.Text" />
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudSelect
                    @bind-Value="_genre.Type" T="GenreType"
                    Label="Type" Placeholder="Select a type"
                    AdornmentIcon="@Icons.Material.Filled.Label">
                    @foreach (var genreType in Enum.GetValues<GenreType>())
                    {
                        <MudSelectItem T="GenreType" Value="@genreType">@genreType</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudColorPicker
                    Label="Color"
                    @bind-Text="_genre.Color"
                    ImmediateText
                    Style="@($"color: {_genre.Color}")"
                    Elevation="4"
                    ShowAlpha="false"
                    Placeholder="Select a color"/>
            </MudItem>
            
            <MudItem xs="12">
                <MudTextField
                    T="string?"
                    Label="Description"
                    Placeholder="Enter a description..."
                    @bind-Text="_genre.Description"
                    Lines="6"
                />
            </MudItem>
            
            <MudItem>
                <MudText Typo="Typo.h6">Parent Genres</MudText>
                
                <GenreTree
                    RootGenres="@_genres"
                    TypeFilter="@_genre.Type"
                    Checkable
                    SelectedGenresChanged="@SelectedGenresChanged"
                    LoadChildrenAsync="@LoadChildrenAsync"
                    />
            </MudItem>
        </MudGrid>
    </DialogContent>
    
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@Save">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="@Hide">Close</MudButton>
    </DialogActions>
</MudDialog>