@using Musicx.Application.Shared.Interfaces.Common
@using Musicx.Application.Shared.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Responses.Genre

@inject ILoggerFactory LoggerFactory
@inject IApiClient Api
@inject ISnackbar Snackbar

<MudDialog @ref="_modalRef" ContentStyle="overflow-x: hidden;">
    <TitleContent>
        Genre Editing
    </TitleContent>
    
    <DialogContent>
        <div class="wizard-container step-@_state.Step">
            <div class="wizard-step">
                <GenreTypeSelector Node="@_state.Node" NodeChanged="@NextStep" />
            </div>
                
            <div class="wizard-step">
                <GenreNodeEditor Node="@_state.Node" @ref="_nodeEditor" />
            </div>
                
            <div class="wizard-step">
                <GenreRelationsEditor Relations="@_state.Relations"
                                      RootGenres="@_rootGenres"
                                      LoadChildrenAsync="@LoadChildrenAsync" />
            </div>
        </div>
    </DialogContent>
    
    <DialogActions>
        @if (_state.Step < 3)
        {
            <MudButton Color="Color.Default" OnClick="@NextStep">Next</MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" OnClick="@SaveAsync">Save</MudButton>
        }
        
        <MudButton Color="Color.Secondary" OnClick="@HideAsync">Close</MudButton>
        <MudButton Color="Color.Default" OnClick="@PreviousStep" Disabled="@(_state.Step <= 1)">Back</MudButton>
    </DialogActions>
</MudDialog>