@using Musicx.Presentation.Web.Client.Components.Genres

<MudTabs Rounded Class="pa-3">
    <MudTabPanel Text="Hierarchy (IsA)">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Select parent genres</MudText>
        <GenreTree RootGenres="RootGenres"
                   Addable
                   AllowedTypes="AllowedParentTypes"
                   SelectedGenresChanged="OnParentsChanged"
                   LoadChildrenAsync="LoadChildrenAsync" />

        <MudDivider Class="my-3" />
        <MudChipSet T="string">
            @foreach (var relation in ParentRelations)
            {
                var genre = FindGenre(relation.FromGenreId);
                if (genre is not null)
                {
                    <GenreBadge Genre="genre" Closable OnClose="@(() => RemoveRelation(relation))" />
                }
            }
        </MudChipSet>
    </MudTabPanel>

    <MudTabPanel Text="Influences">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Add inspiration genres</MudText>
        <GenreTree RootGenres="RootGenres"
                   Addable
                   SelectedGenresChanged="OnInfluencesChanged"
                   LoadChildrenAsync="LoadChildrenAsync" />
        <MudDivider Class="my-3" />
        <MudChipSet T="string">
            @foreach (var relation in InfluenceRelations)
            {
                var genre = FindGenre(relation.FromGenreId);
                if (genre is not null)
                {
                    <GenreBadge Genre="genre" Influence="true" Closable OnClose="@(() => RemoveRelation(relation))" />
                }
            }
        </MudChipSet>
    </MudTabPanel>

    <MudTabPanel Text="Fusion">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Add source genres for fusion</MudText>
        <GenreTree RootGenres="RootGenres"
                   Addable
                   AllowedTypes="AllowedFusionTypes"
                   SelectedGenresChanged="OnFusionChanged"
                   LoadChildrenAsync="LoadChildrenAsync" />
        
        <MudDivider Class="my-3" />
        <MudStack Spacing="1">
            @foreach (var relation in FusionRelations)
            {
                var genre = FindGenre(relation.FromGenreId);
                if (genre is null)
                {
                    continue;
                }
                
                <MudPaper Class="pa-2 d-flex align-center gap-2">
                    <GenreBadge Genre="genre" Closable OnClose="@(() => RemoveRelation(relation))" />
                    <MudSlider T="float" Min="0.1f" Max="1f" Step="0.05f" @bind-Value="relation.Weight" />
                    <MudText Typo="Typo.caption">@relation.Weight.ToString("0.00")</MudText>
                </MudPaper>
            }
        </MudStack>
    </MudTabPanel>
</MudTabs>