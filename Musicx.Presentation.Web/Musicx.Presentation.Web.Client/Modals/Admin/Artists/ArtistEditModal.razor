@using System.Text.Json
@using ISO3166
@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Enums
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Infrastructure.API.Persistence.Mappers
@inject ILoggerProvider LoggerProvider
@inject ISaveUseCase<InArtist> UcSave 
@inject HttpClient Http

<Modal @ref="_modalRef">
    <ModalContent Background="Background.Primary" Centered>
        <ModalHeader>
            <ModalTitle>Edit artist</ModalTitle>
            <CloseButton Clicked="Hide" />
        </ModalHeader>
        
        <ModalBody>
            <Fields>
                <!-- First Row -->
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Name (*)
                    </FieldLabel>
                    <FieldBody>
                        <Validation Validator="ValidateNonEmptyField">
                            <TextEdit 
                                Placeholder="ABBA..." TextChanged="NameTextChanged" 
                                Disabled="@(_artist.Id != 0)"
                                @ref="@_nameTextEdit">
                                <ValidationNone>⚠️ Please enter a name</ValidationNone>
                                <ValidationSuccess>✅ Valid name</ValidationSuccess>
                            </TextEdit>
                        </Validation>
                    </FieldBody>
                </Field>
                
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Country
                    </FieldLabel>
                    <FieldBody>
                        <Autocomplete 
                                      TItem="string"
                                      TValue="string" 
                                      Data="@_countries"
                                      Placeholder="Search country..."
                                      Filter="AutocompleteFilter.StartsWith"
                                      FreeTyping
                                      TextField="@((item) => item)"
                                      ValueField="@((item) => item)"
                                      @bind-SelectedValue="@_artist.Country">
                            <NotFoundContent>Sorry, @context was not found!</NotFoundContent>
                        </Autocomplete>
                    </FieldBody>
                </Field>
                
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Artwork
                    </FieldLabel>
                    <FieldBody>
                        @if (_isLoading)
                        {
                            <SpinKit Type="SpinKitType.Pulse" Color="gray" />
                        }
                        else
                        {
                            if (null != _artist.ArtworkUrl)
                            {
                                <Image Style="width: 96px; height: 96px" Source="@_artist.ArtworkUrl" />
                            }
                        }
                    </FieldBody>
                </Field>
                
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Type (*)
                    </FieldLabel>
                    <FieldBody>
                        <Select TValue="ArtistDiscriminator" @bind-SelectedValue="_artist.Discriminator">
                            <SelectItem Value="@(ArtistDiscriminator.Artist)">Generic</SelectItem>
                            <SelectItem Value="@(ArtistDiscriminator.Band)">Band</SelectItem>
                            <SelectItem Value="@(ArtistDiscriminator.Person)">Person</SelectItem>
                        </Select>
                    </FieldBody>
                </Field>
                
                @if (_artist.Discriminator == ArtistDiscriminator.Band)
                {
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            Formation Date
                        </FieldLabel>
                        <FieldBody>
                            <DatePicker TValue="DateTime?" @bind-Date="@_artist.FormationDate" />
                        </FieldBody>
                    </Field>
                    
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            Split Date
                        </FieldLabel>
                        <FieldBody>
                            <DatePicker TValue="DateTime?" @bind-Date="@_artist.SplitDate" />
                        </FieldBody>
                    </Field>
                } 
                else if (_artist.Discriminator == ArtistDiscriminator.Person)
                {
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            First Name
                        </FieldLabel>
                        <FieldBody>
                            <Validation Validator="ValidateNonEmptyField">
                                <TextEdit @bind-Text="@_artist.FirstName" Placeholder="James...">
                                    <ValidationNone>⚠️ Please enter a first name</ValidationNone>
                                    <ValidationSuccess>✅ Valid first name</ValidationSuccess>
                                </TextEdit>
                            </Validation>
                        </FieldBody>
                    </Field>
                    
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            Last Name
                        </FieldLabel>
                        <FieldBody>
                            <Validation Validator="ValidateNonEmptyField">
                                <TextEdit @bind-Text="@_artist.LastName" Placeholder="Hetfield...">
                                    <ValidationNone>⚠️ Please enter a name</ValidationNone>
                                    <ValidationSuccess>✅ Valid name</ValidationSuccess>
                                </TextEdit>
                            </Validation>
                        </FieldBody>
                    </Field>
                    
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            Birth Date
                        </FieldLabel>
                        <FieldBody>
                            <DatePicker TValue="DateTime?" @bind-Date="@_artist.BirthDate" />
                        </FieldBody>
                    </Field>
                    
                    <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                        <FieldLabel>
                            Death Date
                        </FieldLabel>
                        <FieldBody>
                            <DatePicker TValue="DateTime?" @bind-Date="@_artist.DeathDate" />
                        </FieldBody>
                    </Field>
                }
            </Fields>
        </ModalBody>
        
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="Save" Disabled="@_isConfirmable">Save</Button>
            <Button Color="Color.Secondary" Clicked="Hide">Close</Button>
        </ModalFooter>
    </ModalContent>
</Modal>