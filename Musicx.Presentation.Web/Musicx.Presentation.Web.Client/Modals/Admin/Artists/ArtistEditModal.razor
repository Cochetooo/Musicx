@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Requests.Artist
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums

@inject ILoggerFactory LoggerProvider
@inject ISaveService<InArtist> UcSave 
@inject IFindAllService<InArtist, OutArtist> UcListExistingArtists
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog @ref="_modalRef" Class="pa-2">
    <TitleContent>
        Artist Editing
    </TitleContent>
    <DialogContent>
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="6">
                <MudTextField 
                    T="string"
                    TextChanged="@NameTextChanged"
                    Disabled="@(_artist.Id != 0)"
                    Immediate
                    @ref="_nameTextEdit" Label="Enter an artist..."
                    HelperText="Name (*)"
                    Variant="Variant.Text" />
            </MudItem>
            
            <MudFlexBreak />
            
            <MudItem xs="12" md="6">
                <MudTextField 
                    T="string"
                    @bind-Text="_artist.Alias"
                    HelperText="Alias"
                    Label="Enter an alias for the artist..."
                    Placeholder="AKA..."
                    Variant="Variant.Text"/>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudAutocomplete T="string"
                                 Label="Current Country"
                                 Placeholder="Search country..."
                                 HelperText="Current country"
                                 SearchFunc="SearchCountry"
                                 @bind-Value="_artist.CurrentCountry"/>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField 
                    T="string"
                    @bind-Text="_artist.CurrentRegion"
                    HelperText="Current Region"
                    Label="Current Region"
                    Placeholder="Enter a current region..."
                    Variant="Variant.Text" />
                <!-- <MudAutocomplete T="string"
                                 Label="Region"
                                 Placeholder="Search region..."
                                 HelperText="Current region"
                                 SearchFunc="SearchRegion"
                                 @bind-Value="_artist.CurrentRegion"/> -->
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField 
                    T="string"
                    @bind-Text="_artist.CurrentTown"
                    HelperText="Current Town"
                    Label="Current Town"
                    Placeholder="Enter a current town..."
                    Variant="Variant.Text" />
                <!-- <MudAutocomplete T="string"
                                 Label="Town"
                                 Placeholder="Search town..."
                                 HelperText="Current town"
                                 SearchFunc="SearchTown"
                                 @bind-Value="_artist.CurrentTown"/> -->
            </MudItem>
            
            <!-- <MudItem xs="12" md="6">
                <MudAutocomplete
                    T="string"
                    Dense
                    Placeholder="Search country..."
                    Label="Choose a country..."
                    HelperText="Country"
                    SearchFunc="@SearchCountry"
                    @bind-Value="_artist.CurrentCountry"
                />
            </MudItem> -->
            
            <MudItem xs="12">
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => _showOrigin = !_showOrigin)">
                    Origin location (optional)
                </MudButton>
            </MudItem>

            <MudCollapse Expanded="_showOrigin">
                <MudPaper Class="pa-4 mt-2 origin-box">
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                        Only if different from current location
                    </MudText>

                    <MudGrid Class="mt-2">
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="string"
                                             Label="Origin Country"
                                             SearchFunc="SearchCountry"
                                             @bind-Value="_artist.OriginCountry"/>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField 
                                T="string"
                                @bind-Text="_artist.OriginRegion"
                                HelperText="Origin Region"
                                Label="Origin Region"
                                Placeholder="Enter a origin region..."
                                Variant="Variant.Text" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField 
                                T="string"
                                @bind-Text="_artist.OriginTown"
                                HelperText="Origin Town"
                                Label="Origin Town"
                                Placeholder="Enter a origin town..."
                                Variant="Variant.Text" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudCollapse>
            
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="Description"
                              Placeholder="Short biography / context..."
                              Lines="5"
                              MaxLength="2000"
                              @bind-Text="_artist.Description"
                              Variant="Variant.Text"/>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudField Label="Artwork" Variant="Variant.Text">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate />
                    }
                    else
                    {
                        @if (null != _artist.ArtworkUrl)
                        {
                            <MudImage Src="@_artist.ArtworkUrl" Alt="@_artist.Name" Class="rounded-lg" Elevation="25"
                                      @key="_artist.ArtworkUrl" Width="96" Height="96" />
                        }
                    }
                </MudField>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudSelect
                    @bind-Value="_artist.Discriminator" T="ArtistDiscriminator"
                    Label="Type (*)" Placeholder="Select a type"
                    AdornmentIcon="@Icons.Material.Filled.Label">
                    <MudSelectItem Value="@(ArtistDiscriminator.Artist)">Generic</MudSelectItem>
                    <MudSelectItem Value="@(ArtistDiscriminator.Band)">Band</MudSelectItem>
                    <MudSelectItem Value="@(ArtistDiscriminator.Person)">Person</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <!-- Band -->
            
            @if (_artist.Discriminator == ArtistDiscriminator.Band)
            {
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Formation Date" @bind-Date="@_artist.FormationDate" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Split Date" @bind-Date="@_artist.SplitDate" />
                </MudItem>
            } 
            else if (_artist.Discriminator == ArtistDiscriminator.Person)
            {
                <MudItem xs="12" md="6">
                    <MudTextField
                        T="string?"
                        @bind-Text="_artist.FirstName"
                        Label="First Name"
                        Placeholder="Enter a first name..."/>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField
                        T="string?"
                        @bind-Text="_artist.LastName"
                        Label="Last Name"
                        Placeholder="Enter a last name..."/>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Birth Date" @bind-Date="@_artist.BirthDate" />
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudDatePicker Label="Death Date" @bind-Date="@_artist.DeathDate" />
                </MudItem>
            }
            
            @if (_existingArtists.Count > 0)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        This name already exists for @_existingArtists.Count artists.<br/>
                        Please verify first that the artist you want to create does not already exist in our database<br/>
                        before submitting your request.<br/>
                        Not respecting this validation could cost you your privilege to create and edit artists.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@Save">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="@Hide">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .origin-box {
        background: rgba(255,255,255,0.04);
        border-left: 3px solid var(--mud-palette-secondary);
        opacity: 0.85;
    }
</style>