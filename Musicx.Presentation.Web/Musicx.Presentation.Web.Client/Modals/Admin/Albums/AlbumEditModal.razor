@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.Genres
@inject ILoggerFactory LoggerFactory
@inject IListUseCase<OutGenre> UcListGenres
@inject ISaveUseCase<InAlbum> UcSave
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog @ref="_modalRef" Class="pa-2">
    <TitleContent>
        Album Editing
    </TitleContent>
    <DialogContent>
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="7">
                <MudTextField
                    T="string"
                    TextChanged="@NameTextChanged"
                    Disabled="@(_album.Id != 0)"
                    Immediate
                    @ref="_nameTextEdit" Placeholder="Enter an album..."
                    ShrinkLabel="true"
                    Label="Name (*)" Variant="Variant.Text"/>
            </MudItem>
            
            <MudItem xs="12" md="2">
                <MudSelect
                    @bind-Value="_album.ReleaseType" T="ReleaseType?"
                    Label="Release Type" Placeholder="Select a type"
                    AdornmentIcon="@Icons.Material.Filled.Label">
                    @foreach (var releaseType in Enum.GetValues<ReleaseType>().OrderBy(a => a.ToString()))
                    {
                        <MudSelectItem T="ReleaseType?" Value="@releaseType">@releaseType.ToDescriptionString()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            
            <MudFlexBreak />
            
            <MudItem xs="12" md="3">
                <MudStack Spacing="2">
                    <MudTextField
                        T="string?"
                        Immediate
                        @bind-Text="_album.ArtistAlias"
                        ShrinkLabel="true"
                        HelperText="In case artist used another name during that album"
                        HelperTextOnFocus="true"
                        Label="Artist Alias" Variant="Variant.Text"/>

                    <MudTextField
                        T="string?"
                        Immediate
                        @bind-Text="_album.EnglishName"
                        ShrinkLabel="true"
                        HelperText="In case album name is not using latin alphabet"
                        HelperTextOnFocus="true"
                        Label="English Name" Variant="Variant.Text"/>

                    <MudSwitch @bind-Value="_album.IsFarRight" Label="National Socialist Content" Color="Color.Primary"/>

                    <MudSwitch @bind-Value="_album.IsExplicitContent" Label="NSFW Content" Color="Color.Primary"/>
                </MudStack>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudStack Spacing="2">
                    <MudDatePicker
                        @bind-Date="@_album.OriginalReleaseDate"
                        Placeholder="Choose a date..."
                        Label="Release Date"
                        AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                        Color="Color.Primary"
                        AnchorOrigin="Origin.BottomCenter"
                        TransformOrigin="Origin.TopCenter"
                        Editable
                        Clearable/>

                    <MudDateRangePicker
                        @bind-DateRange="_recordingDates"
                        Placeholder="Choose dates..."
                        Label="Recording Dates"
                        PickerVariant="PickerVariant.Inline"/>
                </MudStack>
            </MudItem>
            
            <MudItem xs="12" md="3">
                <MudField Label="Artwork" Variant="Variant.Text">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Default" Indeterminate/>
                    }
                    else
                    {
                        @if (_album is { ArtworkUrl: not null })
                        {
                            <MudImage Src="@_album.ArtworkUrl" Alt="@_album.Name" Class="rounded-lg" Elevation="25"
                                      Style="width: 192px; aspect-ratio: 1 / 1;"/>
                        }
                    }
                </MudField>
            </MudItem>

            <MudFlexBreak/>

            <MudDivider Class="my-5"/>

            <MudItem xs="12" md="6">
                <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Row>
                    <MudAutocomplete
                        T="OutGenre?"
                        Dense
                        MaxItems="20"
                        Placeholder="Search a genre..."
                        HelperText="Primary Genres"
                        @bind-Text="_selectedPrimaryText"
                        @bind-Value="_selectedPrimaryGenre"
                        ToStringFunc="@(e => e?.CanonicalName ?? "")"
                        SearchFunc="SearchGenre"/>

                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Disabled="@(_selectedPrimaryGenre is null)"
                                   OnClick="@AddPrimaryGenre"/>
                </MudStack>

                @foreach (var genre in _primaryGenres)
                {
                    <GenreBadge Genre="@genre" Closable OnClose="@(() => OnDeletePrimaryGenre(genre))"/>
                }
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Row>
                    <MudAutocomplete
                        T="OutGenre?"
                        Dense
                        MaxItems="20"
                        Placeholder="Search a genre..."
                        HelperText="Influence Genres"
                        @bind-Text="_selectedInfluenceText"
                        @bind-Value="_selectedInfluenceGenre"
                        ToStringFunc="@(e => e?.CanonicalName ?? "")"
                        SearchFunc="SearchGenre"/>

                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Disabled="@(_selectedInfluenceGenre is null)"
                                   OnClick="@AddInfluenceGenre"/>
                </MudStack>

                @foreach (var genre in _influenceGenres)
                {
                    <GenreBadge Genre="@genre" Closable OnClose="@(() => OnDeleteInfluenceGenre(genre))"/>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@Save">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="@Hide">Close</MudButton>
    </DialogActions>
</MudDialog>