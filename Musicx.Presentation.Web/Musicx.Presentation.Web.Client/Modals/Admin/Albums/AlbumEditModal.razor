@using System.Text.Json
@using Musicx.Application.Shared.Utilities
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Domain.Enums
@using Musicx.Infrastructure.API.Persistence.Mappers
@using Musicx.Presentation.Web.Client.Components
@inject ILoggerProvider LoggerProvider
@inject IListUseCase<OutGenre> UcListGenres
@inject ISaveUseCase<InAlbum> UcSave
@inject HttpClient Http

<Modal @ref="_modalRef">
    <ModalContent Size="ModalSize.Large" Centered>
        <ModalHeader>
            <ModalTitle>Album Editing</ModalTitle>
            <CloseButton Clicked="Hide" />
        </ModalHeader>
        
        <ModalBody>
            <Fields>
                <Field ColumnSize="ColumnSize.Is4.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Artist (*)
                    </FieldLabel>
                    <FieldBody>
                        @if (_artist != null)
                        {
                            <TextEdit Disabled @bind-Text="_artist.Name"/>
                        }
                    </FieldBody>
                </Field>
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Name (*)
                    </FieldLabel>
                    <FieldBody>
                        <Validation Validator="ValidateNonEmptyField">
                            <TextEdit
                                Placeholder="Here Comes the Sun..." TextChanged="NameTextChanged"
                                @ref="_nameTextEdit">
                                <ValidationNone>⚠️ Please enter a name</ValidationNone>
                                <ValidationSuccess>✅ Valid name</ValidationSuccess>
                            </TextEdit>
                        </Validation>
                    </FieldBody>
                </Field>
                
                <Field ColumnSize="ColumnSize.Is2.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Artwork
                    </FieldLabel>
                    <FieldBody>
                        @if (_isLoading)
                        {
                            <SpinKit Type="SpinKitType.Pulse" Color="gray" />
                        }
                        else
                        {
                            if (_album is { ArtworkUrl: not null })
                            {
                                <Image Style="width: 96px; height: 96px" Source="@_album.ArtworkUrl" />
                            }
                        }
                    </FieldBody>
                </Field>
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Release Type
                    </FieldLabel>
                    <FieldBody>
                        <Select TValue="ReleaseType?"
                                @bind-SelectedValue="_album.ReleaseType">
                            <SelectItem>-</SelectItem>
                            @foreach (var releaseType in Enum.GetValues<ReleaseType>())
                            {
                                <SelectItem Value="@releaseType">@releaseType.ToString()</SelectItem>
                            }
                        </Select>
                    </FieldBody>
                </Field>
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Release Date
                    </FieldLabel>
                    <FieldBody>
                        <DatePicker TValue="DateTime?" @bind-Date="@_album.OriginalReleaseDate" />
                    </FieldBody>
                </Field>
                
                <Divider />
                
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Primary Genres
                    </FieldLabel>
                    <FieldBody>
                        <Div Flex="Flex.JustifyContent.Between" Margin="Margin.Is2.FromBottom">
                            <Autocomplete TItem="OutGenre"
                                          TValue="OutGenre"
                                          Data="@_availableGenres"
                                          TextField="@(( item ) => item.Name)"
                                          ValueField="@((item) => item)"
                                          @bind-SelectedText="@_selectedPrimaryText"
                                          @bind-SelectedValue="@_selectedPrimaryGenre"
                                          Placeholder="Search a genre..."
                                          Filter="AutocompleteFilter.StartsWith">
                                <NotFoundContent>Sorry... @context was not found !</NotFoundContent>
                            </Autocomplete>
                            
                            <Button Clicked="AddPrimaryGenre" Disabled="@(_selectedPrimaryGenre is null)">
                                <Icon Name="IconName.Add" />
                            </Button>
                        </Div>
                        
                        <ListGroup>
                            @foreach (var genre in _primaryGenres)
                            {
                                <ListGroupItem Flex="Flex.JustifyContent.Between">
                                    <GenreBadge Genre="@genre" />
                                    <Button Outline Clicked="@(() => OnDeletePrimaryGenre(genre))">
                                        <Icon Name="IconName.Times" />
                                    </Button>
                                </ListGroupItem>
                            }
                        </ListGroup>
                    </FieldBody>
                </Field>
                
                <Field ColumnSize="ColumnSize.Is6.OnDesktop.Is12.OnMobile">
                    <FieldLabel>
                        Influence Genres
                    </FieldLabel>
                    <FieldBody>
                        <Div Flex="Flex.JustifyContent.Between" Margin="Margin.Is2.FromBottom">
                            <Autocomplete TItem="OutGenre"
                                          TValue="OutGenre"
                                          Data="@_availableGenres"
                                          TextField="@(( item ) => item.Name)"
                                          ValueField="@((item) => item)"
                                          @bind-SelectedText="@_selectedInfluenceText"
                                          @bind-SelectedValue="@_selectedInfluenceGenre"
                                          Placeholder="Search a genre..."
                                          Filter="AutocompleteFilter.StartsWith">
                                <NotFoundContent>Sorry... @context was not found !</NotFoundContent>
                            </Autocomplete>
                            
                            <Button Clicked="AddInfluenceGenre" Disabled="@(_selectedInfluenceGenre is null)">
                                <Icon Name="IconName.Add" />
                            </Button>
                        </Div>
                        
                        <ListGroup>
                            @foreach (var genre in _influenceGenres)
                            {
                                <ListGroupItem Flex="Flex.JustifyContent.Between">
                                    <GenreBadge Genre="@genre" />
                                    <Button Outline Clicked="@(() => OnDeleteInfluenceGenre(genre))">
                                        <Icon Name="IconName.Times" />
                                    </Button>
                                </ListGroupItem>
                            }
                        </ListGroup>
                    </FieldBody>
                </Field>
                
                <Divider />
                
                <Field ColumnSize="ColumnSize.Is12">
                    <FieldLabel>
                        National Socialist Content
                    </FieldLabel>
                    <FieldBody>
                        <Check TValue="bool" @bind-Checked="@_album.IsFarRight" />
                    </FieldBody>
                </Field>
            </Fields>
        </ModalBody>
        
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="Save" Disabled="@_isConfirmable">Save</Button>
            <Button Color="Color.Secondary" Clicked="Hide">Close</Button>
        </ModalFooter>
    </ModalContent>
</Modal>