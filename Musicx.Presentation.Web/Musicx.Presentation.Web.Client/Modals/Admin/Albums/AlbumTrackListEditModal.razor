@using CsvHelper.TypeConversion
@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Enums
@using Musicx.Presentation.Web.Client.Components.Fields
@using Musicx.Presentation.Web.Client.Helpers
@using SQLitePCL

@inject ILoggerFactory LoggerProvider
@inject ISaveAllUseCase<InSong> UcSaveAll

<MudDialog @ref="_modalRef">
    <TitleContent>
        Track List Editing
    </TitleContent>
    
    <DialogContent>
        <MudDataGrid T="InSong"
                     Class="my-3"
                     ReadOnly="@false"
                     Items="@_songs"
                     Dense
                     Bordered
                     EditMode="DataGridEditMode.Cell"
                     EditTrigger="DataGridEditTrigger.OnRowClick">
            <Columns>
                <TemplateColumn CellStyle="width: 40px;">
                    <EditTemplate>
                        <MudIconButton 
                            Color="Color.Error"
                            Disabled="@(_songs.Count < 2)"
                            Icon="@Icons.Material.Filled.Remove"
                            OnClick="@(() => DeleteRow(context.Item))"
                            Size="Size.Small"
                        />
                    </EditTemplate>
                </TemplateColumn>
                
                <PropertyColumn Property="x => x.DiscNumber" CellStyle="width: 60px;" Title="Disc #"/>
                
                <PropertyColumn Property="x => x.TrackNumber" CellStyle="width: 60px;" Title="Track #"/>
                
                <PropertyColumn Property="x => x.Title" Title="Name"/>
                
                <PropertyColumn Property="x => x.Type" CellStyle="width: 100px;">
                    <EditTemplate>
                        <MudSelect T="SongType" @bind-Value="context.Item.Type"
                                   Placeholder="Select a type" 
                                   AdornmentIcon="@Icons.Material.Filled.Label">
                            @foreach (var type in Enum.GetValues<SongType>())
                            {
                                <MudSelectItem T="SongType" Value="@type">@type</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                
                <PropertyColumn Property="x => x.Duration" Title="Duration"
                                CellStyle="width: 80px">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Duration"
                                      T="long?"
                                      Placeholder="mm:ss"
                                      Converter="@(new DurationConverter())" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
            
            <ToolBarContent>
                <MudIconButton Color="Color.Primary" 
                               Icon="@Icons.Material.Filled.Add"
                               OnClick="@AddRow" />
            </ToolBarContent>
        </MudDataGrid>
    </DialogContent>
    
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@Save">Save</MudButton>
        <MudButton Color="Color.Secondary" OnClick="@Hide">Close</MudButton>
    </DialogActions>
</MudDialog>