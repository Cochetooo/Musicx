@using System.Configuration
@using System.Net.Mime
@using Microsoft.EntityFrameworkCore.Diagnostics
@using Musicx.Application.Shared.Utilities
@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Responses
@using Musicx.Contracts.Enums
@using Musicx.Infrastructure.API.Persistence.Mappers
@using SQLitePCL
@using Musicx.Presentation.Web.Client.Components.Fields

@inject ILoggerFactory LoggerProvider

<MudDialog @ref="_modalRef">
    <TitleContent>
        Track List Editing
    </TitleContent>
    
    <DialogContent>
        <MudDataGrid T="InSong"
                     Items="@_songs"
                     Dense
                     Hover
                     Elevation="8"
                     EditMode="DataGridEditMode.Cell">
            <Columns>
                <TemplateColumn>
                    <CellTemplate>
                        <MudIconButton 
                            Color="Color.Error"
                            Icon="@Icons.Material.Filled.Remove"
                            OnClick="@(() => DeleteRow(context.Item))"
                            />
                    </CellTemplate>
                </TemplateColumn>
                
                <PropertyColumn Property="x => x.TrackNumber" Title="#"/>
                <PropertyColumn Property="x => x.Title" Title="Name"/>
                <PropertyColumn Property="x => x.PrimaryGenreIds" Title="Genres">
                    <EditTemplate>

                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.InfluenceGenreIds" Title="Influences">
                    <EditTemplate>

                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Type">
                    <EditTemplate>
                        <MudSelect T="SongType?" @bind-Value="context.Item.Type">
                            @foreach (var type in Enum.GetValues<SongType>())
                            {
                                <MudSelectItem Value="@type">@type.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.Duration" Title="Duration">
                    <EditTemplate>
                        <CstDurationField @bind-Value="_timeSpanDuration"/>
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
            
            <ToolBarContent>
                <MudIconButton Color="Color.Primary" 
                               Icon="@Icons.Material.Filled.Add"
                               OnClick="@AddRow" />
            </ToolBarContent>
        </MudDataGrid>
    </DialogContent>
</MudDialog>

