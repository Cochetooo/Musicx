@using Musicx.Contracts.Dto.Requests
@using Musicx.Contracts.Dto.Requests.Song
<MudDialog @ref="_modalRef" Class="pa-2">
    <TitleContent>
        Track List Genres Editing
    </TitleContent>
    
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">Track List</MudText>
                    <MudListExtended T="InSong" @bind-SelectedValue="_selectedSong" Gutters Padding>
                        @foreach (var song in _albumSongs)
                        {
                            <MudListItemExtended T="InSong" Text="@(song.TrackNumber + ". " + song.Title)" Value="@song" />
                        }
                    </MudListExtended>
                </MudPaper>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
                    <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">Genres associated</MudText>
                    
                </MudPaper>
            </MudItem>
        </MudGrid>
        
        <MudPaper Class="mt-4 pa-3 bg-surface animate-hover-up">
            <MudText Typo="Typo.h6" Class="montserrat text-extra-bold text-color-primary">Available Genres</MudText>
                
        </MudPaper>
    </DialogContent>
</MudDialog>