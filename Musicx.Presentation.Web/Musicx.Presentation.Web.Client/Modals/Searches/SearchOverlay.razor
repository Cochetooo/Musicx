@using Musicx.Application.Web.Interfaces.UseCases
@using Musicx.Contracts.Dto.Requests.Album
@using Musicx.Contracts.Dto.Requests.Artist
@using Musicx.Contracts.Dto.Requests.Genre
@using Musicx.Contracts.Dto.Requests.Song
@using Musicx.Contracts.Dto.Requests.User
@using Musicx.Contracts.Dto.Responses
@inject IJSRuntime JS
@inject IFindAllService<InArtist, OutArtist> UcListArtists
@inject IFindAllService<InAlbum, OutAlbum> UcListAlbums
@inject IFindAllService<InGenre, OutGenre> UcListGenres
@inject IFindAllService<InUser, OutUser> UcListUsers
@inject IFindAllService<InSong, OutSong> UcListSongs
@inject NavigationManager Navigation

<HeadContent>
    <link rel="stylesheet" href="Css/Features/Search/search-overlay.css" />
</HeadContent>

<div class="f-search-overlay" @onclick="OnBackdropClick" style="display:@(IsOpen ? "block" : "none")">
    <div class="f-overlay-backdrop" @onclick="OnBackdropClick"></div>
    
    <div class="f-overlay-wrapper" @ref="_wrapperRef" role="dialog" aria-modal="true">
        <MudPaper Class="f-search-modal glass-paper animate-fade-in" Elevation="8" @onclick:stopPropagation>
            <div class="f-search-input-row">
                <MudTextField @ref="_mudInput"
                              @bind-Value="_value"
                              Immediate
                              Placeholder="Search anything..."
                              OnKeyDown="@OnKeyDownHandler"
                              Variant="Variant.Filled"
                              Class="f-search-input-mud"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"/>
                
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default"
                               OnClick="@Close" Class="f-search-close-btn"/>
            </div>
            
            <div class="f-search-body">
                <div class="f-search-results-column">
                    @if (_isLoading)
                    {
                        <div class="f-search-loading">
                            <span class="f-search-loader"></span> 
                            <span class="loading-text">Loading...</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_value))
                    {
                        <div class="results-groups">
                            @foreach (var group in _searchResults)
                            {
                                <div class="f-search-result-group">
                                    <div class="f-search-group-header">
                                        <MudText Typo="Typo.subtitle2" Class="group-title">
                                            @group.Key (@group.Value.Count)
                                        </MudText>
                                    </div>
                                    <MudList T="RenderFragment" Dense>
                                        @foreach (var item in group.Value)
                                        {
                                            <MudListItem Class="f-search-result-item animate-fade-in" OnClick="@(() => OnResultClick(item))">
                                                <MudStack Row Spacing="2">
                                                    @if (item.Image is not null)
                                                    {
                                                        <MudImage Src="@item.Image"
                                                                  @key="item.Image"
                                                                  Width="48"
                                                                  Height="48"
                                                                  Class="rounded-lg"
                                                                  Elevation="2"/>
                                                    }

                                                    <div>
                                                        <MudText Typo="Typo.body1">
                                                            @item.Icon @item.Title
                                                        </MudText>
                                                        <MudText Typo="Typo.body2" Class="color-secondary">
                                                            @item.Subtitle
                                                        </MudText>
                                                    </div>
                                                </MudStack>
                                                
                                            </MudListItem>
                                        }
                                    </MudList>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="search-hint">Type something to display results...</div>
                    }
                </div>
                
                <div class="f-search-filters-column">
                    <MudPaper Elevation="0" Class="filters-panel glass-paper">
                        <MudText Typo="Typo.h6">Filters</MudText>
                        
                        <div class="filter-row">
                            <MudSelect T="string" @bind-Value="_sortBy" Dense>
                                <MudSelectItem Value="@("relevance")">Relevance</MudSelectItem>
                                <MudSelectItem Value="@("popularity")">Popularity</MudSelectItem>
                                <MudSelectItem Value="@("recent")">Most Recent</MudSelectItem>
                            </MudSelect>
                        </div>
                        <div class="filter-row">
                            <MudCheckBox T="bool" @bind-Value="_groupResults" Label="Group by category" />
                        </div>
                        <div class="filter-row">
                            <MudCheckBox T="bool" @bind-Value="_exactSearch" Label="Exact search" />
                        </div>
                        <div class="filter-row">
                            <MudSlider Min="1" Max="50" @bind-Value="_maxResults" Step="1" />
                            <div>@_maxResults</div>
                        </div>
                        <div class="actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" OnClick="@ApplyFilters" />
                        </div>
                    </MudPaper>
                </div>
            </div>
        </MudPaper>
    </div>
</div>