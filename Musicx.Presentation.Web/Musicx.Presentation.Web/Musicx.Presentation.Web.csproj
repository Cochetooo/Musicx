<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
        <ProjectReference Include="..\..\Musicx.Contracts\Musicx.Contracts.csproj" />
        <ProjectReference Include="..\..\Musicx.Infrastructure\Musicx.Infrastructure.csproj" />
        <ProjectReference Include="..\Musicx.Presentation.Web.Client\Musicx.Presentation.Web.Client.csproj"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.3"/>
    </ItemGroup>

    <ItemGroup>
      <None Include="log4net.config">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\css\material-plugins.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material-plugins.css.map" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material-plugins.min.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material-plugins.min.css.map" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material.css.map" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material.min.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\material.min.css.map" />
    </ItemGroup>

</Project>
