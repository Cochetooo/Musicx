<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Musicx.Presentation.Desktop.Views.Body.SidebarRightView">
    
    <Grid Width="300" MinWidth="150" MaxWidth="500" IsVisible="False">
        <DockPanel>
            <!-- Selector -->
            <ComboBox x:Name="SidebarRightSelector" Margin="0 0 0 10">
                <ComboBoxItem Content="Queue"/>
                <ComboBoxItem Content="Friend Activity"/>
                <ComboBoxItem Content="Edit Mode"/>
            </ComboBox>

            <!-- Content -->
            <ContentControl x:Name="SidebarRightContent"/>
        </DockPanel>
    </Grid>
    
</UserControl>
