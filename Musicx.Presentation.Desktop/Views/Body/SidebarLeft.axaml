<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Musicx.Presentation.Desktop.Views.Body.SidebarLeft">

    <DockPanel>
        <!-- Selector -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Playlists" Classes="Header" />
            
            <ComboBox Grid.Column="1" x:Name="SidebarSelector" Margin="0 0 0 10" BorderThickness="0" Background="Transparent">
                <ComboBoxItem Content="Playlists"/>
                <ComboBoxItem Content="My Artists"/>
                <ComboBoxItem Content="My Genres"/>
            </ComboBox>
        </Grid>

        <!-- Content -->
        <ContentControl x:Name="SidebarContent"/>
    </DockPanel>
    
</UserControl>
