<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musicx.Presentation.Desktop.ViewModels.Pages"
             xmlns:album="using:Musicx.Presentation.Desktop.Views.Pages.Albums"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.AlbumPageView"
             x:DataType="vm:AlbumPageViewModel">
    <Border Classes="PanelCard" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" Classes="Heading" Margin="0,0,8,0"/>
                <TextBox Width="240" Text="{Binding Filter}" Watermark="{Binding SearchLabel}"/>
                <NumericUpDown Width="110" Minimum="0" Value="{Binding SelectedId}"/>
                <Button Content="{Binding FindLabel}" Command="{Binding FindCommand}"/>
                <Button Content="{Binding FindByIdLabel}" Command="{Binding FindByIdCommand}"/>
                <Button Content="{Binding FindInLabel}" Command="{Binding FindInCommand}"/>
            </StackPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="AlbumTimelineView">
                    <album:AlbumTimelineView Albums="{Binding Albums}"/>
                </TabItem>
                <TabItem Header="AlbumGridView">
                    <album:AlbumGridView Albums="{Binding Albums}"/>
                </TabItem>
                <TabItem Header="AlbumListView">
                    <album:AlbumListView Albums="{Binding Albums}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>