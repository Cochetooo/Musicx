<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musicx.Presentation.Desktop.ViewModels.Pages"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.BottomAudioPlayerView"
             x:DataType="vm:BottomAudioPlayerViewModel">
    <Border Classes="PanelCard" Padding="10">
        <Grid ColumnDefinitions="2*,Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding NowPlaying}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding Back30Label}" Command="{Binding Back30Command}"/>
            <Button Grid.Column="2" Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}"/>
            <Button Grid.Column="3" Content="{Binding Forward30Label}" Command="{Binding Forward30Command}"/>
            <Button Grid.Column="4" Content="{Binding EqualizerLabel}" Command="{Binding ToggleEqualizerCommand}"/>
        </Grid>
    </Border>
</UserControl>