<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.Albums.AlbumTimelineView"
             x:CompileBindings="False">
    <ItemsControl ItemsSource="{Binding Albums, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Classes="PanelCard" Margin="0,0,0,6" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding OriginalReleaseDate, StringFormat='{}{0:yyyy}'}" Width="60"/>
                        <TextBlock Text="{Binding Name}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
