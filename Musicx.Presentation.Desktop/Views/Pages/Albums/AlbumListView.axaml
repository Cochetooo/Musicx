<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.Albums.AlbumListView"
             x:CompileBindings="False">
    <DataGrid ItemsSource="{Binding Albums, RelativeSource={RelativeSource AncestorType=UserControl}}" AutoGenerateColumns="False">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Album" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Artist" Binding="{Binding Artist.Name}" Width="*"/>
            <DataGridTextColumn Header="Release" Binding="{Binding OriginalReleaseDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
