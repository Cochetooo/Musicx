<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musicx.Presentation.Desktop.ViewModels.Pages"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.UserPageView"
             x:DataType="vm:UserPageViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Grid.Row="0" Classes="PanelCard" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Title}" Classes="Heading" Margin="0,0,8,0"/>
                <TextBox Width="220" Text="{Binding Email}" Watermark="Email"/>
                <TextBox Width="220" Text="{Binding Password}"/>
                <Button Content="{Binding LoginLabel}" Command="{Binding LoginCommand}"/>
                <TextBlock Text="{Binding Status}" Classes="Muted" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="PanelCard" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="240" Text="{Binding Filter}" Watermark="{Binding SearchLabel}"/>
                <NumericUpDown Width="110" Minimum="0" Value="{Binding SelectedId}"/>
                <Button Content="{Binding FindLabel}" Command="{Binding FindCommand}"/>
                <Button Content="{Binding FindByIdLabel}" Command="{Binding FindByIdCommand}"/>
                <Button Content="{Binding FindInLabel}" Command="{Binding FindInCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="PanelCard" Padding="12">
            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>