<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Musicx.Presentation.Desktop.ViewModels.Pages"
             x:Class="Musicx.Presentation.Desktop.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsPageViewModel">
    <Border Classes="PanelCard" Padding="16">
        <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
            <ListBox ItemsSource="{Binding Tabs}" />
            <Border Grid.Column="1" Background="#101722" CornerRadius="8" Padding="16"/>
        </Grid>
    </Border>
</UserControl>
