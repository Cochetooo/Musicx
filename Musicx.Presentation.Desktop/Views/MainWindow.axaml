<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Musicx.Presentation.Desktop.ViewModels"
        x:Class="Musicx.Presentation.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="False"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        Title="{Binding AppTitle}"
        Background="#070B14"
        Icon="/Assets/Images/Logo/Logo500.png">

        <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="10">
                <Border Grid.Row="0" Classes="PanelCard" Padding="14">
                        <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding AppTitle}" Classes="DisplayTitle" Margin="0,0,16,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding ArtistNavLabel}" Command="{Binding NavigateArtistCommand}" />
                                        <Button Content="{Binding AlbumNavLabel}" Command="{Binding NavigateAlbumCommand}" />
                                        <Button Content="{Binding GenreNavLabel}" Command="{Binding NavigateGenreCommand}" />
                                        <Button Content="{Binding UserNavLabel}" Command="{Binding NavigateUserCommand}" />
                                        <Button Content="{Binding LibraryNavLabel}" Command="{Binding NavigateLibraryCommand}" />
                                        <Button Content="{Binding SettingsNavLabel}" Command="{Binding NavigateSettingsCommand}" />
                                </StackPanel>
                        </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

                <ContentControl Grid.Row="2" Content="{Binding Player}" />
        </Grid>
</Window>
