<UserControl x:Class="Musicx.Views.Content.ModuleSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid Background="Transparent">
            <Border Background="#2a2f2f" CornerRadius="15" Opacity="0.8">
                <Border.Effect>
                    <BlurEffect Radius="10" />
                </Border.Effect>
            </Border>
        </Grid>
        
        <!-- 3D Container -->
        <Viewport3D HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera" Position="0,0,100" LookDirection="0,0,-100" UpDirection="0,1,0" FieldOfView="45"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="White" Direction="-1,-1,-3"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- 3x3 Grid for Images -->
            <ModelVisual3D>
                <ModelVisual3D.Transform>
                    <Transform3DGroup>
                        <RotateTransform3D x:Name="RotateTransform">
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="AxisAngleRotation" Axis="0,1,0" Angle="0"/>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                    </Transform3DGroup>
                </ModelVisual3D.Transform>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="White"/>
                        <GeometryModel3D>
                            <GeometryModel3D.Geometry>
                                <MeshGeometry3D Positions="-1,-1,0  1,-1,0  1,1,0  -1,1,0" TextureCoordinates="0,1 1,1 1,0 0,0" TriangleIndices="0 1 2 0 2 3"/>
                            </GeometryModel3D.Geometry>
                            <GeometryModel3D.Material>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <VisualBrush Visual="{Binding ElementName=ModuleSelectionGrid}"/>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="ModuleSelectionGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <ui:Button Grid.Row="0" Grid.Column="0">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="Library24" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="LOCAL LIBRARY" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="0" Grid.Column="1">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="Stream24" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="STREAMING" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="0" Grid.Column="2">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="BookLetter24" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="MUSICOPEDIA" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="1" Grid.Column="0">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="PlayMultiple16" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="LISTEN TOGETHER" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="1" Grid.Column="1" IsEnabled="False">
                <Grid Width="300" Height="200">
                    <ui:Image Stretch="UniformToFill" />
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="Hub" VerticalAlignment="Bottom"  Foreground="DarkGray" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="1" Grid.Column="2">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="DataBarVertical32" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="STATISTICS" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="2" Grid.Column="0">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="People48" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="FRIENDS" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="2" Grid.Column="1">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="Person48" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="PROFILE" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
            
            <ui:Button Grid.Row="2" Grid.Column="2">
                <Grid Width="300" Height="200">
                    <Viewbox>
                        <ui:SymbolIcon Symbol="Settings48" Foreground="LightGray" />
                    </Viewbox>
                    <ui:TextBlock Style="{StaticResource HubTextBlock}" Text="SETTINGS" VerticalAlignment="Bottom" />
                </Grid>
            </ui:Button>
        </Grid>
    </Grid>
</UserControl>
