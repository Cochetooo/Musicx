<ui:FluentWindow x:Class="Musicx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Musicx"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:menu="clr-namespace:Musicx.Views.Menu"
        xmlns:bottom="clr-namespace:Musicx.Views.Bottom"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1440"
        Icon="pack://application:,,,/Assets/Images/Logo/Logo500.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Top Bar -->
        <StackPanel Grid.Row="0">
            <ui:TitleBar 
                Title="Musicx - Development Version 0.6.0" 
                Icon="{ui:ImageIcon 'pack://application:,,,/Assets/Images/Logo/Logo500.png'}" />
        
            <menu:TopBarMenu />
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            
        </Grid>
        
        <!-- Bottom Bar -->
        <StackPanel Grid.Row="2">
            <bottom:AudioPlayer />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
